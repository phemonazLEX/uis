				object.Open = false

				local popup = Instance.new("Frame")
				popup.Name = "ColorPickerPopup"
				popup.Size = UDim2.fromOffset(230, 0)
				popup.BackgroundColor3 = theme.Surface
				popup.BorderSizePixel = 0
				popup.Visible = false
				popup.ClipsDescendants = true
				popup.ZIndex = 110
				popup.Parent = window

				corner(popup, 9)
				stroke(popup, theme.Border, 1)

				local popupContent = Instance.new("Frame")
				popupContent.Position = UDim2.fromOffset(10, 10)
				popupContent.Size = UDim2.new(1, -20, 1, -20)
				popupContent.BackgroundTransparency = 1
				popupContent.ZIndex = 111
				popupContent.Parent = popup

				local palette = Instance.new("Frame")
				palette.Size = UDim2.new(1, 0, 0, 150)
				palette.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
				palette.BorderSizePixel = 0
				palette.ZIndex = 112
				palette.Parent = popupContent
				corner(palette, 7)

				local whiteGradient = Instance.new("UIGradient")
				whiteGradient.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
					ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1))
				})
				whiteGradient.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(1, 1)
				})
				whiteGradient.Parent = palette

				local blackGradient = Instance.new("UIGradient")
				blackGradient.Rotation = 90
				blackGradient.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.new(0, 0, 0)),
					ColorSequenceKeypoint.new(1, Color3.new(0, 0, 0))
				})
				blackGradient.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(1, 0)
				})
				blackGradient.Parent = palette

				local paletteButton = createButton(palette)
				paletteButton.Size = UDim2.fromScale(1, 1)
				paletteButton.ZIndex = 115

				local paletteCursor = Instance.new("Frame")
				paletteCursor.AnchorPoint = Vector2.new(0.5, 0.5)
				paletteCursor.Size = UDim2.fromOffset(10, 10)
				paletteCursor.BackgroundTransparency = 1
				paletteCursor.ZIndex = 116
				paletteCursor.Parent = palette

				local cursorStroke = Instance.new("UIStroke")
				cursorStroke.Color = Color3.new(1, 1, 1)
				cursorStroke.Thickness = 2
				cursorStroke.Parent = paletteCursor
				corner(paletteCursor, 5)

				local hueBar = Instance.new("Frame")
				hueBar.Position = UDim2.fromOffset(0, 158)
				hueBar.Size = UDim2.new(1, 0, 0, 14)
				hueBar.BorderSizePixel = 0
				hueBar.ZIndex = 112
				hueBar.Parent = popupContent
				corner(hueBar, 7)

				local hueGradient = Instance.new("UIGradient")
				hueGradient.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
					ColorSequenceKeypoint.new(0.166, Color3.fromHSV(1 / 6, 1, 1)),
					ColorSequenceKeypoint.new(0.333, Color3.fromHSV(2 / 6, 1, 1)),
					ColorSequenceKeypoint.new(0.5, Color3.fromHSV(3 / 6, 1, 1)),
					ColorSequenceKeypoint.new(0.666, Color3.fromHSV(4 / 6, 1, 1)),
					ColorSequenceKeypoint.new(0.833, Color3.fromHSV(5 / 6, 1, 1)),
					ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1))
				})
				hueGradient.Parent = hueBar

				local hueButton = createButton(hueBar)
				hueButton.Size = UDim2.fromScale(1, 1)
				hueButton.ZIndex = 115

				local hueCursor = Instance.new("Frame")
				hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
				hueCursor.Size = UDim2.fromOffset(6, 20)
				hueCursor.BackgroundColor3 = Color3.new(1, 1, 1)
				hueCursor.BorderSizePixel = 0
				hueCursor.ZIndex = 116
				hueCursor.Parent = hueBar
				corner(hueCursor, 3)

				local function updateColor(fire)
					currentColor = Color3.fromHSV(
						hue,
						saturation,
						value
					)

					object.Value = currentColor
					colorButton.BackgroundColor3 = currentColor
					palette.BackgroundColor3 = Color3.fromHSV(
						hue,
						1,
						1
					)

					paletteCursor.Position = UDim2.fromScale(
						saturation,
						1 - value
					)

					hueCursor.Position = UDim2.new(
						hue,
						0,
						0.5,
						0
					)

					if fire then
						safeCallback(
							elementConfig.Callback,
							currentColor
						)
					end
				end

				local draggingPalette = false
				local draggingHue = false

				local function paletteUpdate(input, fire)
					local absolutePosition = palette.AbsolutePosition
					local size = palette.AbsoluteSize

					saturation = math.clamp(
						(input.Position.X - absolutePosition.X) / size.X,
						0,
						1
					)

					value = math.clamp(
						1 - ((input.Position.Y - absolutePosition.Y) / size.Y),
						0,
						1
					)

					updateColor(fire)
				end

				local function hueUpdate(input, fire)
					local absolutePosition = hueBar.AbsolutePosition
					local size = hueBar.AbsoluteSize

					hue = math.clamp(
						(input.Position.X - absolutePosition.X) / size.X,
						0,
						1
					)

					updateColor(fire)
				end

				paletteButton.MouseButton1Down:Connect(function()
					draggingPalette = true
				end)

				hueButton.MouseButton1Down:Connect(function()
					draggingHue = true
				end)

				object.Janitor:Add(
					UserInputService.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch then
							draggingPalette = false
							draggingHue = false
						end
					end)
				)

				object.Janitor:Add(
					UserInputService.InputChanged:Connect(function(input)
						if input.UserInputType ~= Enum.UserInputType.MouseMovement
							and input.UserInputType ~= Enum.UserInputType.Touch then
							return
						end

						if draggingPalette then
							paletteUpdate(input, true)
						elseif draggingHue then
							hueUpdate(input, true)
						end
					end)
				)

				local popupObject = {}

				function popupObject:Close()
					if not object.Open then
						return
					end

					object.Open = false

					tween(
						popup,
						FastTween,
						{
							Size = UDim2.fromOffset(230, 0)
						}
					):Play()

					task.delay(0.15, function()
						if not object.Open and popup.Parent then
							popup.Visible = false
						end
					end)
				end

				function popupObject:Open()
					if object.Open then
						return
					end

					windowObject:_ClosePopups(popupObject)

					object.Open = true
					popup.Visible = true

					local absolute = colorButton.AbsolutePosition
					local size = colorButton.AbsoluteSize

					popup.Position = UDim2.fromOffset(
						absolute.X - window.AbsolutePosition.X + size.X - 230,
						absolute.Y - window.AbsolutePosition.Y + size.Y + 5
					)

					tween(
						popup,
						MediumTween,
						{
							Size = UDim2.fromOffset(230, 230)
						}
					):Play()
				end

				windowObject:_RegisterPopup(popupObject)

				object.Janitor:Add(
					colorButton.MouseButton1Click:Connect(function()
						if object.Open then
							popupObject:Close()
						else
							popupObject:Open()
						end
					end)
				)

				object.Janitor:Add(
					UserInputService.InputBegan:Connect(function(input)
						if not object.Open then
							return
						end

						if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
							return
						end

						if isInside(input.Position, colorButton)
							or isInside(input.Position, popup) then
							return
						end

						popupObject:Close()
					end)
				)

				object.Janitor:Add(function()
					windowObject:_UnregisterPopup(popupObject)

					if popup.Parent then
						popup:Destroy()
					end
				end)

				function object:SetValue(color)
					if typeof(color) ~= "Color3" then
						return
					end

					currentColor = color

					local h, s, v = color:ToHSV()

					hue = h
					saturation = s
					value = v

					updateColor(true)
				end

				function object:GetValue()
					return currentColor
				end

				function object:SetName(value)
					name.Text = tostring(value)
				end

				function object:Close()
					popupObject:Close()
				end

				function object:Open()
					popupObject:Open()
				end

				addElement(object)

				updateColor(false)

				return object
			end

			function section:AddStatus(elementConfig)
				elementConfig = elementConfig or {}

				local frame = Instance.new("Frame")
				frame.Size = UDim2.new(1, 0, 0, 34)
				frame.BackgroundTransparency = 1
				frame.ZIndex = 6
				frame.Parent = holder

				local indicator = Instance.new("Frame")
				indicator.Position = UDim2.fromOffset(0, 10)
				indicator.Size = UDim2.fromOffset(8, 8)
				indicator.BackgroundColor3 = elementConfig.Color or theme.Success
				indicator.BorderSizePixel = 0
				indicator.ZIndex = 7
				indicator.Parent = frame
				corner(indicator, 4)

				local label = createLabel(
					frame,
					elementConfig.Text or "Status",
					11,
					theme.Subtext,
					Enum.Font.Gotham
				)

				label.Position = UDim2.fromOffset(16, 0)
				label.Size = UDim2.new(1, -16, 1, 0)
				label.ZIndex = 7

				local object = createElementObject(frame)

				function object:SetText(value)
					label.Text = tostring(value)
				end

				function object:SetColor(color)
					indicator.BackgroundColor3 = color
				end

				addElement(object)

				return object
			end

			function section:AddProgress(elementConfig)
				elementConfig = elementConfig or {}

				local minimum = tonumber(elementConfig.Min) or 0
				local maximum = tonumber(elementConfig.Max) or 100
				local value = math.clamp(
					tonumber(elementConfig.Default) or minimum,
					minimum,
					maximum
				)

				local frame = Instance.new("Frame")
				frame.Size = UDim2.new(1, 0, 0, 44)
				frame.BackgroundTransparency = 1
				frame.ZIndex = 6
				frame.Parent = holder

				local label = createLabel(
					frame,
					elementConfig.Name or "Progress",
					11,
					theme.Text,
					Enum.Font.GothamMedium
				)

				label.Size = UDim2.new(1, 0, 0, 18)
				label.ZIndex = 7

				local track = Instance.new("Frame")
				track.Position = UDim2.fromOffset(0, 25)
				track.Size = UDim2.new(1, 0, 0, 7)
				track.BackgroundColor3 = theme.Surface2
				track.BorderSizePixel = 0
				track.ZIndex = 7
				track.Parent = frame
				corner(track, 4)

				local fill = Instance.new("Frame")
				fill.Size = UDim2.fromScale(0, 1)
				fill.BackgroundColor3 = elementConfig.Color or theme.Accent
				fill.BorderSizePixel = 0
				fill.ZIndex = 8
				fill.Parent = track
				corner(fill, 4)

				local object = createElementObject(frame)
				object.Value = value

				function object:SetValue(newValue)
					object.Value = math.clamp(
						tonumber(newValue) or minimum,
						minimum,
						maximum
					)

					local alpha = (object.Value - minimum) / (maximum - minimum)

					tween(fill, FastTween, {
						Size = UDim2.fromScale(alpha, 1)
					}):Play()
				end

				function object:GetValue()
					return object.Value
				end

				addElement(object)

				object:SetValue(value)

				return object
			end

			return section
		end

		button.MouseButton1Click:Connect(function()
			tab:Select()
		end)

		button.MouseEnter:Connect(function()
			if windowObject.CurrentTab ~= tab then
				tween(tabBackground, FastTween, {
					BackgroundTransparency = 0.55
				}):Play()
			end
		end)

		button.MouseLeave:Connect(function()
			if windowObject.CurrentTab ~= tab then
				tween(tabBackground, FastTween, {
					BackgroundTransparency = 1
				}):Play()
			end
		end)

		table.insert(windowObject.Tabs, tab)

		if not windowObject.CurrentTab then
			tab:Select()
		end

		return tab
	end

	function windowObject:SetTitle(value)
		title.Text = tostring(value)
	end

	function windowObject:SetSubtitle(value)
		subtitle.Text = tostring(value)
	end

	function windowObject:SetSize(size)
		if typeof(size) ~= "UDim2" then
			return
		end

		tween(window, MediumTween, {
			Size = size
		}):Play()

		tween(shadow, MediumTween, {
			Size = size
		}):Play()
	end

	function windowObject:SetTheme(name, customTheme)
		local selectedTheme = Themes[name]

		if not selectedTheme then
			return
		end

		self.Theme = merge(selectedTheme, customTheme)

		local current = self.Theme

		window.BackgroundColor3 = current.Background
		header.BackgroundColor3 = current.Header
		shadow.BackgroundColor3 = current.Shadow

		stroke(window, current.Border, 1)

		title.TextColor3 = current.Text
		subtitle.TextColor3 = current.Subtext
	end

	function windowObject:SetVisible(value)
		gui.Enabled = value
	end

	function windowObject:Toggle()
		gui.Enabled = not gui.Enabled
	end

	function windowObject:GetVisible()
		return gui.Enabled
	end

	function windowObject:AddTab(tabConfig)
		return makeTab(tabConfig or {})
	end

	function windowObject:Notify(notificationConfig)
		notificationConfig = notificationConfig or {}

		local holder = gui:FindFirstChild("Notifications")

		if not holder then
			holder = Instance.new("Frame")
			holder.Name = "Notifications"
			holder.AnchorPoint = Vector2.new(1, 1)
			holder.Position = UDim2.new(1, -18, 1, -18)
			holder.Size = UDim2.fromOffset(300, 400)
			holder.BackgroundTransparency = 1
			holder.ZIndex = 500
			holder.Parent = gui

			local layout = list(
				holder,
				Enum.FillDirection.Vertical,
				8,
				Enum.HorizontalAlignment.Right
			)

			layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
		end

		local notification = Instance.new("Frame")
		notification.Size = UDim2.fromOffset(290, 70)
		notification.BackgroundColor3 = theme.Surface
		notification.BorderSizePixel = 0
		notification.ZIndex = 501
		notification.Parent = holder

		corner(notification, 9)
		stroke(notification, theme.Border, 1)

		local accent = Instance.new("Frame")
		accent.Size = UDim2.fromOffset(3, 50)
		accent.Position = UDim2.fromOffset(10, 10)
		accent.BackgroundColor3 = notificationConfig.Color or theme.Accent
		accent.BorderSizePixel = 0
		accent.ZIndex = 502
		accent.Parent = notification
		corner(accent, 2)

		local notificationTitle = createLabel(
			notification,
			notificationConfig.Title or "Notification",
			12,
			theme.Text,
			Enum.Font.GothamBold
		)

		notificationTitle.Position = UDim2.fromOffset(22, 10)
		notificationTitle.Size = UDim2.new(1, -32, 0, 20)
		notificationTitle.ZIndex = 502

		local notificationText = createLabel(
			notification,
			notificationConfig.Content or "",
			10,
			theme.Subtext,
			Enum.Font.Gotham
		)

		notificationText.Position = UDim2.fromOffset(22, 31)
		notificationText.Size = UDim2.new(1, -32, 0, 28)
		notificationText.TextWrapped = true
		notificationText.TextYAlignment = Enum.TextYAlignment.Top
		notificationText.ZIndex = 502

		notification.Position = UDim2.new(1, 30, 0, 0)

		tween(notification, MediumTween, {
			Position = UDim2.fromOffset(0, 0)
		}):Play()

		local duration = tonumber(notificationConfig.Duration) or 4

		task.delay(duration, function()
			if not notification.Parent then
				return
			end

			local animation = tween(notification, MediumTween, {
				Position = UDim2.new(1, 30, 0, 0)
			})

			animation:Play()

			animation.Completed:Wait()

			if notification.Parent then
				notification:Destroy()
			end
		end)

		return notification
	end

	function windowObject:Destroy()
		if self.Destroyed then
			return
		end

		self.Destroyed = true
		self.Janitor:Cleanup()
	end

	local toggleKey = config.ToggleKey or Enum.KeyCode.RightShift

	windowObject.Janitor:Add(
		UserInputService.InputBegan:Connect(function(input, processed)
			if processed then
				return
			end

			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end

			if input.KeyCode == toggleKey then
				windowObject:Toggle()
			end
		end)
	)

	windowObject.Janitor:Add(
		UserInputService.InputChanged:Connect(function(input)
			if windowObject.Destroyed then
				return
			end

			if input.UserInputType ~= Enum.UserInputType.MouseMovement
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			for _, popup in windowObject.Popups do
				if popup.Instance and popup.Instance.Visible then
					local popupInstance = popup.Instance

					if popupInstance.Name == "DropdownPopup" then
						for _, descendant in window:GetDescendants() do
							if descendant:IsA("TextButton")
								and descendant.Parent
								and descendant.Parent.Name == "DropdownPopup" then
								local dropdown = descendant.Parent
								if dropdown ~= popupInstance then
									continue
								end
							end
						end
					end
				end
			end
		end)
	)

	function windowObject:SetToggleKey(key)
		if typeof(key) == "EnumItem" then
			toggleKey = key
		end
	end

	return windowObject
end

return Library
