				object.Open = false

				local popup = Instance.new("Frame")
				popup.Name = "DropdownPopup"
				popup.BackgroundColor3 = theme.Surface
				popup.BorderSizePixel = 0
				popup.Visible = false
				popup.ClipsDescendants = true
				popup.ZIndex = 100
				popup.Parent = window

				corner(popup, 8)
				stroke(popup, theme.Border, 1)

				local popupPadding = padding(popup, 6, 6, 6, 6)

				local optionScroll = Instance.new("ScrollingFrame")
				optionScroll.Size = UDim2.fromScale(1, 1)
				optionScroll.BackgroundTransparency = 1
				optionScroll.BorderSizePixel = 0
				optionScroll.ScrollBarThickness = 3
				optionScroll.ScrollBarImageColor3 = theme.Accent
				optionScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
				optionScroll.CanvasSize = UDim2.fromOffset(0, 0)
				optionScroll.ZIndex = 101
				optionScroll.Parent = popup

				list(optionScroll, Enum.FillDirection.Vertical, 3)
				padding(optionScroll, 1, 1, 1, 1)

				local popupObject = {
					Instance = popup,
					Destroyed = false
				}

				function popupObject:Close()
					if not object.Open then
						return
					end

					object.Open = false

					tween(arrow, FastTween, {
						Rotation = 0
					}):Play()

					local animation = tween(popup, FastTween, {
						Size = UDim2.new(popup.Size.X.Scale, popup.Size.X.Offset, 0, 0)
					})

					animation:Play()

					task.delay(0.15, function()
						if not object.Open and popup.Parent then
							popup.Visible = false
						end
					end)
				end

				function popupObject:Open()
					if object.Open then
						return
					end

					windowObject:_ClosePopups(popupObject)

					object.Open = true
					popup.Visible = true

					local absolute = dropdown.AbsolutePosition
					local size = dropdown.AbsoluteSize

					popup.Position = UDim2.fromOffset(
						absolute.X - window.AbsolutePosition.X,
						absolute.Y - window.AbsolutePosition.Y + size.Y + 5
					)

					local height = math.min(
						math.max(#options * 31 + 14, 38),
						210
					)

					popup.Size = UDim2.fromOffset(size.X, 0)

					tween(arrow, FastTween, {
						Rotation = 180
					}):Play()

					tween(popup, MediumTween, {
						Size = UDim2.fromOffset(size.X, height)
					}):Play()
				end

				windowObject:_RegisterPopup(popupObject)

				local function getSelectedText()
					local values = {}

					for _, option in options do
						local value = tostring(option)

						if selected[value] then
							table.insert(values, value)
						end
					end

					if #values == 0 then
						return "Select..."
					end

					if multi then
						return table.concat(values, ", ")
					end

					return values[1]
				end

				local function refreshText()
					selectedText.Text = getSelectedText()
				end

				local function rebuild()
					for _, child in optionScroll:GetChildren() do
						if child:IsA("TextButton") then
							child:Destroy()
						end
					end

					for _, option in options do
						local value = tostring(option)

						local optionButton = Instance.new("TextButton")
						optionButton.Size = UDim2.new(1, 0, 0, 29)
						optionButton.AutoButtonColor = false
						optionButton.BackgroundColor3 = selected[value]
							and theme.Accent
							or theme.Surface2
						optionButton.BackgroundTransparency = selected[value]
							and 0.8
							or 0
						optionButton.BorderSizePixel = 0
						optionButton.Text = ""
						optionButton.ZIndex = 102
						optionButton.Parent = optionScroll
						corner(optionButton, 6)

						local text = createLabel(
							optionButton,
							value,
							11,
							selected[value]
								and theme.Text
								or theme.Subtext,
							Enum.Font.GothamMedium
						)

						text.Position = UDim2.fromOffset(9, 0)
						text.Size = UDim2.new(1, -18, 1, 0)
						text.ZIndex = 103

						optionButton.MouseEnter:Connect(function()
							if not selected[value] then
								tween(optionButton, FastTween, {
									BackgroundColor3 = theme.Border
								}):Play()
							end
						end)

						optionButton.MouseLeave:Connect(function()
							tween(optionButton, FastTween, {
								BackgroundColor3 = selected[value]
									and theme.Accent
									or theme.Surface2
							}):Play()
						end)

						optionButton.MouseButton1Click:Connect(function()
							if multi then
								selected[value] = not selected[value]
								refreshText()
								rebuild()

								local values = {}

								for _, item in options do
									local itemValue = tostring(item)

									if selected[itemValue] then
										table.insert(values, item)
									end
								end

								safeCallback(elementConfig.Callback, values)
							else
								table.clear(selected)
								selected[value] = true

								refreshText()
								rebuild()
								popupObject:Close()

								safeCallback(elementConfig.Callback, option)
							end
						end)
					end

					refreshText()
				end

				rebuild()

				object.Janitor:Add(
					dropdown.MouseButton1Click:Connect(function()
						if object.Open then
							popupObject:Close()
						else
							popupObject:Open()
						end
					end)
				)

				object.Janitor:Add(
					UserInputService.InputBegan:Connect(function(input)
						if not object.Open then
							return
						end

						if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
							return
						end

						if isInside(input.Position, dropdown)
							or isInside(input.Position, popup) then
							return
						end

						popupObject:Close()
					end)
				)

				object.Janitor:Add(function()
					windowObject:_UnregisterPopup(popupObject)

					if popup.Parent then
						popup:Destroy()
					end
				end)

				function object:SetValue(value)
					table.clear(selected)

					if multi then
						for _, item in value or {} do
							selected[tostring(item)] = true
						end
					else
						selected[tostring(value)] = true
					end

					rebuild()
				end

				function object:GetValue()
					if multi then
						local values = {}

						for _, option in options do
							if selected[tostring(option)] then
								table.insert(values, option)
							end
						end

						return values
					end

					for _, option in options do
						if selected[tostring(option)] then
							return option
						end
					end

					return nil
				end

				function object:SetOptions(newOptions)
					options = newOptions or {}
					object.Options = options

					table.clear(selected)

					if multi then
						for _, option in elementConfig.Default or {} do
							selected[tostring(option)] = true
						end
					elseif options[1] then
						selected[tostring(options[1])] = true
					end

					rebuild()
				end

				function object:SetName(value)
					name.Text = tostring(value)
				end

				function object:Close()
					popupObject:Close()
				end

				function object:Destroy()
					if object.Destroyed then
						return
					end

					object.Destroyed = true
					popupObject:Close()
					object.Janitor:Cleanup()
				end

				addElement(object)

				return object
			end

