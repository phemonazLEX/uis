			function section:AddSlider(elementConfig)
				elementConfig = elementConfig or {}

				local minimum = tonumber(elementConfig.Min) or 0
				local maximum = tonumber(elementConfig.Max) or 100
				local value = tonumber(elementConfig.Default) or minimum
				local decimals = elementConfig.Decimals or 0

				value = math.clamp(value, minimum, maximum)

				local frame = Instance.new("Frame")
				frame.Size = UDim2.new(1, 0, 0, 55)
				frame.BackgroundTransparency = 1
				frame.ZIndex = 6
				frame.Parent = holder

				local name = createLabel(
					frame,
					elementConfig.Name or "Slider",
					12,
					theme.Text,
					Enum.Font.GothamMedium
				)

				name.Size = UDim2.new(1, -70, 0, 22)
				name.ZIndex = 7

				local valueLabel = createLabel(
					frame,
					"",
					11,
					theme.Accent,
					Enum.Font.GothamMedium
				)

				valueLabel.AnchorPoint = Vector2.new(1, 0)
				valueLabel.Position = UDim2.new(1, 0, 0, 0)
				valueLabel.Size = UDim2.fromOffset(65, 22)
				valueLabel.TextXAlignment = Enum.TextXAlignment.Right
				valueLabel.ZIndex = 7

				local track = Instance.new("Frame")
				track.Position = UDim2.fromOffset(0, 31)
				track.Size = UDim2.new(1, 0, 0, 6)
				track.BackgroundColor3 = theme.Surface2
				track.BorderSizePixel = 0
				track.ZIndex = 7
				track.Parent = frame
				corner(track, 3)

				local fill = Instance.new("Frame")
				fill.Size = UDim2.fromScale(0, 1)
				fill.BackgroundColor3 = theme.Accent
				fill.BorderSizePixel = 0
				fill.ZIndex = 8
				fill.Parent = track
				corner(fill, 3)

				local button = createButton(track)
				button.Size = UDim2.new(1, 12, 1, 14)
				button.Position = UDim2.fromOffset(-6, -7)
				button.ZIndex = 9

				local object = createElementObject(frame)
				object.Value = value
				object.Min = minimum
				object.Max = maximum
				object.Callback = elementConfig.Callback

				local dragging = false

				local function roundValue(number)
					local multiplier = 10 ^ decimals
					return math.floor(number * multiplier + 0.5) / multiplier
				end

				local function updateFromInput(input, fire)
					local position = track.AbsolutePosition.X
					local width = track.AbsoluteSize.X
					local alpha = math.clamp(
						(input.Position.X - position) / width,
						0,
						1
					)

					local newValue = minimum + (maximum - minimum) * alpha
					newValue = roundValue(newValue)

					object.Value = newValue

					local ratio = (newValue - minimum) / (maximum - minimum)

					fill.Size = UDim2.fromScale(ratio, 1)
					valueLabel.Text = tostring(newValue)

					if fire then
						safeCallback(object.Callback, newValue)
					end
				end

				local function setValue(newValue, fire)
					newValue = math.clamp(
						tonumber(newValue) or minimum,
						minimum,
						maximum
					)

					newValue = roundValue(newValue)
					object.Value = newValue

					local ratio = (newValue - minimum) / (maximum - minimum)

					tween(fill, FastTween, {
						Size = UDim2.fromScale(ratio, 1)
					}):Play()

					valueLabel.Text = tostring(newValue)

					if fire then
						safeCallback(object.Callback, newValue)
					end
				end

				button.MouseButton1Down:Connect(function()
					dragging = true
				end)

				object.Janitor:Add(
					UserInputService.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1
							or input.UserInputType == Enum.UserInputType.Touch then
							dragging = false
						end
					end)
				)

				object.Janitor:Add(
					UserInputService.InputChanged:Connect(function(input)
						if not dragging then
							return
						end

						if input.UserInputType == Enum.UserInputType.MouseMovement
							or input.UserInputType == Enum.UserInputType.Touch then
							updateFromInput(input, true)
						end
					end)
				)

				setValue(value, false)

				function object:SetValue(newValue)
					setValue(newValue, true)
				end

				function object:GetValue()
					return object.Value
				end

				function object:SetName(newName)
					name.Text = tostring(newName)
				end

				addElement(object)

				return object
			end

