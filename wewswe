--// Helpers
local function Create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            inst[k] = v
        end
    end
    if props and props.Parent then
        inst.Parent = props.Parent
    end
    return inst
end

local function Round(n, p)
    local m = 10 ^ (p or 0)
    return math.floor(n * m + 0.5) / m
end

local function Tween(obj, props, dur, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(dur or 0.18, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function MakeDraggable(frame, handle)
    local dragging, dragStart, startPos, dragInput

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local function IsPointInside(gui, point)
    if not gui or not gui.Parent or not gui.Visible then return false end
    local pos, size = gui.AbsolutePosition, gui.AbsoluteSize
    return point.X >= pos.X and point.X <= pos.X + size.X and point.Y >= pos.Y and point.Y <= pos.Y + size.Y
end

local function CloseAllDropdowns(except)
    for i = #Library.OpenDropdowns, 1, -1 do
        local item = Library.OpenDropdowns[i]
        if item and item.Frame and item.Frame ~= except then
            pcall(function() item.Frame:Destroy() end)
            table.remove(Library.OpenDropdowns, i)
        end
    end
end

local function TrackOverlay(frame, anchor, update, applyTheme)
    local item = {
        Frame = frame,
        Anchor = anchor,
        Update = update,
        ApplyTheme = applyTheme,
    }
    table.insert(Library.OpenDropdowns, item)
    frame.Destroying:Connect(function()
        for i = #Library.OpenDropdowns, 1, -1 do
            if Library.OpenDropdowns[i] == item then
                table.remove(Library.OpenDropdowns, i)
                break
            end
        end
    end)
    return item
end

RunService.RenderStepped:Connect(function()
    for i = #Library.OpenDropdowns, 1, -1 do
        local item = Library.OpenDropdowns[i]
        if not item or not item.Frame or not item.Frame.Parent then
            table.remove(Library.OpenDropdowns, i)
        elseif item.Update then
            pcall(item.Update)
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    local point = input.Position
    for i = 1, #Library.OpenDropdowns do
        local item = Library.OpenDropdowns[i]
        if item and (IsPointInside(item.Frame, point) or IsPointInside(item.Anchor, point)) then
            return
        end
    end
    CloseAllDropdowns()
end)

local function AddGradient(parent, startColor, endColor, rotation)
    return Create("UIGradient", {
        Parent = parent,
        Color = ColorSequence.new(startColor, endColor),
        Rotation = rotation or 0,
    })
end

