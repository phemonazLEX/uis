            ----------------------------------------------------------------
            -- SLIDER
            ----------------------------------------------------------------
            function Section:AddSlider(opt)
                opt = opt or {}
                local Name = opt.Name or "Slider"
                local Min = opt.Min or 0
                local Max = opt.Max or 100
                local Default = opt.Default or Min
                local Increment = opt.Increment or 1
                local Suffix = opt.Suffix or ""
                local Callback = opt.Callback or function() end

                local Value = math.clamp(Default, Min, Max)

                local Element = Create("Frame", {
                    Name = Name,
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 52),
                    ZIndex = 4,
                    Parent = SectionFrame
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Element})

                local NameLabel = Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0.7, 0, 0, 20),
                    Position = UDim2.fromOffset(12, 6),
                    Font = Enum.Font.Gotham,
                    Text = Name,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 5,
                    Parent = Element
                })

                local ValueLabel = Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0.3, -12, 0, 20),
                    Position = UDim2.new(0.7, 0, 0, 6),
                    Font = Enum.Font.GothamMedium,
                    Text = tostring(Value) .. Suffix,
                    TextColor3 = Theme.Accent,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 5,
                    Parent = Element
                })

                local Track = Create("Frame", {
                    Name = "Track",
                    BackgroundColor3 = Theme.ToggleOff,
                    Size = UDim2.new(1, -24, 0, 6),
                    Position = UDim2.fromOffset(12, 34),
                    ZIndex = 5,
                    Parent = Element
                })
                Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Track})

                local Fill = Create("Frame", {
                    Name = "Fill",
                    BackgroundColor3 = Theme.Accent,
                    Size = UDim2.new((Value - Min) / (Max - Min), 0, 1, 0),
                    BorderSizePixel = 0,
                    ZIndex = 6,
                    Parent = Track
                })
                Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Fill})

                local Knob = Create("Frame", {
                    Name = "Knob",
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    Size = UDim2.fromOffset(14, 14),
                    Position = UDim2.new((Value - Min) / (Max - Min), -7, 0.5, -7),
                    ZIndex = 7,
                    Parent = Track
                })
                Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Knob})
                Create("UIStroke", {Color = Theme.Accent, Thickness = 2, Parent = Knob})

                local Sliding = false

                local function Set(val, fire)
                    val = math.clamp(math.round(val / Increment) * Increment, Min, Max)
                    Value = val
                    local pct = (Value - Min) / (Max - Min)
                    Fill.Size = UDim2.new(pct, 0, 1, 0)
                    Knob.Position = UDim2.new(pct, -7, 0.5, -7)
                    ValueLabel.Text = tostring(Value) .. Suffix
                    if fire ~= false then
                        Callback(Value)
                    end
                end

                local function UpdateFromInput(input)
                    local rel = (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X
                    Set(Min + (Max - Min) * math.clamp(rel, 0, 1))
                end

                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        Sliding = true
                        UpdateFromInput(input)
                    end
                end)

                Knob.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        Sliding = true
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if Sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        UpdateFromInput(input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        Sliding = false
                    end
                end)

                Element.MouseEnter:Connect(function()
                    Tween(Element, {BackgroundColor3 = Theme.ElementHover}, 0.15)
                end)
                Element.MouseLeave:Connect(function()
                    Tween(Element, {BackgroundColor3 = Theme.Element}, 0.15)
                end)

                local SliderObj = {
                    Frame = Element,
                    SetValue = function(_, v) Set(v) end,
                    GetValue = function() return Value end,
                    SetName = function(_, n) NameLabel.Text = n end,
                    SetVisible = function(_, v) Element.Visible = v end,
                    Destroy = function() Element:Destroy() end
                }
                table.insert(Section.Elements, SliderObj)
                return SliderObj
            end

