                    Parent = Element
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = KeyBtn})
                Create("UIStroke", {Color = Theme.Border, Thickness = 1, Transparency = 0.4, Parent = KeyBtn})

                local function SetKey(key)
                    CurrentKey = key
                    KeyBtn.Text = key.Name
                    Callback(key)
                end

                KeyBtn.MouseButton1Click:Connect(function()
                    if Listening then return end
                    Listening = true
                    KeyBtn.Text = "..."
                    Tween(KeyBtn, {BackgroundColor3 = Theme.Accent}, 0.15)

                    local conn
                    conn = UserInputService.InputBegan:Connect(function(input, processed)
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            SetKey(input.KeyCode)
                            Listening = false
                            Tween(KeyBtn, {BackgroundColor3 = Theme.BackgroundSecondary}, 0.15)
                            if conn then conn:Disconnect() end
                        elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
                            Listening = false
                            KeyBtn.Text = CurrentKey.Name
                            Tween(KeyBtn, {BackgroundColor3 = Theme.BackgroundSecondary}, 0.15)
                            if conn then conn:Disconnect() end
                        end
                    end)
                end)

                Element.MouseEnter:Connect(function()
                    Tween(Element, {BackgroundColor3 = Theme.ElementHover}, 0.15)
                end)
                Element.MouseLeave:Connect(function()
                    Tween(Element, {BackgroundColor3 = Theme.Element}, 0.15)
                end)

                local KeybindObj = {
                    Frame = Element,
                    SetValue = function(_, k) SetKey(k) end,
                    GetValue = function() return CurrentKey end,
                    SetName = function(_, n) NameLabel.Text = n end,
                    SetVisible = function(_, v) Element.Visible = v end,
                    Destroy = function() Element:Destroy() end
                }
                table.insert(Section.Elements, KeybindObj)
                return KeybindObj
            end

            ----------------------------------------------------------------
            -- COLOR PICKER
            ----------------------------------------------------------------
            function Section:AddColorPicker(opt)
                opt = opt or {}
                local Name = opt.Name or "Color"
                local Default = opt.Default or Color3.fromRGB(255, 120, 40)
                local Callback = opt.Callback or function() end

                local CurrentColor = Default
                local Hue, Sat, Val = Color3.toHSV(CurrentColor)

                local Element = CreateElementBase(Name, 36)

                local NameLabel = Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -50, 1, 0),
                    Position = UDim2.fromOffset(12, 0),
                    Font = Enum.Font.Gotham,
                    Text = Name,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 5,
                    Parent = Element
                })

                local ColorDisplay = Create("Frame", {
                    Name = "Display",
                    BackgroundColor3 = CurrentColor,
                    Size = UDim2.fromOffset(28, 28),
                    Position = UDim2.new(1, -40, 0.5, -14),
                    ZIndex = 5,
                    Parent = Element
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = ColorDisplay})
                Create("UIStroke", {Color = Theme.Border, Thickness = 1, Parent = ColorDisplay})

                local PickerOpen = false
                local PickerFrame = nil
                local PickerObj = {}

                local function ClosePicker()
                    if not PickerOpen or not PickerFrame then return end
                    PickerOpen = false
                    OpenPopups[PickerObj] = nil
                    if ActiveColorPicker == PickerObj then ActiveColorPicker = nil end
                    local t = Tween(PickerFrame, {Size = UDim2.fromOffset(220, 0)}, 0.15)
                    t.Completed:Connect(function()
                        if PickerFrame then
                            PickerFrame:Destroy()
                            PickerFrame = nil
                        end
                    end)
                end

                local function OpenPicker()
                    if PickerOpen then return end
                    CloseAllPopups(PickerObj)
                    PickerOpen = true
                    ActiveColorPicker = PickerObj
                    OpenPopups[PickerObj] = true

                    local absPos = ColorDisplay.AbsolutePosition
                    local absSize = ColorDisplay.AbsoluteSize

                    PickerFrame = Create("Frame", {
                        Name = "ColorPickerPopup",
                        BackgroundColor3 = Theme.Dropdown,
                        BorderSizePixel = 0,
                        Size = UDim2.fromOffset(220, 0),
                        Position = UDim2.fromOffset(absPos.X - 180, absPos.Y + absSize.Y + 6),
                        ZIndex = 60,
                        ClipsDescendants = true,
                        Parent = ScreenGui
                    })
                    Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = PickerFrame})
                    Create("UIStroke", {Color = Theme.Stroke, Thickness = 1, Parent = PickerFrame})
                    Create("UIPadding", {
                        PaddingTop = UDim.new(0, 10),
                        PaddingBottom = UDim.new(0, 10),
                        PaddingLeft = UDim.new(0, 10),
                        PaddingRight = UDim.new(0, 10),
                        Parent = PickerFrame
                    })

                    -- SV Palette
                    local Palette = Create("Frame", {
                        Name = "Palette",
                        BackgroundColor3 = Color3.fromHSV(Hue, 1, 1),
                        Size = UDim2.fromOffset(180, 140),
                        Position = UDim2.fromOffset(0, 0),
                        ZIndex = 61,
                        Parent = PickerFrame
                    })

                    -- White to transparent gradient (horizontal sat)
                    local WhiteGrad = Create("Frame", {
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        Size = UDim2.fromScale(1, 1),
                        BorderSizePixel = 0,
                        ZIndex = 62,
                        Parent = Palette
                    })
                    Create("UIGradient", {
                        Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 0),
                            NumberSequenceKeypoint.new(1, 1)
                        }),
                        Parent = WhiteGrad
                    })

                    -- Black to transparent (vertical val)
                    local BlackGrad = Create("Frame", {
                        BackgroundColor3 = Color3.new(0, 0, 0),
                        Size = UDim2.fromScale(1, 1),
                        BorderSizePixel = 0,
                        ZIndex = 63,
                        Parent = Palette
                    })
                    Create("UIGradient", {
                        Rotation = 90,
                        Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, 1),
                            NumberSequenceKeypoint.new(1, 0)
                        }),
                        Parent = BlackGrad
                    })

                    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Palette})

                    local Cursor = Create("Frame", {
                        Name = "Cursor",
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        Size = UDim2.fromOffset(12, 12),
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.new(Sat, 0, 1 - Val, 0),
                        ZIndex = 64,
                        Parent = Palette
                    })
                    Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Cursor})
                    Create("UIStroke", {Color = Color3.new(0, 0, 0), Thickness = 2, Parent = Cursor})

                    -- Hue Slider
                    local HueTrack = Create("Frame", {
                        Name = "HueTrack",
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        Size = UDim2.fromOffset(180, 14),
                        Position = UDim2.fromOffset(0, 150),
                        ZIndex = 61,
                        Parent = PickerFrame
                    })
                    Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = HueTrack})
                    local HueGrad = Create("UIGradient", {
                        Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                            ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
                            ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
                            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
                            ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
                            ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
                            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
                        }),
                        Parent = HueTrack
                    })

                    local HueCursor = Create("Frame", {
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        Size = UDim2.fromOffset(6, 18),
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.new(Hue, 0, 0.5, 0),
                        ZIndex = 62,
                        Parent = HueTrack
                    })
                    Create("UICorner", {CornerRadius = UDim.new(0, 2), Parent = HueCursor})
                    Create("UIStroke", {Color = Color3.new(0, 0, 0), Thickness = 1, Parent = HueCursor})

                    -- Preview
                    local Preview = Create("Frame", {
                        BackgroundColor3 = CurrentColor,
                        Size = UDim2.fromOffset(180, 24),
                        Position = UDim2.fromOffset(0, 174),
                        ZIndex = 61,
                        Parent = PickerFrame
                    })
                    Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = Preview})

                    local function UpdateColor(fire)
                        CurrentColor = Color3.fromHSV(Hue, Sat, Val)
                        ColorDisplay.BackgroundColor3 = CurrentColor
                        Preview.BackgroundColor3 = CurrentColor
                        Palette.BackgroundColor3 = Color3.fromHSV(Hue, 1, 1)
                        Cursor.Position = UDim2.new(Sat, 0, 1 - Val, 0)
                        HueCursor.Position = UDim2.new(Hue, 0, 0.5, 0)
                        if fire ~= false then
                            Callback(CurrentColor)
                        end
                    end

                    local DraggingSV = false
                    local DraggingHue = false

                    local function UpdateSV(input)
                        local relX = math.clamp((input.Position.X - Palette.AbsolutePosition.X) / Palette.AbsoluteSize.X, 0, 1)
                        local relY = math.clamp((input.Position.Y - Palette.AbsolutePosition.Y) / Palette.AbsoluteSize.Y, 0, 1)
                        Sat = relX
                        Val = 1 - relY
                        UpdateColor()
                    end

                    local function UpdateHue(input)
                        local relX = math.clamp((input.Position.X - HueTrack.AbsolutePosition.X) / HueTrack.AbsoluteSize.X, 0, 1)
                        Hue = relX
                        UpdateColor()
                    end

                    Palette.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            DraggingSV = true
                            UpdateSV(input)
                        end
                    end)

                    HueTrack.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            DraggingHue = true
                            UpdateHue(input)
                        end
                    end)

                    local moveConn = UserInputService.InputChanged:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                            if DraggingSV then UpdateSV(input) end
                            if DraggingHue then UpdateHue(input) end
                        end
                    end)

                    local endConn = UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            DraggingSV = false
                            DraggingHue = false
                        end
                    end)

                    -- Outside click (but ignore clicks inside picker)
                    local clickConn
                    clickConn = UserInputService.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            local pos = input.Position
                            if PickerFrame then
                                local inPicker = pos.X >= PickerFrame.AbsolutePosition.X and pos.X <= PickerFrame.AbsolutePosition.X + PickerFrame.AbsoluteSize.X and
                                    pos.Y >= PickerFrame.AbsolutePosition.Y and pos.Y <= PickerFrame.AbsolutePosition.Y + PickerFrame.AbsoluteSize.Y
                                local inDisplay = pos.X >= ColorDisplay.AbsolutePosition.X and pos.X <= ColorDisplay.AbsolutePosition.X + ColorDisplay.AbsoluteSize.X and
                                    pos.Y >= ColorDisplay.AbsolutePosition.Y and pos.Y <= ColorDisplay.AbsolutePosition.Y + ColorDisplay.AbsoluteSize.Y
                                if not inPicker and not inDisplay then
                                    ClosePicker()
                                    if clickConn then clickConn:Disconnect() end
                                    if moveConn then moveConn:Disconnect() end
                                    if endConn then endConn:Disconnect() end
                                end
                            end
                        end
                    end)

                    Tween(PickerFrame, {Size = UDim2.fromOffset(200, 210)}, 0.2)
                end

                function PickerObj.UpdatePosition()
                    if PickerOpen and PickerFrame and ColorDisplay then
                        local absPos = ColorDisplay.AbsolutePosition
                        local absSize = ColorDisplay.AbsoluteSize
                        PickerFrame.Position = UDim2.fromOffset(absPos.X - 180, absPos.Y + absSize.Y + 6)
                    end
                end

                function PickerObj.Close()
                    ClosePicker()
                end

                local Hit = Create("TextButton", {
                    BackgroundTransparency = 1,
                    Size = UDim2.fromScale(1, 1),
                    Text = "",
                    ZIndex = 7,
                    Parent = Element
                })
                Hit.MouseButton1Click:Connect(function()
                    if PickerOpen then
                        ClosePicker()
                    else
                        OpenPicker()
                    end
                end)

                Element.MouseEnter:Connect(function()
                    Tween(Element, {BackgroundColor3 = Theme.ElementHover}, 0.15)
                end)
                Element.MouseLeave:Connect(function()
                    Tween(Element, {BackgroundColor3 = Theme.Element}, 0.15)
                end)

                table.insert(Window.Popups, PickerObj)

                local ColorObj = {
                    Frame = Element,
                    SetValue = function(_, c)
                        CurrentColor = c
                        Hue, Sat, Val = Color3.toHSV(c)
                        ColorDisplay.BackgroundColor3 = c
                        Callback(c)
                    end,
                    GetValue = function() return CurrentColor end,
                    SetName = function(_, n) NameLabel.Text = n end,
                    SetVisible = function(_, v) Element.Visible = v end,
                    Destroy = function()
                        ClosePicker()
                        Element:Destroy()
                    end
                }
                table.insert(Section.Elements, ColorObj)
                return ColorObj
            end

            ----------------------------------------------------------------
            -- PARAGRAPH
            ----------------------------------------------------------------
            function Section:AddParagraph(opt)
                opt = opt or {}
                local Title = opt.Title or ""
                local Content = opt.Content or ""

                local Element = Create("Frame", {
                    Name = "Paragraph",
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    ZIndex = 4,
                    Parent = SectionFrame
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Element})
                Create("UIPadding", {
                    PaddingTop = UDim.new(0, 10),
                    PaddingBottom = UDim.new(0, 10),
                    PaddingLeft = UDim.new(0, 12),
                    PaddingRight = UDim.new(0, 12),
                    Parent = Element
                })
                local Layout = Create("UIListLayout", {
                    Padding = UDim.new(0, 4),
                    Parent = Element
                })

                if Title ~= "" then
                    Create("TextLabel", {
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 0, 18),
                        Font = Enum.Font.GothamBold,
                        Text = Title,
                        TextColor3 = Theme.Text,
                        TextSize = 13,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 5,
                        Parent = Element
                    })
                end

                Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Font = Enum.Font.Gotham,
                    Text = Content,
                    TextColor3 = Theme.TextSecondary,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    ZIndex = 5,
                    Parent = Element
                })

                return {
                    Frame = Element,
                    SetVisible = function(_, v) Element.Visible = v end,
                    Destroy = function() Element:Destroy() end
                }
            end

            return Section
        end

        return Tab
    end

    return Window
end

-- Utility to add custom theme
function Library:AddTheme(name, themeTable)
    Themes[name] = themeTable
end

function Library:GetThemes()
    return Themes
end

return Library
