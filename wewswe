				local ddLabel = Instance.new("TextLabel")
				MakeClear(ddLabel)
				ddLabel.Text          = name
				ddLabel.TextColor3    = th.Text
				ddLabel.Font          = Enum.Font.GothamSemibold
				ddLabel.TextSize      = 12
				ddLabel.TextXAlignment = Enum.TextXAlignment.Left
				ddLabel.Size          = UDim2.new(0.45, 0, 1, 0)
				ddLabel.ZIndex        = 6
				ddLabel.Parent        = row

				local ddBtn = Instance.new("TextButton")
				ddBtn.Name             = "DropBtn"
				ddBtn.Text             = ""
				ddBtn.BackgroundColor3 = th.WindowBg
				ddBtn.Size             = UDim2.new(0.55, 0, 0, 26)
				ddBtn.Position         = UDim2.new(0.45, 0, 0.5, -13)
				ddBtn.ZIndex           = 6
				ddBtn.Parent           = row
				Round(ddBtn, 4)
				Stroke(ddBtn, th.Border, 1)

				local function GetDisplayText()
					if multi then
						local keys = {}
						for k in pairs(selected) do table.insert(keys, k) end
						if #keys == 0 then return "None" end
						if #keys == 1 then return keys[1] end
						return keys[1] .. " +" .. (#keys - 1)
					else
						return selected ~= "" and tostring(selected) or (options[1] or "None")
					end
				end

				local ddValue = Instance.new("TextLabel")
				MakeClear(ddValue)
				ddValue.Text          = GetDisplayText()
				ddValue.TextColor3    = th.TextDim
				ddValue.Font          = Enum.Font.Gotham
				ddValue.TextSize      = 11
				ddValue.TextXAlignment = Enum.TextXAlignment.Left
				ddValue.Size          = UDim2.new(1, -22, 1, 0)
				ddValue.Position      = UDim2.new(0, 8, 0, 0)
				ddValue.ZIndex        = 7
				ddValue.Parent        = ddBtn

				local ddArrow = Instance.new("TextLabel")
				MakeClear(ddArrow)
				ddArrow.Text          = "▾"
				ddArrow.TextColor3    = th.TextDim
				ddArrow.Font          = Enum.Font.GothamBold
				ddArrow.TextSize      = 10
				ddArrow.TextXAlignment = Enum.TextXAlignment.Right
				ddArrow.Size          = UDim2.new(0, 18, 1, 0)
				ddArrow.Position      = UDim2.new(1, -20, 0, 0)
				ddArrow.ZIndex        = 7
				ddArrow.Parent        = ddBtn

