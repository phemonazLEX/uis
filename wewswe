                        end)
                        UserInputService.InputEnded:Connect(function(input)
                            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                        end)
                        UserInputService.InputChanged:Connect(function(input)
                            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                                local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                                local newVal = math.floor(pct * 255)
                                fill.Size = UDim2.new(pct, 0, 1, 0)
                                valLbl.Text = tostring(newVal)
                                
                                local r, g, b = currentColor.R * 255, currentColor.G * 255, currentColor.B * 255
                                if channel == "R" then r = newVal
                                elseif channel == "G" then g = newVal
                                else b = newVal end
                                currentColor = Color3.fromRGB(r, g, b)
                                preview.BackgroundColor3 = currentColor
                                if flag then Library.Flags[flag] = currentColor end
                                task.spawn(callback, currentColor)
                            end
                        end)
                    end

                    local r, g, b = currentColor.R * 255, currentColor.G * 255, currentColor.B * 255
                    MakeRGBSlider(12, "R", r)
                    MakeRGBSlider(40, "G", g)
                    MakeRGBSlider(68, "B", b)

                    local closeBtn = Create("TextButton", {
                        Parent = pickerFrame,
                        BackgroundColor3 = Theme.Tertiary,
                        BorderSizePixel = 0,
                        Position = UDim2.new(0, 10, 1, -32),
                        Size = UDim2.new(1, -20, 0, 24),
                        Font = Enum.Font.GothamMedium,
                        Text = "Close",
                        TextColor3 = Theme.Text,
                        TextSize = 12,
                        AutoButtonColor = false,
                        ZIndex = 26,
                    })
                    Create("UICorner", { Parent = closeBtn, CornerRadius = UDim.new(0, 5) })
                    closeBtn.MouseButton1Click:Connect(ClosePicker)
                end

                preview.MouseButton1Click:Connect(OpenPicker)

                return {
                    Set = function(_, c)
                        currentColor = c
                        preview.BackgroundColor3 = c
                        if flag then Library.Flags[flag] = c end
                    end,
                    Get = function() return currentColor end,
                }
            end

            return Section
        end

        return Tab
    end

    -- Notification system (bonus)
    function Window:Notify(opt)
        opt = opt or {}
        local title = opt.Title or "Notification"
        local content = opt.Content or ""
        local duration = opt.Duration or 3
        local notifType = opt.Type or "Info" -- Info, Success, Warning, Error

        local accentColor = Theme.Accent
        if notifType == "Success" then accentColor = Theme.Success
        elseif notifType == "Warning" then accentColor = Theme.Warning
        elseif notifType == "Error" then accentColor = Theme.Danger end

        local notif = Create("Frame", {
            Parent = ScreenGui,
            BackgroundColor3 = Theme.Secondary,
            BorderSizePixel = 0,
            Position = UDim2.new(1, 20, 1, -80),
            Size = UDim2.new(0, 260, 0, 70),
            ZIndex = 100,
        })
        Create("UICorner", { Parent = notif, CornerRadius = UDim.new(0, 8) })
        Create("UIStroke", { Parent = notif, Color = Theme.Border, Thickness = 1 })

        local bar = Create("Frame", {
            Parent = notif,
            BackgroundColor3 = accentColor,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 4, 1, 0),
            ZIndex = 101,
        })
        Create("UICorner", { Parent = bar, CornerRadius = UDim.new(0, 8) })

        Create("TextLabel", {
            Parent = notif,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 16, 0, 8),
            Size = UDim2.new(1, -24, 0, 18),
            Font = Enum.Font.GothamBold,
            Text = title,
            TextColor3 = Theme.Text,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 101,
        })

        Create("TextLabel", {
            Parent = notif,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 16, 0, 28),
            Size = UDim2.new(1, -24, 0, 32),
            Font = Enum.Font.Gotham,
            Text = content,
            TextColor3 = Theme.TextDim,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            ZIndex = 101,
        })

        Tween(notif, { Position = UDim2.new(1, -280, 1, -80) }, 0.3, Enum.EasingStyle.Back)

        task.delay(duration, function()
            Tween(notif, { Position = UDim2.new(1, 20, 1, -80) }, 0.25)
            task.wait(0.25)
            notif:Destroy()
        end)
    end

    table.insert(Library.Windows, Window)
    return Window
end

-- Clean destroy
function Library:Destroy()
    for _, win in ipairs(Library.Windows) do
        if win.ScreenGui then
            win.ScreenGui:Destroy()
        end
    end
    Library.Windows = {}
end

return Library
