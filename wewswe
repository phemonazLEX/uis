function Window:AddTab(config)
	config = config or {}
	local window = self
	local theme = window.Theme

	local tab = setmetatable({}, Tab)
	tab.Window = window
	tab.Name = config.Name or "Tab"
	tab.Sections = {}
	tab._order = 0

	-- Tab button -----------------------------------------------------
	local button = Create("TextButton", {
		Name = tab.Name,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = theme.TabInactive,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = #self.Tabs + 1,
		ZIndex = 12,
		Parent = self.TabBar,
	})
	Corner(button, 6)
	Padding(button, 0, 12, 0, 12)
	List(button, {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
	})

	local icon = nil
	if config.Icon then
		local isAsset = type(config.Icon) == "number"
			or (type(config.Icon) == "string" and (config.Icon:match("^%d+$") or config.Icon:find("rbxasset")))
		if isAsset then
			icon = Create("ImageLabel", {
				Name = "Icon",
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(15, 15),
				Image = type(config.Icon) == "number" and ("rbxassetid://" .. config.Icon) or config.Icon,
				ImageColor3 = theme.TabText,
				Parent = button,
			})
		end
	end

	local label = Create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Enum.Font.GothamMedium,
		Text = tab.Name,
		TextColor3 = theme.TabText,
		TextSize = 12,
		TextYAlignment = Enum.TextYAlignment.Center,
		Parent = button,
	})

	tab.Button = button
	tab.Label = label
	tab.Icon = icon

	-- Tab page -------------------------------------------------------
	local page = Create("ScrollingFrame", {
		Name = tab.Name .. "Page",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = theme.ScrollBar,
		ScrollBarImageTransparency = 0.35,
		Visible = false,
		ZIndex = 12,
		Parent = self.Content,
	})

	local pageContent = Create("Frame", {
		Name = "Page",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = page,
	})
	Padding(pageContent, 10, 10, 10, 10)
	List(pageContent, { Padding = UDim.new(0, 8) })

	tab.Page = page
	tab.PageContent = pageContent

	-- Keep popups glued while scrolling ------------------------------
	table.insert(self._connections, page:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		window:_UpdatePopups()
	end))

	-- Interaction ----------------------------------------------------
	local hovering = false
	local function refresh()
		local active = window.ActiveTab == tab
		if active then
			button.BackgroundTransparency = 0
			Tween(button, 0.15, { BackgroundColor3 = theme.TabActive })
			label.TextColor3 = theme.TabTextActive
			if icon then
				icon.ImageColor3 = theme.TabTextActive
			end
		else
			button.BackgroundTransparency = hovering and 0.4 or 1
			Tween(button, 0.15, { BackgroundColor3 = hovering and theme.TabHover or theme.TabInactive })
			label.TextColor3 = hovering and theme.Text or theme.TabText
			if icon then
				icon.ImageColor3 = hovering and theme.Text or theme.TabText
			end
		end
	end

	table.insert(self._connections, button.MouseEnter:Connect(function()
		hovering = true
		refresh()
	end))
	table.insert(self._connections, button.MouseLeave:Connect(function()
		hovering = false
		refresh()
	end))
	table.insert(self._connections, button.MouseButton1Click:Connect(function()
		window:SelectTab(tab)
	end))

	-- Theme registration ---------------------------------------------
	window:_RegisterThemeFunction(function(theme)
		page.ScrollBarImageColor3 = theme.ScrollBar
		refresh()
	end)

	tab.Refresh = refresh

	table.insert(self.Tabs, tab)

	if not self.ActiveTab then
		self:SelectTab(tab)
	else
		refresh()
	end

	return tab
end

function Window:SelectTab(tab)
	if self.ActiveTab == tab then
		return
	end

	-- Close popups belonging to the previous tab
	self:ClosePopups()
	self:HideTooltip()

	if self.ActiveTab then
		self.ActiveTab.Page.Visible = false
	end

	self.ActiveTab = tab
	tab.Page.Visible = true

	for _, other in ipairs(self.Tabs) do
		if other.Refresh then
			other.Refresh()
		end
	end
end

-----------------------------------------------------------------------
-- Destroy
-----------------------------------------------------------------------

function Window:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true

	if activeDrag then
		CancelDrag()
	end

	if self._toggleConnection then
		self._toggleConnection:Disconnect()
		self._toggleConnection = nil
	end

	for _, connection in ipairs(self._connections) do
		if connection.Connected then
			connection:Disconnect()
		end
	end
	self._connections = {}

	self:HideTooltip()
	for index = #self._popups, 1, -1 do
		self._popups[index]:Destroy()
	end
	self._popups = {}
	if self.Root then
		self.Root:Destroy()
	end

	local index = table.find(self.Library.Windows, self)
	if index then
		table.remove(self.Library.Windows, index)
	end
end

