-- ─────────────────────────────────────────────────────────
-- GRADIENT HELPER  — creates a two-stop ImageLabel gradient
-- Using rbxassetid://4155801252 (white→transparent) tinted for top/bot
-- We fake a gradient with a Frame + UIGradient since rbxassets are unreliable
-- ─────────────────────────────────────────────────────────
local function MakeGradientFrame(parent, topColor, botColor, zIndex)
    local f = Create("Frame", {
        Parent = parent,
        BackgroundColor3 = topColor,
        BorderSizePixel  = 0,
        Size  = UDim2.new(1,0,1,0),
        ZIndex = zIndex or 1,
    })
    Create("UIGradient", {
        Parent = f,
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, topColor),
            ColorSequenceKeypoint.new(1, botColor),
        }),
    })
    return f
end

