            --// TOGGLE
            function Section:CreateToggle(opt)
                opt = opt or {}
                local name = opt.Name or "Toggle"
                local default = opt.Default or false
                local flag = opt.Flag
                local callback = opt.Callback or function() end

                local row = CreateRow(32)

                local label = Create("TextLabel", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 4, 0, 0),
                    Size = UDim2.new(1, -60, 1, 0),
                    Font = Enum.Font.Gotham,
                    Text = name,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Center,
                    ZIndex = 5,
                })

                local track = Create("Frame", {
                    Parent = row,
                    BackgroundColor3 = Theme.Tertiary,
                    BorderSizePixel = 0,
                    Position = UDim2.new(1, -48, 0.5, -9),
                    Size = UDim2.new(0, 40, 0, 18),
                    ZIndex = 5,
                })
                Create("UICorner", { Parent = track, CornerRadius = UDim.new(1, 0) })

                local knob = Create("Frame", {
                    Parent = track,
                    BackgroundColor3 = Theme.TextDim,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 2, 0.5, -7),
                    Size = UDim2.new(0, 14, 0, 14),
                    ZIndex = 6,
                })
                Create("UICorner", { Parent = knob, CornerRadius = UDim.new(1, 0) })

                local state = default

                local function SetState(val, fire)
                    state = val
                    if state then
                        Tween(track, { BackgroundColor3 = Theme.Accent }, 0.15)
                        Tween(knob, { Position = UDim2.new(1, -16, 0.5, -7), BackgroundColor3 = Theme.Text }, 0.15)
                    else
                        Tween(track, { BackgroundColor3 = Theme.Tertiary }, 0.15)
                        Tween(knob, { Position = UDim2.new(0, 2, 0.5, -7), BackgroundColor3 = Theme.TextDim }, 0.15)
                    end
                    if flag then Library.Flags[flag] = state end
                    if fire ~= false then
                        task.spawn(callback, state)
                    end
                end

                SetState(default, false)

                local btn = Create("TextButton", {
                    Parent = row,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 1, 0),
                    Text = "",
                    ZIndex = 7,
                })
                btn.MouseButton1Click:Connect(function()
                    SetState(not state)
                end)

                return {
                    Set = function(_, v) SetState(v) end,
                    Get = function() return state end,
                }
            end

