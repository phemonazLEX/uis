function KeySystem:_createButton(parent, text, size, position, primary)
	local colors = self.Config.Colors

	local button = create("TextButton", {
		Name = text:gsub("%s+", ""),
		AutoButtonColor = false,
		BackgroundColor3 = primary and colors.Accent or colors.GlassSecondary,
		BackgroundTransparency = primary and 0.05 or 0.15,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		Text = text,
		TextColor3 = colors.Text,
		TextSize = 12,
		Size = size,
		Position = position,
		ZIndex = 15,
		Parent = parent,
	})

	corner(button, 11)

	local buttonStroke = stroke(
		button,
		colors.Border,
		primary and 0.88 or 0.91,
		1
	)

	if primary then
		gradient(
			button,
			ColorSequence.new({
				ColorSequenceKeypoint.new(0, colors.Accent),
				ColorSequenceKeypoint.new(1, colors.AccentDark),
			}),
			90
		)
	end

	button:SetAttribute("BaseTransparency", button.BackgroundTransparency)
	button:SetAttribute("Primary", primary)

	local scale = create("UIScale", {
		Scale = 1,
		Parent = button,
	})

	self:_connect(button.MouseEnter:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end

		tween(
			scale,
			self.Config.AnimationSpeed,
			{Scale = 1.025}
		)

		tween(
			buttonStroke,
			self.Config.AnimationSpeed,
			{Transparency = primary and 0.72 or 0.8}
		)
	end))

	self:_connect(button.MouseLeave:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end

		tween(
			scale,
			self.Config.AnimationSpeed,
			{Scale = 1}
		)

		tween(
			buttonStroke,
			self.Config.AnimationSpeed,
			{Transparency = primary and 0.88 or 0.91}
		)
	end))

	self:_connect(button.MouseButton1Down:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end

		tween(
			scale,
			0.08,
			{Scale = 0.975},
			Enum.EasingStyle.Quad
		)
	end))

	self:_connect(button.MouseButton1Up:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end

		tween(
			scale,
			0.12,
			{Scale = 1.025},
			Enum.EasingStyle.Back
		)
	end))

	return button
end

function KeySystem:_connectInteractions()
	local colors = self.Config.Colors

	self:_connect(self.KeyInput:GetPropertyChangedSignal("Text"):Connect(function()
		self.ClearButton.Visible = self.KeyInput.Text ~= ""
	end))

	self:_connect(self.KeyInput.Focused:Connect(function()
		tween(
			self.InputStroke,
			self.Config.AnimationSpeed,
			{
				Transparency = 0.55,
				Color = colors.Accent,
			}
		)

		tween(
			self.InputContainer,
			self.Config.AnimationSpeed,
			{
				BackgroundTransparency = 0.02,
			}
		)

		tween(
			self.InputIcon,
			self.Config.AnimationSpeed,
			{
				TextColor3 = colors.Accent,
			}
		)
	end))

	self:_connect(self.KeyInput.FocusLost:Connect(function()
		tween(
			self.InputStroke,
			self.Config.AnimationSpeed,
			{
				Transparency = 0.92,
				Color = colors.Border,
			}
		)

		tween(
			self.InputContainer,
			self.Config.AnimationSpeed,
			{
				BackgroundTransparency = 0.08,
			}
		)

		tween(
			self.InputIcon,
			self.Config.AnimationSpeed,
			{
				TextColor3 = colors.Muted,
			}
		)
	end))

	self:_connect(self.ClearButton.MouseButton1Click:Connect(function()
		self.KeyInput.Text = ""
		self.KeyInput:CaptureFocus()
	end))

	self:_connect(self.CheckButton.MouseButton1Click:Connect(function()
		self:_checkKey()
	end))

	self:_connect(self.GetButton.MouseButton1Click:Connect(function()
		if self.OnGetKey then
			local success, err = pcall(self.OnGetKey)

			if not success then
				self:SetStatus("Unable to open key page.", "error")
			end
		end
	end))

	self:_connect(self.CopyButton.MouseButton1Click:Connect(function()
		if self.OnCopyLink then
			local success, err = pcall(self.OnCopyLink)

			if success then
				self:SetStatus("Key link copied.", "success")
			else
				self:SetStatus("Unable to copy key link.", "error")
			end
		end
	end))

	self:_connect(UserInputService.InputBegan:Connect(function(input, processed)
		if processed or self.Destroyed then
			return
		end

		if input.KeyCode == Enum.KeyCode.Return then
			if self.KeyInput:IsFocused() then
				self:_checkKey()
			end
		end
	end))

	self:_connect(self.Window.InputBegan:Connect(function(input)
		if self.Destroyed then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		self.Dragging = true
		self.DragStart = input.Position
		self.StartPosition = self.Window.Position

		local changed
		changed = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				self.Dragging = false

				if changed then
					changed:Disconnect()
				end
			end
		end)

		table.insert(self.Connections, changed)
	end))

	self:_connect(UserInputService.InputChanged:Connect(function(input)
		if not self.Dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - self.DragStart

		self.Window.Position = UDim2.new(
			self.StartPosition.X.Scale,
			self.StartPosition.X.Offset + delta.X,
			self.StartPosition.Y.Scale,
			self.StartPosition.Y.Offset + delta.Y
		)
	end))
end

function KeySystem:SetStatus(message, state)
	if self.Destroyed then
		return
	end

	local colors = self.Config.Colors

	local stateColors = {
		waiting = colors.Warning,
		loading = colors.Accent,
		success = colors.Success,
		error = colors.Error,
		warning = colors.Warning,
	}

	local stateColor = stateColors[state] or colors.Subtext

	self.StatusText.Text = message

	tween(
		self.StatusAccent,
		self.Config.AnimationSpeed,
		{
			BackgroundColor3 = stateColor,
		}
	)

	tween(
		self.StatusText,
		self.Config.AnimationSpeed,
		{
			TextColor3 = state == "success"
				and colors.Success
				or state == "error"
				and colors.Error
				or colors.Subtext,
		}
	)

	tween(
		self.StatusIndicator,
		self.Config.AnimationSpeed,
		{
			BackgroundColor3 = stateColor,
		}
	)

	self.StatusText.TextTransparency = 1

	tween(
		self.StatusText,
		0.16,
		{
			TextTransparency = 0,
		},
		Enum.EasingStyle.Quad
	)
end

function KeySystem:_setChecking(checking)
	self.Checking = checking

	self.CheckButton:SetAttribute("Disabled", checking)
	self.GetButton:SetAttribute("Disabled", checking)
	self.CopyButton:SetAttribute("Disabled", checking)

	self.CheckButton.Active = not checking
	self.GetButton.Active = not checking
	self.CopyButton.Active = not checking

	if checking then
		self.CheckButton.Text = "Checking..."
		self.CheckButton.TextTransparency = 0.15
	else
		self.CheckButton.Text = "Check Key"
		self.CheckButton.TextTransparency = 0
	end
end

function KeySystem:_checkKey()
	if self.Destroyed or self.Checking then
		return
	end

	local key = self.KeyInput.Text

	if key:gsub("%s+", "") == "" then
		self:SetStatus("Please enter a key first.", "warning")

		tween(
			self.InputContainer,
			0.08,
			{Position = UDim2.fromOffset(4, 24)}
		)

		tween(
			self.InputContainer,
			0.08,
			{Position = UDim2.fromOffset(-4, 24)}
		)

		tween(
			self.InputContainer,
			0.08,
			{Position = UDim2.fromOffset(2, 24)}
		)

		tween(
			self.InputContainer,
			0.08,
			{Position = UDim2.fromOffset(0, 24)}
		)

		return
	end

	if not self.Config.ValidateKey then
		self:SetStatus("No key validator has been configured.", "error")
		return
	end

	self:_setChecking(true)
	self:SetStatus("Checking key...", "loading")

	task.spawn(function()
		local success, result, message = pcall(
			self.Config.ValidateKey,
			key
		)

		if self.Destroyed then
			return
		end

		self:_setChecking(false)

		if not success then
			self:SetStatus("An error occurred while checking the key.", "error")
			return
		end

		if result == true then
			self:SetStatus(
				message or "Key is valid.",
				"success"
			)
		else
			self:SetStatus(
				message or "Invalid key.",
				"error"
			)
		end
	end)
end

function KeySystem:SetValidator(callback)
	assert(
		type(callback) == "function",
		"KeySystem:SetValidator expects a function"
	)

	self.Config.ValidateKey = callback
end

function KeySystem:SetGetKeyCallback(callback)
	assert(
		type(callback) == "function",
		"KeySystem:SetGetKeyCallback expects a function"
	)

	self.OnGetKey = callback
end

function KeySystem:SetCopyLinkCallback(callback)
	assert(
		type(callback) == "function",
		"KeySystem:SetCopyLinkCallback expects a function"
	)

	self.OnCopyLink = callback
end

function KeySystem:Open()
	if self.Destroyed or self.Visible then
		return
	end

	self.Visible = true

	self.Window.Position = UDim2.fromScale(0.5, 0.53)
	self.Window.Size = UDim2.fromOffset(
		self.Config.Width - 30,
		self.Config.Height - 30
	)

	self.Window.BackgroundTransparency = 1
	self.WindowStroke.Transparency = 1

	tween(
		self.Window,
		self.Config.EntranceSpeed,
		{
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(
				self.Config.Width,
				self.Config.Height
			),
			BackgroundTransparency = 0.08,
		},
		Enum.EasingStyle.Quint
	)

	tween(
		self.WindowStroke,
		self.Config.EntranceSpeed,
		{
			Transparency = 0.9,
		}
	)

	tween(
		self.GlowA,
		self.Config.EntranceSpeed,
		{
			BackgroundTransparency = 0.94,
		}
	)

	tween(
		self.GlowB,
		self.Config.EntranceSpeed,
		{
			BackgroundTransparency = 0.96,
		}
	)

	tween(
		self.GlassHighlight,
		self.Config.EntranceSpeed,
		{
			BackgroundTransparency = 0.975,
		}
	)
end

function KeySystem:Close()
	if self.Destroyed or not self.Visible then
		return
	end

	self.Visible = false

	tween(
		self.Window,
		self.Config.EntranceSpeed,
		{
			Position = UDim2.fromScale(0.5, 0.53),
			Size = UDim2.fromOffset(
				self.Config.Width - 30,
				self.Config.Height - 30
			),
			BackgroundTransparency = 1,
		},
		Enum.EasingStyle.Quint
	)

	tween(
		self.WindowStroke,
		self.Config.EntranceSpeed,
		{
			Transparency = 1,
		}
	)

	tween(
		self.GlowA,
		self.Config.EntranceSpeed,
		{
			BackgroundTransparency = 1,
		}
	)

	tween(
		self.GlowB,
		self.Config.EntranceSpeed,
		{
			BackgroundTransparency = 1,
		}
	)

	tween(
		self.GlassHighlight,
		self.Config.EntranceSpeed,
		{
			BackgroundTransparency = 1,
		}
	)
end

function KeySystem:Destroy()
	if self.Destroyed then
		return
	end

	self.Destroyed = true
	self.Checking = false
	self.Visible = false

	for _, connection in ipairs(self.Connections) do
		if connection and connection.Connected then
			connection:Disconnect()
		end
	end

	table.clear(self.Connections)

	if self.Gui then
		self.Gui:Destroy()
	end
end

return KeySystem
