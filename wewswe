        Create("UICorner", { Parent = TabBtn, CornerRadius = UDim.new(0, 6) })
        Create("UIPadding", {
            Parent = TabBtn,
            PaddingLeft = UDim.new(0, 10),
            PaddingRight = UDim.new(0, 10),
