--=====================================================================
-- 8. Library root
--=====================================================================

local Library = {}
Library.__index = Library

Library.Themes = Themes
Library.Windows = {}
Library.Flags = {}

function Library:_GetScreenGui()
	if self._screenGui and self._screenGui.Parent then
		return self._screenGui
	end

	local parent
	local player = Players.LocalPlayer
	if player then
		parent = player:FindFirstChildOfClass("PlayerGui")
	end
	if not parent then
		local ok, coreGui = pcall(function()
			return game:GetService("CoreGui")
		end)
		if ok then
			parent = coreGui
		end
	end

	local gui = Create("ScreenGui", {
		Name = "LuauUILibrary",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 100,
		Parent = parent,
	})
	self._screenGui = gui
	return gui
end

function Library:CreateWindow(config)
	local window = Window.new(self, config)
	table.insert(self.Windows, window)
	return window
end

function Library:SetTheme(theme)
	for _, window in ipairs(self.Windows) do
		window:SetTheme(theme)
	end
end

function Library:GetFlag(name)
	return self.Flags[name]
end

function Library:SetFlag(name, value)
	self.Flags[name] = value
end

function Library:GetFlags()
	return self.Flags
end

function Library:Destroy()
	for index = #self.Windows, 1, -1 do
		self.Windows[index]:Destroy()
	end
	self.Windows = {}
	if self._screenGui then
		self._screenGui:Destroy()
		self._screenGui = nil
	end
end

