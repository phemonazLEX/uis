		OffsetY = 4,
	})

	local scroll = Create("ScrollingFrame", {
		Name = "Options",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, SEARCH_HEIGHT),
		Size = UDim2.new(1, 0, 1, -SEARCH_HEIGHT),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.ScrollBar,
		ScrollBarImageTransparency = 0.3,
		Parent = popup.Frame,
	})
	Padding(scroll, PADDING, PADDING, PADDING, PADDING)
	List(scroll, { Padding = UDim.new(0, 2) })

	local searchBox = nil
	if searchable then
		searchBox = Create("TextBox", {
			Name = "Search",
			BackgroundColor3 = theme.Element,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(PADDING, PADDING),
			Size = UDim2.new(1, -PADDING * 2, 0, 24),
			Font = Enum.Font.Gotham,
			PlaceholderText = "Search...",
			PlaceholderColor3 = theme.SubText,
			Text = "",
			TextColor3 = theme.Text,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			Parent = popup.Frame,
		})
		Corner(searchBox, 6)
		Padding(searchBox, 0, 8, 0, 8)
	end

	-- Element state ---------------------------------------------------
	local element = {
		Type = "Dropdown",
		Row = row,
		Label = nameLabel,
		Button = button,
		Popup = popup,
		Options = options,
		Multi = multi,
		Callback = config.Callback,
		Flag = config.Flag,
		Window = window,
		Value = multi and {} or nil,
		Enabled = true,
		_optionRows = {},
		_maxHeight = MAX_HEIGHT,
	}

	-- Normalise default value
	if multi then
		local defaults = config.Default
		if type(defaults) ~= "table" then
			defaults = {}
			if config.Default ~= nil and config.Default ~= "" then
				defaults = { config.Default }
			end
		end
		for _, value in ipairs(defaults) do
			element.Value[tostring(value)] = true
		end
	else
		element.Value = config.Default ~= nil and tostring(config.Default) or nil
	end

	-- Value text ------------------------------------------------------
	local function updateValueText()
		if multi then
			local selected = {}
			for _, option in ipairs(options) do
				if element.Value[option] then
					table.insert(selected, option)
				end
			end
			valueLabel.Text = #selected > 0 and table.concat(selected, ", ") or "None"
			valueLabel.TextColor3 = #selected > 0 and theme.Text or theme.SubText
		else
			valueLabel.Text = element.Value or "None"
			valueLabel.TextColor3 = element.Value and theme.Text or theme.SubText
		end
	end

	-- Popup height ----------------------------------------------------
	local function refreshHeight()
		local visible = 0
		for _, item in ipairs(element._optionRows) do
			if item.Button.Visible then
				visible = visible + 1
			end
		end
		local contentHeight = math.max(visible * (ITEM_HEIGHT + 2) + PADDING * 2, ITEM_HEIGHT)
		element._popupHeight = math.min(contentHeight, MAX_HEIGHT) + SEARCH_HEIGHT
		popup.Height = element._popupHeight
	end

	-- Option rows -----------------------------------------------------
	local function createOptionRows()
		for _, item in ipairs(element._optionRows) do
			item.Button:Destroy()
		end
		element._optionRows = {}

		for index, option in ipairs(options) do
			local optionButton = Create("TextButton", {
				Name = option,
				BackgroundColor3 = theme.Popup,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, ITEM_HEIGHT),
				AutoButtonColor = false,
				Text = "",
				LayoutOrder = index,
				Parent = scroll,
			})
			Corner(optionButton, 6)
			Padding(optionButton, 0, 8, 0, 8)

			local optionLabel = Create("TextLabel", {
				Name = "Label",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -16, 1, 0),
				Font = Enum.Font.Gotham,
				Text = option,
				TextColor3 = theme.Text,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = optionButton,
			})

			local check = Create("TextLabel", {
				Name = "Check",
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(14, 14),
				Font = Enum.Font.GothamBold,
				Text = "✓",
				TextColor3 = theme.Accent,
				TextSize = 12,
				Visible = false,
				Parent = optionButton,
			})

			local record = {
				Button = optionButton,
				Label = optionLabel,
				Check = check,
				Option = option,
			}
			table.insert(element._optionRows, record)

			local function refreshOption()
				local selected
				if multi then
					selected = element.Value[option] == true
				else
					selected = element.Value == option
				end
				check.Visible = selected
				optionButton.BackgroundTransparency = selected and 0.85 or 1
				optionButton.BackgroundColor3 = selected and theme.Accent or theme.PopupHover
				optionLabel.TextColor3 = selected and theme.Accent or theme.Text
			end
			record.Refresh = refreshOption
			refreshOption()

			table.insert(window._connections, optionButton.MouseEnter:Connect(function()
				if not (multi and element.Value[option]) and element.Value ~= option then
					optionButton.BackgroundTransparency = 0
					optionButton.BackgroundColor3 = theme.PopupHover
				end
			end))
			table.insert(window._connections, optionButton.MouseLeave:Connect(function()
				refreshOption()
			end))

			table.insert(window._connections, optionButton.MouseButton1Click:Connect(function()
				if multi then
					element.Value[option] = not element.Value[option]
					if element.Value[option] == false then
						element.Value[option] = nil
					end
					for _, other in ipairs(element._optionRows) do
						other.Refresh()
					end
					updateValueText()
					if window.Library.Flags and element.Flag then
						local values = {}
						for _, option2 in ipairs(options) do
							if element.Value[option2] then
								table.insert(values, option2)
							end
						end
						window.Library.Flags[element.Flag] = values
					end
					RunCallback(element.Callback, element:GetValue())
				else
					element.Value = option
					for _, other in ipairs(element._optionRows) do
						other.Refresh()
					end
					updateValueText()
					if window.Library.Flags and element.Flag then
						window.Library.Flags[element.Flag] = option
					end
					RunCallback(element.Callback, option)
					popup:Hide()
				end
			end))
		end
	end

	createOptionRows()
	updateValueText()
	refreshHeight()

	-- Search ----------------------------------------------------------
	if searchBox then
		table.insert(window._connections, searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			local query = searchBox.Text:lower()
			for _, record in ipairs(element._optionRows) do
				local matches = query == "" or record.Option:lower():find(query, 1, true) ~= nil
				record.Button.Visible = matches
			end
			scroll.CanvasPosition = Vector2.new(0, 0)
			refreshHeight()
		end))
		table.insert(window._connections, searchBox.Focused:Connect(function()
			popup:Show()
		end))
	end

	-- Public API ------------------------------------------------------
	function element:GetValue()
		if multi then
			local values = {}
			for _, option in ipairs(options) do
				if self.Value[option] then
					table.insert(values, option)
				end
			end
			return values
		end
		return self.Value
	end

	function element:SetValue(value, fire)
		if multi then
			local map = {}
			if type(value) == "table" then
				for _, item in ipairs(value) do
					map[tostring(item)] = true
				end
			elseif value ~= nil then
				map[tostring(value)] = true
			end
			self.Value = map
		else
			self.Value = value ~= nil and tostring(value) or nil
		end
		for _, record in ipairs(self._optionRows) do
			record.Refresh()
		end
		updateValueText()
		if window.Library.Flags and self.Flag then
			window.Library.Flags[self.Flag] = self:GetValue()
		end
		if fire ~= false then
			RunCallback(self.Callback, self:GetValue())
		end
	end

	function element:SetOptions(newOptions)
		options = {}
		for index, option in ipairs(newOptions or {}) do
			options[index] = tostring(option)
		end
		self.Options = options
		if multi then
			self.Value = {}
		else
			self.Value = nil
		end
		createOptionRows()
		updateValueText()
		refreshHeight()
	end

	function element:SetName(name)
		nameLabel.Text = name
		row.Name = name
	end

	function element:SetEnabled(enabled)
		self.Enabled = enabled == true
		button.Active = self.Enabled
		nameLabel.TextTransparency = self.Enabled and 0 or 0.4
		button.BackgroundTransparency = self.Enabled and 0 or 0.4
		valueLabel.TextTransparency = self.Enabled and 0 or 0.4
		if not self.Enabled then
			popup:Hide()
		end
	end

	function element:SetVisible(visible)
		row.Visible = visible == true
		if not row.Visible then
			popup:Hide()
		end
	end

	function element:Destroy()
		popup:Destroy()
		row:Destroy()
	end

	-- Interaction -----------------------------------------------------
	table.insert(window._connections, button.MouseEnter:Connect(function()
		if element.Enabled then
			Tween(button, 0.12, { BackgroundColor3 = theme.ElementHover })
		end
	end))
	table.insert(window._connections, button.MouseLeave:Connect(function()
		Tween(button, 0.12, { BackgroundColor3 = theme.Element })
	end))
	table.insert(window._connections, button.MouseButton1Click:Connect(function()
		if not element.Enabled then
			return
		end
		if popup.Open then
			popup:Hide()
		else
			window:ClosePopups(popup)
			if searchBox then
				searchBox.Text = ""
			end
			popup.Height = element._popupHeight or 100
			popup:Show()
		end
	end))

	window:_RegisterThemeFunction(function(theme)
		nameLabel.TextColor3 = theme.Text
		button.BackgroundColor3 = theme.Element
		buttonStroke.Color = theme.Outline
		valueLabel.TextColor3 = element.Value ~= nil and theme.Text or theme.SubText
		chevron.TextColor3 = theme.SubText
		scroll.ScrollBarImageColor3 = theme.ScrollBar
		if searchBox then
			searchBox.BackgroundColor3 = theme.Element
			searchBox.TextColor3 = theme.Text
			searchBox.PlaceholderColor3 = theme.SubText
		end
		for _, record in ipairs(element._optionRows) do
			record.Label.TextColor3 = theme.Text
			record.Refresh()
		end
	end)

	if element.Flag and window.Library.Flags then
		window.Library.Flags[element.Flag] = element:GetValue()
	end

	return element
end

