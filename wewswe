function Section:AddKeybind(config)
	config = config or {}
	local window = self.Window
	local theme = window.Theme

	local row = self:_NewRow(30, false, config.Tooltip)

	local nameLabel = Create("TextLabel", {
		Name = "Name",
		BackgroundTransparency = 1,
		Size = UDim2.new(0.5, -6, 1, 0),
		Font = Enum.Font.Gotham,
		Text = config.Name or "Keybind",
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	local button = Create("TextButton", {
		Name = "Button",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(96, 26),
		BackgroundColor3 = theme.Element,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	})
	Corner(button, 6)
	local buttonStroke = Stroke(button, theme.Outline, 1, 0.6)

	local keyLabel = Create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamMedium,
		Text = "",
		TextColor3 = theme.Text,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = button,
	})

	local defaultKey = typeof(config.Default) == "EnumItem" and config.Default.EnumType == Enum.KeyCode and config.Default or Enum.KeyCode.RightShift

	local element = {
		Type = "Keybind",
		Row = row,
		Label = nameLabel,
		Button = button,
		Callback = config.Callback,
		Flag = config.Flag,
		Window = window,
		Value = defaultKey,
		Enabled = true,
		Listening = false,
		_listenConnection = nil,
	}

	local function refresh()
		keyLabel.Text = element.Listening and "..." or KeyDisplayName(element.Value)
		keyLabel.TextColor3 = element.Listening and theme.Accent or theme.Text
	end

	local function stopListening()
		element.Listening = false
		if element._listenConnection then
			element._listenConnection:Disconnect()
			element._listenConnection = nil
		end
		refresh()
	end

	local function startListening()
		if element.Listening then
			return
		end
		element.Listening = true
		refresh()
		window:ClosePopups()

		element._listenConnection = UserInputService.InputBegan:Connect(function(input, processed)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			if input.KeyCode == Enum.KeyCode.Escape then
				stopListening()
				return
			end
			element:SetValue(input.KeyCode)
			stopListening()
		end)
	end

	function element:SetValue(keyCode, fire)
		self.Value = keyCode
		refresh()
		if window.Library.Flags and self.Flag then
			window.Library.Flags[self.Flag] = keyCode
		end
		if fire ~= false then
			RunCallback(self.Callback, keyCode)
		end
	end

	function element:GetValue()
		return self.Value
	end

	function element:SetName(name)
		nameLabel.Text = name
		row.Name = name
	end

	function element:SetEnabled(enabled)
		self.Enabled = enabled == true
		button.Active = self.Enabled
		nameLabel.TextTransparency = self.Enabled and 0 or 0.4
		keyLabel.TextTransparency = self.Enabled and 0 or 0.4
	end

	function element:SetVisible(visible)
		row.Visible = visible == true
	end

	function element:Destroy()
		stopListening()
		row:Destroy()
	end

	refresh()

	table.insert(window._connections, button.MouseEnter:Connect(function()
		Tween(button, 0.12, { BackgroundColor3 = theme.ElementHover })
	end))
	table.insert(window._connections, button.MouseLeave:Connect(function()
		Tween(button, 0.12, { BackgroundColor3 = theme.Element })
	end))
	table.insert(window._connections, button.MouseButton1Click:Connect(function()
		if not element.Enabled then
			return
		end
		if element.Listening then
			stopListening()
		else
			startListening()
		end
	end))

	window:_RegisterThemeFunction(function(theme)
		nameLabel.TextColor3 = theme.Text
		button.BackgroundColor3 = theme.Element
		buttonStroke.Color = theme.Outline
		refresh()
	end)

	if element.Flag and window.Library.Flags then
		window.Library.Flags[element.Flag] = element.Value
	end

	return element
end

