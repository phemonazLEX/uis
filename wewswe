local function merge(base, custom)
	local result = {}

	for key, value in base do
		result[key] = value
	end

	if custom then
		for key, value in custom do
			result[key] = value
		end
	end

	return result
end

local function tween(instance, info, properties)
	return TweenService:Create(instance, info, properties)
end

