                    TextSize = 12,
                    AutoButtonColor = false,
                    ZIndex = 6,
                })
                Create("UICorner", { Parent = keyBtn, CornerRadius = UDim.new(0, 6) })

                local currentKey = default
                local listening = false

                local function SetKey(key)
                    currentKey = key
                    keyBtn.Text = key.Name
                    if flag then Library.Flags[flag] = key end
                    if isUIToggle then
                        Window:SetKeybind(key)
                    end
                end
                SetKey(default)

                keyBtn.MouseButton1Click:Connect(function()
                    if listening then return end
                    listening = true
                    keyBtn.Text = "..."
                    Tween(keyBtn, { BackgroundColor3 = Theme.Accent }, 0.12)

                    local conn
                    conn = UserInputService.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            SetKey(input.KeyCode)
                            listening = false
                            Tween(keyBtn, { BackgroundColor3 = Theme.Surface2 }, 0.12)
                            conn:Disconnect()
                        end
                    end)
                end)

                if not isUIToggle then
                    UserInputService.InputBegan:Connect(function(input, gpe)
                        if gpe or listening then return end
                        if input.KeyCode == currentKey then
                            task.spawn(callback)
                        end
                    end)
                end

                table.insert(Window.Elements, {
                    ApplyTheme = function(_, th)
                        label.TextColor3 = th.Text
                        if not listening then
                            keyBtn.BackgroundColor3 = th.Surface2
                        end
                        keyBtn.TextColor3 = th.Text
                    end
                })

                return { Set = function(_, k) SetKey(k) end, Get = function() return currentKey end }
            end

            -- DROPDOWN
            function Section:CreateDropdown(opt)
                opt = opt or {}
                local name = opt.Name or "Dropdown"
                local options = opt.Options or { "Option 1", "Option 2" }
                local default = opt.Default or options[1]
                local flag = opt.Flag
                local callback = opt.Callback or function() end

                local row = CreateRow(36)
                local label = Create("TextLabel", {
                    Parent = row, BackgroundTransparency = 1,
                    Position = UDim2.new(0, 2, 0, 0), Size = UDim2.new(0.4, 0, 1, 0),
                    Font = Enum.Font.Gotham, Text = name, TextColor3 = Theme.Text, TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 6,
                })

                local dropBtn = Create("TextButton", {
                    Parent = row, BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0,
                    Position = UDim2.new(0.42, 0, 0.5, -14), Size = UDim2.new(0.58, 0, 0, 28),
                    Font = Enum.Font.Gotham, Text = "  " .. tostring(default), TextColor3 = Theme.Text,
                    TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, ZIndex = 6,
                })
                Create("UICorner", { Parent = dropBtn, CornerRadius = UDim.new(0, 7) })
                local dropGradient = AddGradient(dropBtn, Theme.Surface2, Theme.Surface3, 0)

                local arrow = Create("TextLabel", {
                    Parent = dropBtn, BackgroundTransparency = 1, Position = UDim2.new(1, -25, 0, 0),
                    Size = UDim2.new(0, 22, 1, 0), Font = Enum.Font.GothamBold, Text = "⌄",
                    TextColor3 = Theme.TextDim, TextSize = 14, ZIndex = 7,
                })

                local selected = default
                if flag then Library.Flags[flag] = selected end
                local openFrame

                local function PositionDrop(frame)
                    if not frame.Parent or not dropBtn.Parent then return end
                    local pos, size = dropBtn.AbsolutePosition, dropBtn.AbsoluteSize
                    local camera = workspace.CurrentCamera
                    local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
                    local width = size.X
                    local height = frame.AbsoluteSize.Y
                    local x = math.clamp(pos.X, 6, math.max(6, viewport.X - width - 6))
                    local y = pos.Y + size.Y + 5
                    frame.Position = UDim2.fromOffset(x, y)
                end

                local function Open()
                    if openFrame and openFrame.Parent then
                        CloseAllDropdowns()
                        openFrame = nil
                        return
                    end
                    CloseAllDropdowns()
                    arrow.Text = "⌃"

                    local absSize = dropBtn.AbsoluteSize
                    local height = math.min(#options * 30 + 10, 190)
                    openFrame = Create("Frame", {
                        Parent = Overlay, BackgroundColor3 = Theme.Surface, BorderSizePixel = 0,
                        Size = UDim2.fromOffset(absSize.X, height), ZIndex = 50,
                    })
                    Create("UICorner", { Parent = openFrame, CornerRadius = UDim.new(0, 9) })
                    local stroke = Create("UIStroke", { Parent = openFrame, Color = Theme.Border, Thickness = 1 })
                    AddGradient(openFrame, Theme.Surface, Theme.Surface2, 135)

                    local scroll = Create("ScrollingFrame", {
                        Parent = openFrame, BackgroundTransparency = 1, BorderSizePixel = 0,
                        Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -8),
                        ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Accent,
                        CanvasSize = UDim2.fromOffset(0, #options * 30), ZIndex = 51,
                    })
                    Create("UIListLayout", { Parent = scroll, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) })

                    for i = 1, #options do
                        local optName = tostring(options[i])
                        local optBtn = Create("TextButton", {
                            Parent = scroll,
                            BackgroundColor3 = optName == tostring(selected) and Theme.Accent or Theme.Surface2,
                            BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 27),
                            Font = Enum.Font.Gotham, Text = "  " .. optName, TextColor3 = Theme.Text,
                            TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, ZIndex = 52,
                        })
                        Create("UICorner", { Parent = optBtn, CornerRadius = UDim.new(0, 6) })
                        optBtn.MouseEnter:Connect(function()
                            if optName ~= tostring(selected) then Tween(optBtn, { BackgroundColor3 = Theme.Surface3 }, 0.1) end
                        end)
                        optBtn.MouseLeave:Connect(function()
                            if optName ~= tostring(selected) then Tween(optBtn, { BackgroundColor3 = Theme.Surface2 }, 0.1) end
                        end)
                        optBtn.MouseButton1Click:Connect(function()
                            selected = options[i]
                            dropBtn.Text = "  " .. tostring(selected)
                            if flag then Library.Flags[flag] = selected end
                            task.spawn(callback, selected)
                            if openFrame then openFrame:Destroy() end
                            openFrame = nil
                        end)
                    end

                    TrackOverlay(openFrame, dropBtn, function() PositionDrop(openFrame) end, function(th)
                        openFrame.BackgroundColor3 = th.Surface
                        stroke.Color = th.Border
                        scroll.ScrollBarImageColor3 = th.Accent
                    end)
                    PositionDrop(openFrame)
                end

                dropBtn.MouseButton1Click:Connect(Open)

                table.insert(Window.Elements, {
                    ApplyTheme = function(_, th)
                        label.TextColor3 = th.Text
                        dropBtn.BackgroundColor3 = th.Surface2
                        dropGradient.Color = ColorSequence.new(th.Surface2, th.Surface3)
                        dropBtn.TextColor3 = th.Text
                        arrow.TextColor3 = th.TextDim
                    end
                })

                return {
                    Set = function(_, v)
                        selected = v
                        dropBtn.Text = "  " .. tostring(v)
                        if flag then Library.Flags[flag] = v end
                    end,
                    Get = function() return selected end,
                    Refresh = function(_, newOpts)
                        options = newOpts or {}
                        if flag and not table.find(options, selected) then selected = options[1] end
                        dropBtn.Text = "  " .. tostring(selected)
                    end,
                }
            end

            -- MULTI DROPDOWN
            function Section:CreateMultiDropdown(opt)
                opt = opt or {}
                local name = opt.Name or "Multi Dropdown"
                local options = opt.Options or { "Option 1", "Option 2", "Option 3" }
                local default = opt.Default or {}
                local flag = opt.Flag
                local callback = opt.Callback or function() end
                local selected = {}
                for i = 1, #default do selected[default[i]] = true end

                local row = CreateRow(36)
                local label = Create("TextLabel", {
                    Parent = row, BackgroundTransparency = 1, Position = UDim2.new(0, 2, 0, 0),
                    Size = UDim2.new(0.4, 0, 1, 0), Font = Enum.Font.Gotham, Text = name,
                    TextColor3 = Theme.Text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 6,
                })

                local function GetValues()
                    local values = {}
                    for i = 1, #options do
                        if selected[options[i]] then table.insert(values, options[i]) end
                    end
                    return values
                end
                local function GetDisplay()
                    local values = GetValues()
                    if #values == 0 then return "None" end
                    if #values <= 2 then return table.concat(values, ", ") end
                    return values[1] .. " +" .. (#values - 1)
                end

                local dropBtn = Create("TextButton", {
                    Parent = row, BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0,
                    Position = UDim2.new(0.42, 0, 0.5, -14), Size = UDim2.new(0.58, 0, 0, 28),
                    Font = Enum.Font.Gotham, Text = "  " .. GetDisplay(), TextColor3 = Theme.Text,
                    TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, ZIndex = 6,
                })
                Create("UICorner", { Parent = dropBtn, CornerRadius = UDim.new(0, 7) })
                local dropGradient = AddGradient(dropBtn, Theme.Surface2, Theme.Surface3, 0)
                local arrow = Create("TextLabel", {
                    Parent = dropBtn, BackgroundTransparency = 1, Position = UDim2.new(1, -25, 0, 0),
                    Size = UDim2.new(0, 22, 1, 0), Font = Enum.Font.GothamBold, Text = "⌄",
                    TextColor3 = Theme.TextDim, TextSize = 14, ZIndex = 7,
                })

                if flag then Library.Flags[flag] = GetValues() end
                local openFrame

                local function PositionDrop(frame)
                    if not frame.Parent or not dropBtn.Parent then return end
                    local pos, size = dropBtn.AbsolutePosition, dropBtn.AbsoluteSize
                    local camera = workspace.CurrentCamera
                    local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
                    local x = math.clamp(pos.X, 6, math.max(6, viewport.X - frame.AbsoluteSize.X - 6))
                    frame.Position = UDim2.fromOffset(x, pos.Y + size.Y + 5)
                end

                local function Open()
                    if openFrame and openFrame.Parent then
                        openFrame:Destroy(); openFrame = nil; return
                    end
                    CloseAllDropdowns()
                    arrow.Text = "⌃"
                    local absSize = dropBtn.AbsoluteSize
                    openFrame = Create("Frame", {
                        Parent = Overlay, BackgroundColor3 = Theme.Surface, BorderSizePixel = 0,
                        Size = UDim2.fromOffset(absSize.X, math.min(#options * 30 + 10, 190)), ZIndex = 50,
                    })
                    Create("UICorner", { Parent = openFrame, CornerRadius = UDim.new(0, 9) })
                    local stroke = Create("UIStroke", { Parent = openFrame, Color = Theme.Border, Thickness = 1 })
                    AddGradient(openFrame, Theme.Surface, Theme.Surface2, 135)
                    local scroll = Create("ScrollingFrame", {
                        Parent = openFrame, BackgroundTransparency = 1, BorderSizePixel = 0,
                        Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -8),
                        ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Accent,
                        CanvasSize = UDim2.fromOffset(0, #options * 30), ZIndex = 51,
                    })
                    Create("UIListLayout", { Parent = scroll, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) })

                    for i = 1, #options do
                        local optName = tostring(options[i])
                        local optBtn = Create("TextButton", {
                            Parent = scroll, BackgroundColor3 = selected[options[i]] and Theme.Accent or Theme.Surface2,
                            BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 27), Font = Enum.Font.Gotham,
                            Text = "  " .. optName, TextColor3 = Theme.Text, TextSize = 12,
                            TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, ZIndex = 52,
                        })
                        Create("UICorner", { Parent = optBtn, CornerRadius = UDim.new(0, 6) })
                        optBtn.MouseEnter:Connect(function()
                            if not selected[options[i]] then Tween(optBtn, { BackgroundColor3 = Theme.Surface3 }, 0.1) end
                        end)
                        optBtn.MouseLeave:Connect(function()
                            if not selected[options[i]] then Tween(optBtn, { BackgroundColor3 = Theme.Surface2 }, 0.1) end
                        end)
                        optBtn.MouseButton1Click:Connect(function()
                            selected[options[i]] = not selected[options[i]]
                            optBtn.BackgroundColor3 = selected[options[i]] and Theme.Accent or Theme.Surface2
                            dropBtn.Text = "  " .. GetDisplay()
                            local values = GetValues()
                            if flag then Library.Flags[flag] = values end
                            task.spawn(callback, values)
                        end)
                    end

                    TrackOverlay(openFrame, dropBtn, function() PositionDrop(openFrame) end, function(th)
                        openFrame.BackgroundColor3 = th.Surface
                        stroke.Color = th.Border
                        scroll.ScrollBarImageColor3 = th.Accent
                    end)
                    openFrame.Destroying:Connect(function() arrow.Text = "⌄" end)
                    PositionDrop(openFrame)
                end

                dropBtn.MouseButton1Click:Connect(Open)

                table.insert(Window.Elements, {
                    ApplyTheme = function(_, th)
                        label.TextColor3 = th.Text
                        dropBtn.BackgroundColor3 = th.Surface2
                        dropGradient.Color = ColorSequence.new(th.Surface2, th.Surface3)
                        dropBtn.TextColor3 = th.Text
                        arrow.TextColor3 = th.TextDim
                    end
                })

                return {
                    Set = function(_, vals)
                        selected = {}
                        for i = 1, #(vals or {}) do selected[vals[i]] = true end
                        dropBtn.Text = "  " .. GetDisplay()
                        if flag then Library.Flags[flag] = GetValues() end
                    end,
                    Get = GetValues,
                }
            end

            -- ADVANCED COLOR PICKER
            function Section:CreateColorPicker(opt)
                opt = opt or {}
                local name = opt.Name or "Color"
                local default = opt.Default or Theme.Accent
                local flag = opt.Flag
                local callback = opt.Callback or function() end
                local row = CreateRow(36)
                local label = Create("TextLabel", {
                    Parent = row, BackgroundTransparency = 1, Position = UDim2.new(0, 2, 0, 0),
                    Size = UDim2.new(1, -48, 1, 0), Font = Enum.Font.Gotham, Text = name,
                    TextColor3 = Theme.Text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 6,
                })
                local preview = Create("TextButton", {
                    Parent = row, BackgroundColor3 = default, BorderSizePixel = 0,
                    Position = UDim2.new(1, -38, 0.5, -13), Size = UDim2.new(0, 34, 0, 26),
                    Text = "", AutoButtonColor = false, ZIndex = 6,
                })
                Create("UICorner", { Parent = preview, CornerRadius = UDim.new(0, 7) })
                Create("UIStroke", { Parent = preview, Color = Theme.Border, Thickness = 1 })

                local currentColor = default
                local h, s, v = RGBtoHSV(default.R * 255, default.G * 255, default.B * 255)
                if flag then Library.Flags[flag] = currentColor end
                local picker

                local function OpenPicker()
                    if picker and picker.Parent then picker:Destroy(); picker = nil; return end
                    CloseAllDropdowns()
                    local width, height = 232, 264
                    picker = Create("Frame", {
                        Parent = Overlay, BackgroundColor3 = Theme.Surface, BorderSizePixel = 0,
                        Size = UDim2.fromOffset(width, height), ZIndex = 60,
                    })
                    Create("UICorner", { Parent = picker, CornerRadius = UDim.new(0, 11) })
                    local pickerStroke = Create("UIStroke", { Parent = picker, Color = Theme.Border, Thickness = 1 })
                    AddGradient(picker, Theme.Surface, Theme.Surface2, 135)

                    local svFrame = Create("Frame", {
                        Parent = picker, BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0,
                        Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(170, 150), ZIndex = 61,
                    })
                    Create("UICorner", { Parent = svFrame, CornerRadius = UDim.new(0, 7) })
                    local satGrad = Create("Frame", { Parent = svFrame, BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, Size = UDim2.fromScale(1,1), ZIndex = 62 })
                    Create("UIGradient", { Parent = satGrad, Color = ColorSequence.new(Color3.new(1,1,1), Color3.new(1,1,1)), Transparency = NumberSequence.new(0, 1) })
                    local valGrad = Create("Frame", { Parent = svFrame, BackgroundColor3 = Color3.new(0,0,0), BorderSizePixel = 0, Size = UDim2.fromScale(1,1), ZIndex = 63 })
                    Create("UIGradient", { Parent = valGrad, Rotation = 90, Transparency = NumberSequence.new(1, 0) })
                    Create("UICorner", { Parent = satGrad, CornerRadius = UDim.new(0, 7) })
                    Create("UICorner", { Parent = valGrad, CornerRadius = UDim.new(0, 7) })
                    local cursor = Create("Frame", { Parent = svFrame, BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, Position = UDim2.new(s, -6, 1-v, -6), Size = UDim2.fromOffset(12,12), ZIndex = 65 })
                    Create("UICorner", { Parent = cursor, CornerRadius = UDim.new(1,0) })
                    Create("UIStroke", { Parent = cursor, Color = Color3.new(0,0,0), Thickness = 2 })

                    local hueFrame = Create("Frame", {
                        Parent = picker, BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0,
                        Position = UDim2.fromOffset(190, 12), Size = UDim2.fromOffset(30, 150), ZIndex = 61,
                    })
                    Create("UICorner", { Parent = hueFrame, CornerRadius = UDim.new(0, 7) })
                    Create("UIGradient", { Parent = hueFrame, Rotation = 90, Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)), ColorSequenceKeypoint.new(.17, Color3.fromRGB(255,255,0)),
                        ColorSequenceKeypoint.new(.33, Color3.fromRGB(0,255,0)), ColorSequenceKeypoint.new(.50, Color3.fromRGB(0,255,255)),
                        ColorSequenceKeypoint.new(.67, Color3.fromRGB(0,0,255)), ColorSequenceKeypoint.new(.83, Color3.fromRGB(255,0,255)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)),
                    }) })
                    local hueCursor = Create("Frame", { Parent = hueFrame, BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, Position = UDim2.new(0,-2,h,-4), Size = UDim2.new(1,4,0,8), ZIndex = 62 })
                    Create("UICorner", { Parent = hueCursor, CornerRadius = UDim.new(0, 3) })
                    Create("UIStroke", { Parent = hueCursor, Color = Color3.new(0,0,0), Thickness = 1 })

                    local previewBig = Create("Frame", { Parent = picker, BackgroundColor3 = currentColor, BorderSizePixel = 0, Position = UDim2.fromOffset(12,174), Size = UDim2.fromOffset(44,30), ZIndex = 61 })
                    Create("UICorner", { Parent = previewBig, CornerRadius = UDim.new(0,7) })
                    Create("UIStroke", { Parent = previewBig, Color = Theme.Border, Thickness = 1 })
                    local hexBox = Create("TextBox", {
                        Parent = picker, BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0, Position = UDim2.fromOffset(64,174),
                        Size = UDim2.fromOffset(156,30), Font = Enum.Font.GothamMedium,
                        Text = string.format("%02X%02X%02X", currentColor.R*255, currentColor.G*255, currentColor.B*255),
                        TextColor3 = Theme.Text, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center,
                        ClearTextOnFocus = false, ZIndex = 61,
                    })
                    Create("UICorner", { Parent = hexBox, CornerRadius = UDim.new(0,7) })
                    local done = Create("TextButton", {
                        Parent = picker, BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Position = UDim2.fromOffset(12,216),
                        Size = UDim2.fromOffset(208,34), Font = Enum.Font.GothamBold, Text = "Done", TextColor3 = Color3.new(1,1,1),
                        TextSize = 12, AutoButtonColor = false, ZIndex = 61,
                    })
                    Create("UICorner", { Parent = done, CornerRadius = UDim.new(0,7) })

                    local function ApplyColor()
                        currentColor = HSVtoRGB(h, s, v)
                        preview.BackgroundColor3 = currentColor
                        previewBig.BackgroundColor3 = currentColor
                        svFrame.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                        cursor.Position = UDim2.new(s, -6, 1-v, -6)
                        hueCursor.Position = UDim2.new(0, -2, h, -4)
                        hexBox.Text = string.format("%02X%02X%02X", math.floor(currentColor.R*255), math.floor(currentColor.G*255), math.floor(currentColor.B*255))
                        if flag then Library.Flags[flag] = currentColor end
                        task.spawn(callback, currentColor)
                    end

                    local function SetSV(x, y)
                        s = math.clamp((x - svFrame.AbsolutePosition.X) / svFrame.AbsoluteSize.X, 0, 1)
                        v = 1 - math.clamp((y - svFrame.AbsolutePosition.Y) / svFrame.AbsoluteSize.Y, 0, 1)
                        ApplyColor()
                    end
                    local function SetHue(y)
                        h = math.clamp((y - hueFrame.AbsolutePosition.Y) / hueFrame.AbsoluteSize.Y, 0, 1)
                        ApplyColor()
                    end
                    local svDragging, hueDragging = false, false
                    svFrame.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then svDragging = true; SetSV(input.Position.X, input.Position.Y) end
                    end)
                    hueFrame.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDragging = true; SetHue(input.Position.Y) end
                    end)
                    UserInputService.InputChanged:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseMovement then
                            if svDragging then SetSV(input.Position.X, input.Position.Y) end
                            if hueDragging then SetHue(input.Position.Y) end
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then svDragging = false; hueDragging = false end
                    end)
                    hexBox.FocusLost:Connect(function()
                        local text = hexBox.Text:gsub("#", "")
                        if #text == 6 then
                            local r, g, b = tonumber(text:sub(1,2),16), tonumber(text:sub(3,4),16), tonumber(text:sub(5,6),16)
                            if r and g and b then h,s,v = RGBtoHSV(r,g,b); ApplyColor() end
                        end
                    end)
                    done.MouseButton1Click:Connect(function() picker:Destroy(); picker = nil end)

                    local function PositionPicker()
                        if not picker.Parent then return end
                        local pos, size = preview.AbsolutePosition, preview.AbsoluteSize
                        local camera = workspace.CurrentCamera
                        local viewport = camera and camera.ViewportSize or Vector2.new(1920,1080)
                        local x = math.clamp(pos.X + size.X - picker.AbsoluteSize.X, 6, math.max(6, viewport.X - picker.AbsoluteSize.X - 6))
                        local y = pos.Y + size.Y + 6
                        picker.Position = UDim2.fromOffset(x, y)
                    end
                    TrackOverlay(picker, preview, PositionPicker, function(th)
                        picker.BackgroundColor3 = th.Surface
                        pickerStroke.Color = th.Border
                        hexBox.BackgroundColor3 = th.Surface2
                        hexBox.TextColor3 = th.Text
                        done.BackgroundColor3 = th.Accent
                    end)
                    PositionPicker()
                end

                preview.MouseButton1Click:Connect(OpenPicker)
                table.insert(Window.Elements, {
                    ApplyTheme = function(_, th)
                        label.TextColor3 = th.Text
                        local stroke = preview:FindFirstChildOfClass("UIStroke")
                        if stroke then stroke.Color = th.Border end
                    end
                })
                return {
                    Set = function(_, c)
                        currentColor = c
                        h,s,v = RGBtoHSV(c.R*255,c.G*255,c.B*255)
                        preview.BackgroundColor3 = c
                        if flag then Library.Flags[flag] = c end
                    end,
                    Get = function() return currentColor end,
                }
            end

            return Section
        end

        return Tab
    end

    -- Notification
    function Window:Notify(opt)
        opt = opt or {}
        local title = opt.Title or "Notification"
        local content = opt.Content or ""
        local duration = opt.Duration or 3
        local notifType = opt.Type or "Info"

        local accentColor = Theme.Accent
        if notifType == "Success" then accentColor = Theme.Success
        elseif notifType == "Warning" then accentColor = Theme.Warning
        elseif notifType == "Error" then accentColor = Theme.Danger end

        local notif = Create("Frame", {
            Parent = ScreenGui,
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel = 0,
            Position = UDim2.new(1, 20, 1, -90),
            Size = UDim2.new(0, 280, 0, 72),
            ZIndex = 100,
        })
        Create("UICorner", { Parent = notif, CornerRadius = UDim.new(0, 10) })
        Create("UIStroke", { Parent = notif, Color = Theme.Border, Thickness = 1 })

        local bar = Create("Frame", {
            Parent = notif,
            BackgroundColor3 = accentColor,
            BorderSizePixel = 0,
            Size = UDim2.new(0, 4, 1, 0),
            ZIndex = 101,
        })
        Create("UICorner", { Parent = bar, CornerRadius = UDim.new(0, 10) })

        Create("TextLabel", {
            Parent = notif,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 16, 0, 10),
            Size = UDim2.new(1, -28, 0, 18),
            Font = Enum.Font.GothamBold,
            Text = title,
            TextColor3 = Theme.Text,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 101,
        })
        Create("TextLabel", {
            Parent = notif,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 16, 0, 30),
            Size = UDim2.new(1, -28, 0, 32),
            Font = Enum.Font.Gotham,
            Text = content,
            TextColor3 = Theme.TextDim,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            ZIndex = 101,
        })

        Tween(notif, { Position = UDim2.new(1, -300, 1, -90) }, 0.35, Enum.EasingStyle.Back)
        task.delay(duration, function()
            Tween(notif, { Position = UDim2.new(1, 20, 1, -90) }, 0.25)
            task.wait(0.25)
            notif:Destroy()
        end)
    end

    table.insert(Library.Windows, Window)
    return Window
end

function Library:Destroy()
    for _, win in ipairs(Library.Windows) do
        if win.ScreenGui then
            win.ScreenGui:Destroy()
        end
    end
    Library.Windows = {}
end

return Library
