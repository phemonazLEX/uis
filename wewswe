-- ─── Notification Queue ──────────────────────────────────────────────────────
local NotificationManager = {}
NotificationManager.__index = NotificationManager

function NotificationManager.new(screenGui, theme)
	local self = setmetatable({}, NotificationManager)
	self.ScreenGui    = screenGui
	self.Theme        = theme
	self.Notifications = {}

	self.Container = Instance.new("Frame")
	self.Container.Name                 = "NotificationContainer"
	self.Container.BackgroundTransparency = 1
	self.Container.Size                 = UDim2.new(0, 300, 1, 0)
	self.Container.Position             = UDim2.new(1, -310, 0, 0)
	self.Container.AnchorPoint          = Vector2.new(0, 0)
	self.Container.ZIndex               = 200
	self.Container.Parent               = screenGui

	ListLayout(self.Container, Enum.FillDirection.Vertical,
		Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom, 8)
	Padding(self.Container, 0, 0, 12, 0)

	return self
end

function NotificationManager:Notify(options)
	local t     = self.Theme
	local title = options.Title   or "Notification"
	local text  = options.Text    or ""
	local ntype = options.Type    or "Info"   -- Info | Success | Warning | Error
	local dur   = options.Duration or 4

	local accentColor = t.Accent
	if ntype == "Success" then accentColor = t.Success
	elseif ntype == "Warning" then accentColor = t.Warning
	elseif ntype == "Error"   then accentColor = t.Error end

	local card = Instance.new("Frame")
	card.Name                  = "Notification"
	card.BackgroundColor3      = t.PopupBg
	card.Size                  = UDim2.new(1, 0, 0, 70)
	card.BackgroundTransparency = 0.05
	card.ClipsDescendants      = true
	card.LayoutOrder            = tick()
	card.ZIndex                = 201
	card.Parent                = self.Container
	Round(card, 8)
	Stroke(card, t.PopupBorder, 1)

	-- Accent bar
	local bar = Instance.new("Frame")
	bar.Name             = "AccentBar"
	bar.BackgroundColor3 = accentColor
	bar.Size             = UDim2.new(0, 3, 1, 0)
	bar.Position         = UDim2.new(0, 0, 0, 0)
	bar.ZIndex           = 202
	bar.Parent           = card
	Round(bar, 2)

	local content = Instance.new("Frame")
	MakeClear(content)
	content.Size     = UDim2.new(1, -16, 1, 0)
	content.Position = UDim2.new(0, 12, 0, 0)
	content.ZIndex   = 202
	content.Parent   = card
	ListLayout(content, Enum.FillDirection.Vertical,
		Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center, 3)
	Padding(content, 8, 0, 8, 0)

	local titleLabel = Instance.new("TextLabel")
	MakeClear(titleLabel)
	titleLabel.Text          = title
	titleLabel.TextColor3    = t.Text
	titleLabel.Font          = Enum.Font.GothamBold
	titleLabel.TextSize      = 13
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Size          = UDim2.new(1, 0, 0, 18)
	titleLabel.ZIndex        = 202
	titleLabel.Parent        = content

	local textLabel = Instance.new("TextLabel")
	MakeClear(textLabel)
	textLabel.Text          = text
	textLabel.TextColor3    = t.TextDim
	textLabel.Font          = Enum.Font.Gotham
	textLabel.TextSize      = 11
	textLabel.TextXAlignment = Enum.TextXAlignment.Left
	textLabel.TextWrapped   = true
	textLabel.Size          = UDim2.new(1, 0, 0, 32)
	textLabel.ZIndex        = 202
	textLabel.Parent        = content

	-- Progress bar
	local progBg = Instance.new("Frame")
	progBg.BackgroundColor3 = t.Border
	progBg.Size             = UDim2.new(1, 0, 0, 2)
	progBg.Position         = UDim2.new(0, 0, 1, -2)
	progBg.ZIndex           = 203
	progBg.Parent           = card

	local prog = Instance.new("Frame")
	prog.BackgroundColor3 = accentColor
	prog.Size             = UDim2.new(1, 0, 1, 0)
	prog.ZIndex           = 204
	prog.Parent           = progBg

	-- Animate in
	card.Position = UDim2.new(1, 10, 0, 0)
	Tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.25)

	-- Progress shrink
	Tween(prog, { Size = UDim2.new(0, 0, 1, 0) }, dur, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)

	-- Auto dismiss
	task.delay(dur, function()
		Tween(card, { Position = UDim2.new(1, 10, 0, 0) }, 0.2)
		task.wait(0.22)
		card:Destroy()
	end)

	return card
end

-- ─── Library Core ─────────────────────────────────────────────────────────
function NexusUI:CreateWindow(config)
	config = config or {}

	local title      = config.Title     or "NexusUI"
	local subtitle   = config.Subtitle  or ""
	local toggleKey  = config.ToggleKey or Enum.KeyCode.RightShift
	local size       = config.Size      or UDim2.fromOffset(700, 500)
	local themeName  = config.Theme     or "Dark"

	local theme = Themes[themeName] or Themes.Dark

	-- Root ScreenGui
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name                  = "NexusUI_" .. title
	ScreenGui.ResetOnSpawn          = false
	ScreenGui.ZIndexBehavior        = Enum.ZIndexBehavior.Sibling
	ScreenGui.IgnoreGuiInset        = true
	ScreenGui.DisplayOrder          = 100
	ScreenGui.Parent                = PlayerGui

	-- Shadow frame (behind window)
	local Shadow = Instance.new("Frame")
	Shadow.Name                  = "Shadow"
	Shadow.BackgroundColor3      = theme.Shadow
	Shadow.BackgroundTransparency = 0.7
	Shadow.Size                  = UDim2.new(0, size.X.Offset + 20, 0, size.Y.Offset + 20)
	Shadow.Position              = UDim2.new(0.5, -(size.X.Offset/2) - 10, 0.5, -(size.Y.Offset/2) - 10)
	Shadow.ZIndex                = 1
	Shadow.Parent                = ScreenGui
	Round(Shadow, 14)

	-- Main Window
	local Win = Instance.new("Frame")
	Win.Name                  = "Window"
	Win.BackgroundColor3      = theme.WindowBg
	Win.Size                  = size
	Win.Position              = UDim2.new(0.5, -size.X.Offset/2, 0.5, -size.Y.Offset/2)
	Win.ClipsDescendants      = false
	Win.ZIndex                = 2
	Win.Parent                = ScreenGui
	Round(Win, 10)
	Stroke(Win, theme.Border, 1)

	-- Window gradient overlay
	local winGrad = Instance.new("Frame")
	MakeClear(winGrad)
	winGrad.Size   = UDim2.new(1, 0, 1, 0)
	winGrad.ZIndex = 2
	winGrad.Parent = Win
	Gradient(winGrad,
		ColorSequence.new({
			ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(1,   Color3.fromRGB(200, 200, 255)),
		}),
		135
	)
	winGrad.BackgroundTransparency = 1

	-- ─── Header ──────────────────────────────────────────────────────────────
	local Header = Instance.new("Frame")
	Header.Name             = "Header"
	Header.BackgroundColor3 = theme.HeaderBg
	Header.Size             = UDim2.new(1, 0, 0, 52)
	Header.Position         = UDim2.new(0, 0, 0, 0)
	Header.ZIndex           = 3
	Header.ClipsDescendants = true
	Header.Parent           = Win
	Round(Header, 10)

	-- Header bottom square-off patch
	local HeaderPatch = Instance.new("Frame")
	HeaderPatch.BackgroundColor3 = theme.HeaderBg
	HeaderPatch.Size             = UDim2.new(1, 0, 0, 10)
	HeaderPatch.Position         = UDim2.new(0, 0, 1, -10)
	HeaderPatch.ZIndex           = 3
	HeaderPatch.Parent           = Header

	-- Subtle header gradient
	local headerGrad = Instance.new("Frame")
	headerGrad.BackgroundColor3      = theme.Accent
	headerGrad.BackgroundTransparency = 0.92
	headerGrad.Size                  = UDim2.new(1, 0, 1, 0)
	headerGrad.ZIndex                = 3
	headerGrad.Parent                = Header

	local TitleBlock = Instance.new("Frame")
	MakeClear(TitleBlock)
	TitleBlock.Size     = UDim2.new(0, 200, 1, 0)
	TitleBlock.Position = UDim2.new(0, 14, 0, 0)
	TitleBlock.ZIndex   = 4
	TitleBlock.Parent   = Header
	ListLayout(TitleBlock, Enum.FillDirection.Vertical,
		Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center, 2)

	local TitleLabel = Instance.new("TextLabel")
	MakeClear(TitleLabel)
	TitleLabel.Text          = title
	TitleLabel.TextColor3    = theme.Text
	TitleLabel.Font          = Enum.Font.GothamBold
	TitleLabel.TextSize      = 14
	TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
	TitleLabel.Size          = UDim2.new(1, 0, 0, 18)
	TitleLabel.ZIndex        = 4
	TitleLabel.Parent        = TitleBlock

	if subtitle ~= "" then
		local SubLabel = Instance.new("TextLabel")
		MakeClear(SubLabel)
		SubLabel.Text          = subtitle
		SubLabel.TextColor3    = theme.TextDim
		SubLabel.Font          = Enum.Font.Gotham
		SubLabel.TextSize      = 11
		SubLabel.TextXAlignment = Enum.TextXAlignment.Left
		SubLabel.Size          = UDim2.new(1, 0, 0, 14)
		SubLabel.ZIndex        = 4
		SubLabel.Parent        = TitleBlock
	end

	-- Close button
	local CloseBtn = Instance.new("TextButton")
	CloseBtn.Name             = "Close"
	CloseBtn.Text             = "×"
	CloseBtn.Font             = Enum.Font.GothamBold
	CloseBtn.TextSize         = 20
	CloseBtn.TextColor3       = theme.TextDim
	CloseBtn.BackgroundColor3 = theme.ElementBg
	CloseBtn.Size             = UDim2.new(0, 26, 0, 26)
	CloseBtn.Position         = UDim2.new(1, -36, 0.5, -13)
	CloseBtn.ZIndex           = 5
	CloseBtn.Parent           = Header
	Round(CloseBtn, 6)

	CloseBtn.MouseEnter:Connect(function()
		Tween(CloseBtn, { BackgroundColor3 = theme.Error, TextColor3 = theme.Text }, 0.12)
	end)
	CloseBtn.MouseLeave:Connect(function()
		Tween(CloseBtn, { BackgroundColor3 = theme.ElementBg, TextColor3 = theme.TextDim }, 0.12)
	end)

	-- Minimize button
	local MinBtn = Instance.new("TextButton")
	MinBtn.Name             = "Minimize"
	MinBtn.Text             = "−"
	MinBtn.Font             = Enum.Font.GothamBold
	MinBtn.TextSize         = 18
	MinBtn.TextColor3       = theme.TextDim
	MinBtn.BackgroundColor3 = theme.ElementBg
	MinBtn.Size             = UDim2.new(0, 26, 0, 26)
	MinBtn.Position         = UDim2.new(1, -68, 0.5, -13)
	MinBtn.ZIndex           = 5
	MinBtn.Parent           = Header
	Round(MinBtn, 6)

	MinBtn.MouseEnter:Connect(function()
		Tween(MinBtn, { BackgroundColor3 = theme.Warning, TextColor3 = theme.Text }, 0.12)
	end)
	MinBtn.MouseLeave:Connect(function()
		Tween(MinBtn, { BackgroundColor3 = theme.ElementBg, TextColor3 = theme.TextDim }, 0.12)
	end)

	-- ─── Tab Bar (inside header, right of title) ─────────────────────────────
	local TabBar = Instance.new("ScrollingFrame")
	TabBar.Name                    = "TabBar"
	TabBar.BackgroundTransparency  = 1
	TabBar.Size                    = UDim2.new(1, -230, 1, -8)
	TabBar.Position                = UDim2.new(0, 190, 0, 4)
	TabBar.CanvasSize              = UDim2.new(0, 0, 0, 0)
	TabBar.ScrollBarThickness      = 0
	TabBar.ScrollingDirection      = Enum.ScrollingDirection.X
	TabBar.ZIndex                  = 4
	TabBar.ClipsDescendants        = true
	TabBar.Parent                  = Header
	ListLayout(TabBar, Enum.FillDirection.Horizontal,
		Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center, 4)
	Padding(TabBar, 4, 4, 4, 4)

	-- ─── Content Area ─────────────────────────────────────────────────────────
	local ContentArea = Instance.new("Frame")
	ContentArea.Name             = "ContentArea"
	ContentArea.BackgroundColor3 = theme.WindowBg
	ContentArea.Size             = UDim2.new(1, 0, 1, -52)
	ContentArea.Position         = UDim2.new(0, 0, 0, 52)
	ContentArea.ZIndex           = 2
	ContentArea.ClipsDescendants = true
	ContentArea.Parent           = Win

	-- ─── Dragging Logic ───────────────────────────────────────────────────────
	local dragging    = false
	local dragStart   = Vector2.new()
	local startPos    = UDim2.new()
	local connections = {}

	Header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging  = true
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos  = Win.Position
		end
	end)

	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			Win.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
			-- Shadow follows
			Shadow.Position = UDim2.new(
				Win.Position.X.Scale,
				Win.Position.X.Offset - 10,
				Win.Position.Y.Scale,
				Win.Position.Y.Offset - 10
			)
		end
	end))

	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end))

	-- ─── Toggle key ────────────────────────────────────────────────────────
	local visible = true
	table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			visible = not visible
			if visible then
				Win.Visible    = true
				Shadow.Visible = true
				Tween(Win,    { Position = Win.Position }, 0.001)
			else
				Tween(Win, { Size = UDim2.fromOffset(size.X.Offset, size.Y.Offset) }, 0.001)
				Win.Visible    = false
				Shadow.Visible = false
			end
		end
	end))

	CloseBtn.MouseButton1Click:Connect(function()
		visible = false
		Tween(Win, { BackgroundTransparency = 1 }, 0.15)
		task.wait(0.16)
		Win.Visible    = false
		Shadow.Visible = false
		Win.BackgroundTransparency = 0
	end)

	local minimized = false
	MinBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		if minimized then
			Tween(Win, { Size = UDim2.new(0, size.X.Offset, 0, 52) }, 0.22)
		else
			Tween(Win, { Size = size }, 0.22)
		end
	end)

	-- ─── Notification manager ────────────────────────────────────────────────
	local notifMgr = NotificationManager.new(ScreenGui, theme)

	-- ─── Window Object ───────────────────────────────────────────────────────
	local WindowObj = {
		_theme       = theme,
		_screenGui   = ScreenGui,
		_win         = Win,
		_contentArea = ContentArea,
		_tabBar      = TabBar,
		_tabs        = {},
		_activeTab   = nil,
		_connections = connections,
		_notifMgr    = notifMgr,
	}

	-- ─── AddTab ──────────────────────────────────────────────────────────────
	function WindowObj:AddTab(tabConfig)
		tabConfig = tabConfig or {}
		local tabName = tabConfig.Name or ("Tab " .. (#self._tabs + 1))
		local t       = self._theme

		-- Tab button
		local TabBtn = Instance.new("TextButton")
		TabBtn.Name             = "Tab_" .. tabName
		TabBtn.Text             = tabName
		TabBtn.Font             = Enum.Font.GothamSemibold
		TabBtn.TextSize         = 12
		TabBtn.TextColor3       = t.TextDim
		TabBtn.BackgroundColor3 = t.TabBg
		TabBtn.AutomaticSize    = Enum.AutomaticSize.X
		TabBtn.Size             = UDim2.new(0, 0, 1, 0)
		TabBtn.ZIndex           = 5
		TabBtn.Parent           = self._tabBar
		Round(TabBtn, 6)
		Padding(TabBtn, 0, 12, 0, 12)

		-- Active indicator
		local Indicator = Instance.new("Frame")
		Indicator.Name             = "Indicator"
		Indicator.BackgroundColor3 = t.Accent
		Indicator.Size             = UDim2.new(0.7, 0, 0, 2)
		Indicator.Position         = UDim2.new(0.15, 0, 1, -3)
		Indicator.BackgroundTransparency = 1
		Indicator.ZIndex           = 6
		Indicator.Parent           = TabBtn
		Round(Indicator, 1)

		-- Tab page
		local Page = Instance.new("ScrollingFrame")
		Page.Name                   = "Page_" .. tabName
		Page.BackgroundTransparency = 1
		Page.Size                   = UDim2.new(1, 0, 1, 0)
		Page.CanvasSize             = UDim2.new(0, 0, 0, 0)
		Page.AutomaticCanvasSize    = Enum.AutomaticSize.Y
		Page.ScrollBarThickness     = 4
		Page.ScrollBarImageColor3   = t.ScrollBar
		Page.ScrollingDirection     = Enum.ScrollingDirection.Y
		Page.Visible                = false
		Page.ZIndex                 = 3
		Page.Parent                 = self._contentArea
		ListLayout(Page, Enum.FillDirection.Vertical,
			Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top, 8)
		Padding(Page, 12, 12, 12, 12)

		-- Tab canvas auto-resize
		local pagePadding = Page:FindFirstChildOfClass("UIPadding")
		local pageLayout  = Page:FindFirstChildOfClass("UIListLayout")
		pageLayout.Changed:Connect(function()
			Page.CanvasSize = UDim2.new(0, 0, 0,
				pageLayout.AbsoluteContentSize.Y +
				(pagePadding and (pagePadding.PaddingTop.Offset + pagePadding.PaddingBottom.Offset) or 24)
			)
		end)

		-- TabBar auto-resize
		local barLayout = self._tabBar:FindFirstChildOfClass("UIListLayout")
		barLayout.Changed:Connect(function()
			self._tabBar.CanvasSize = UDim2.new(0,
				barLayout.AbsoluteContentSize.X + 8, 0, 0)
		end)

		local TabObj = {
			_name      = tabName,
			_btn       = TabBtn,
			_indicator = Indicator,
			_page      = Page,
			_theme     = t,
			_screenGui = self._screenGui,
			_win       = self._win,
			_sections  = {},
		}

		TabBtn.MouseButton1Click:Connect(function()
			WindowObj:_selectTab(TabObj)
		end)

		TabBtn.MouseEnter:Connect(function()
			if WindowObj._activeTab ~= TabObj then
				Tween(TabBtn, { BackgroundColor3 = t.TabActive, TextColor3 = t.Text }, 0.12)
			end
		end)
		TabBtn.MouseLeave:Connect(function()
			if WindowObj._activeTab ~= TabObj then
				Tween(TabBtn, { BackgroundColor3 = t.TabBg, TextColor3 = t.TextDim }, 0.12)
			end
		end)

		table.insert(self._tabs, TabObj)

		-- Auto-select first tab
		if #self._tabs == 1 then
			self:_selectTab(TabObj)
		end

		-- ─── AddSection ───────────────────────────────────────────────────────
