            ----------------------------------------------------------------
            -- DROPDOWN (Single + Multi)
            ----------------------------------------------------------------
            function Section:AddDropdown(opt)
                opt = opt or {}
                local Name = opt.Name or "Dropdown"
                local Options = opt.Options or {}
                local Default = opt.Default
                local Multi = opt.Multi or false
                local Callback = opt.Callback or function() end
                local Searchable = opt.Searchable or false

                local Selected = {}
                if Multi then
                    if type(Default) == "table" then
                        for _, v in ipairs(Default) do
                            Selected[v] = true
                        end
                    end
                else
                    if Default then
                        Selected[Default] = true
                    elseif #Options > 0 then
                        Selected[Options[1]] = true
                    end
                end

                local Element = Create("Frame", {
                    Name = Name,
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 36),
                    ZIndex = 4,
                    Parent = SectionFrame
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Element})

                local NameLabel = Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0.4, 0, 1, 0),
                    Position = UDim2.fromOffset(12, 0),
                    Font = Enum.Font.Gotham,
                    Text = Name,
                    TextColor3 = Theme.Text,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 5,
                    Parent = Element
                })

                local DisplayBtn = Create("TextButton", {
                    Name = "Display",
                    BackgroundColor3 = Theme.BackgroundSecondary,
                    Size = UDim2.new(0.55, -16, 0, 26),
                    Position = UDim2.new(0.45, 0, 0.5, -13),
                    Font = Enum.Font.Gotham,
                    Text = "",
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    ZIndex = 5,
                    Parent = Element
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = DisplayBtn})
                Create("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 24), Parent = DisplayBtn})
                Create("UIStroke", {Color = Theme.Border, Thickness = 1, Transparency = 0.4, Parent = DisplayBtn})

                local Chevron = Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.fromOffset(16, 16),
                    Position = UDim2.new(1, -20, 0.5, -8),
                    Font = Enum.Font.GothamBold,
                    Text = "▾",
                    TextColor3 = Theme.TextSecondary,
                    TextSize = 12,
                    ZIndex = 6,
                    Parent = DisplayBtn
                })

                local function GetDisplayText()
                    local list = {}
                    for _, optName in ipairs(Options) do
                        if Selected[optName] then
                            table.insert(list, optName)
                        end
                    end
                    if #list == 0 then
                        return Multi and "None" or (Options[1] or "Select...")
                    end
                    return table.concat(list, ", ")
                end
                DisplayBtn.Text = GetDisplayText()

                local DropdownOpen = false
                local DropdownFrame = nil
                local DropdownObj = {}

                local function UpdateDisplay()
                    DisplayBtn.Text = GetDisplayText()
                end

                local function CloseDropdown()
                    if not DropdownOpen or not DropdownFrame then return end
                    DropdownOpen = false
                    OpenPopups[DropdownObj] = nil
                    if ActiveDropdown == DropdownObj then
                        ActiveDropdown = nil
                    end
                    local t = Tween(DropdownFrame, {Size = UDim2.fromOffset(DropdownFrame.AbsoluteSize.X, 0)}, 0.15)
                    t.Completed:Connect(function()
                        if DropdownFrame then
                            DropdownFrame:Destroy()
                            DropdownFrame = nil
                        end
                    end)
                    Tween(Chevron, {Rotation = 0}, 0.15)
                end

                local function OpenDropdown()
                    if DropdownOpen then return end
                    CloseAllPopups(DropdownObj)
                    DropdownOpen = true
                    ActiveDropdown = DropdownObj
                    OpenPopups[DropdownObj] = true

                    local absPos = DisplayBtn.AbsolutePosition
                    local absSize = DisplayBtn.AbsoluteSize
                    local maxHeight = math.min(180, #Options * 28 + (Searchable and 36 or 8))

                    DropdownFrame = Create("Frame", {
                        Name = "DropdownPopup",
                        BackgroundColor3 = Theme.Dropdown,
                        BorderSizePixel = 0,
                        Size = UDim2.fromOffset(absSize.X, 0),
                        Position = UDim2.fromOffset(absPos.X, absPos.Y + absSize.Y + 4),
                        ZIndex = 50,
                        ClipsDescendants = true,
                        Parent = ScreenGui
                    })
                    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = DropdownFrame})
                    Create("UIStroke", {Color = Theme.Stroke, Thickness = 1, Parent = DropdownFrame})

                    local ListFrame = Create("ScrollingFrame", {
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 1, Searchable and -36 or 0),
                        Position = UDim2.fromOffset(0, Searchable and 36 or 0),
                        CanvasSize = UDim2.new(0, 0, 0, 0),
                        AutomaticCanvasSize = Enum.AutomaticSize.Y,
                        ScrollBarThickness = 3,
                        ScrollBarImageColor3 = Theme.Scrollbar,
                        BorderSizePixel = 0,
                        ZIndex = 51,
                        Parent = DropdownFrame
                    })
                    Create("UIPadding", {
                        PaddingTop = UDim.new(0, 4),
                        PaddingBottom = UDim.new(0, 4),
                        PaddingLeft = UDim.new(0, 4),
                        PaddingRight = UDim.new(0, 4),
                        Parent = ListFrame
                    })
                    local ListLayout = Create("UIListLayout", {
                        Padding = UDim.new(0, 2),
                        SortOrder = Enum.SortOrder.LayoutOrder,
                        Parent = ListFrame
                    })

                    if Searchable then
                        local SearchBox = Create("TextBox", {
                            BackgroundColor3 = Theme.BackgroundSecondary,
                            Size = UDim2.new(1, -8, 0, 28),
                            Position = UDim2.fromOffset(4, 4),
                            Font = Enum.Font.Gotham,
                            PlaceholderText = "Search...",
                            PlaceholderColor3 = Theme.TextMuted,
                            Text = "",
                            TextColor3 = Theme.Text,
                            TextSize = 12,
                            ClearTextOnFocus = false,
                            ZIndex = 52,
                            Parent = DropdownFrame
                        })
                        Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = SearchBox})
                        Create("UIPadding", {PaddingLeft = UDim.new(0, 8), Parent = SearchBox})

                        SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
                            local query = string.lower(SearchBox.Text)
                            for _, child in ipairs(ListFrame:GetChildren()) do
                                if child:IsA("TextButton") then
                                    child.Visible = query == "" or string.find(string.lower(child.Name), query, 1, true) ~= nil
                                end
                            end
                        end)
                    end

                    for i, option in ipairs(Options) do
                        local isSelected = Selected[option] == true
                        local OptBtn = Create("TextButton", {
                            Name = option,
                            BackgroundColor3 = isSelected and Theme.Accent or Theme.Element,
                            BackgroundTransparency = isSelected and 0.15 or 1,
                            Size = UDim2.new(1, 0, 0, 26),
                            Font = Enum.Font.Gotham,
                            Text = "  " .. option,
                            TextColor3 = isSelected and Theme.Accent or Theme.Text,
                            TextSize = 12,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            AutoButtonColor = false,
                            ZIndex = 52,
                            Parent = ListFrame
                        })
                        Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = OptBtn})

                        if Multi and isSelected then
                            Create("TextLabel", {
                                BackgroundTransparency = 1,
                                Size = UDim2.fromOffset(16, 16),
                                Position = UDim2.new(1, -22, 0.5, -8),
                                Font = Enum.Font.GothamBold,
                                Text = "✓",
                                TextColor3 = Theme.Accent,
                                TextSize = 12,
                                ZIndex = 53,
                                Parent = OptBtn
                            })
                        end

                        OptBtn.MouseEnter:Connect(function()
                            if not Selected[option] then
                                Tween(OptBtn, {BackgroundTransparency = 0.7, BackgroundColor3 = Theme.ElementHover}, 0.1)
                            end
                        end)
                        OptBtn.MouseLeave:Connect(function()
                            if not Selected[option] then
                                Tween(OptBtn, {BackgroundTransparency = 1}, 0.1)
                            end
                        end)

                        OptBtn.MouseButton1Click:Connect(function()
                            if Multi then
                                Selected[option] = not Selected[option]
                                UpdateDisplay()
                                local values = {}
                                for _, o in ipairs(Options) do
                                    if Selected[o] then table.insert(values, o) end
                                end
                                Callback(values)
                                local sel = Selected[option]
                                OptBtn.BackgroundTransparency = sel and 0.15 or 1
                                OptBtn.BackgroundColor3 = sel and Theme.Accent or Theme.Element
                                OptBtn.TextColor3 = sel and Theme.Accent or Theme.Text
                                local check = OptBtn:FindFirstChildOfClass("TextLabel")
                                if sel and not check then
                                    Create("TextLabel", {
                                        BackgroundTransparency = 1,
                                        Size = UDim2.fromOffset(16, 16),
                                        Position = UDim2.new(1, -22, 0.5, -8),
                                        Font = Enum.Font.GothamBold,
                                        Text = "✓",
                                        TextColor3 = Theme.Accent,
                                        TextSize = 12,
                                        ZIndex = 53,
                                        Parent = OptBtn
                                    })
                                elseif not sel and check then
                                    check:Destroy()
                                end
                            else
                                for k in pairs(Selected) do Selected[k] = nil end
                                Selected[option] = true
                                UpdateDisplay()
                                Callback(option)
                                CloseDropdown()
                            end
                        end)
                    end

                    Tween(DropdownFrame, {Size = UDim2.fromOffset(absSize.X, maxHeight)}, 0.2, Enum.EasingStyle.Quad)
                    Tween(Chevron, {Rotation = 180}, 0.15)

                    -- Outside click detection
                    local clickConn
                    clickConn = UserInputService.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            local pos = input.Position
                            local inDropdown = DropdownFrame and 
                                pos.X >= DropdownFrame.AbsolutePosition.X and pos.X <= DropdownFrame.AbsolutePosition.X + DropdownFrame.AbsoluteSize.X and
                                pos.Y >= DropdownFrame.AbsolutePosition.Y and pos.Y <= DropdownFrame.AbsolutePosition.Y + DropdownFrame.AbsoluteSize.Y
                            local inDisplay = pos.X >= DisplayBtn.AbsolutePosition.X and pos.X <= DisplayBtn.AbsolutePosition.X + DisplayBtn.AbsoluteSize.X and
                                pos.Y >= DisplayBtn.AbsolutePosition.Y and pos.Y <= DisplayBtn.AbsolutePosition.Y + DisplayBtn.AbsoluteSize.Y
                            if not inDropdown and not inDisplay then
                                CloseDropdown()
                                if clickConn then clickConn:Disconnect() end
                            end
                        end
                    end)
                end

                function DropdownObj.UpdatePosition()
                    if DropdownOpen and DropdownFrame and DisplayBtn then
                        local absPos = DisplayBtn.AbsolutePosition
                        local absSize = DisplayBtn.AbsoluteSize
                        DropdownFrame.Position = UDim2.fromOffset(absPos.X, absPos.Y + absSize.Y + 4)
                    end
                end

                function DropdownObj.Close()
                    CloseDropdown()
                end

                DisplayBtn.MouseButton1Click:Connect(function()
                    if DropdownOpen then
                        CloseDropdown()
                    else
                        OpenDropdown()
                    end
                end)

                Element.MouseEnter:Connect(function()
                    Tween(Element, {BackgroundColor3 = Theme.ElementHover}, 0.15)
                end)
                Element.MouseLeave:Connect(function()
                    Tween(Element, {BackgroundColor3 = Theme.Element}, 0.15)
                end)

                table.insert(Window.Popups, DropdownObj)

                local PublicObj = {
                    Frame = Element,
                    SetValue = function(_, val)
                        if Multi then
                            Selected = {}
                            if type(val) == "table" then
                                for _, v in ipairs(val) do Selected[v] = true end
                            end
                        else
                            Selected = {}
                            if val then Selected[val] = true end
                        end
                        UpdateDisplay()
                    end,
                    GetValue = function()
                        if Multi then
                            local t = {}
                            for _, o in ipairs(Options) do if Selected[o] then table.insert(t, o) end end
                            return t
                        else
                            for o in pairs(Selected) do return o end
                            return nil
                        end
                    end,
                    SetOptions = function(_, newOpts)
                        Options = newOpts or {}
                        UpdateDisplay()
                    end,
                    SetName = function(_, n) NameLabel.Text = n end,
                    SetVisible = function(_, v) Element.Visible = v end,
                    Destroy = function()
                        CloseDropdown()
                        Element:Destroy()
                    end
                }
                table.insert(Section.Elements, PublicObj)
                return PublicObj
            end

