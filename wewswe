-- ─────────────────────────────────────────────────────────
-- HELPERS
-- ─────────────────────────────────────────────────────────

local function Create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then inst[k] = v end
    end
    if props and props.Parent then inst.Parent = props.Parent end
    return inst
end

local function Tween(obj, props, dur, style, dir)
    TweenService:Create(
        obj,
        TweenInfo.new(dur or 0.18, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out),
        props
    ):Play()
end

local function Round(n, inc)
    inc = inc or 1
    return math.floor(n / inc + 0.5) * inc
end

local function MakeDraggable(frame, handle)
    local dragging, dragStart, startPos, dragInput
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

-- Returns screen-space position of a GuiObject, corrected for inset
local function GetScreenPos(obj)
    local inset = GuiService:GetGuiInset()
    return obj.AbsolutePosition - Vector2.new(0, inset.Y)
end

-- ─────────────────────────────────────────────────────────
-- OVERLAY MANAGER
-- Overlays (dropdowns, pickers) are parented directly to ScreenGui
-- and poll their anchor element each frame so they follow dragging.
-- ─────────────────────────────────────────────────────────

local function CloseAllOverlays()
    for _, data in ipairs(Library._Overlays) do
        if data and data.Frame and data.Frame.Parent then
            if data.Cleanup then pcall(data.Cleanup) end
            data.Frame:Destroy()
        end
    end
    Library._Overlays = {}
end

-- Check if a position is inside any active overlay
local function InsideOverlay(pos)
    for _, data in ipairs(Library._Overlays) do
        if data and data.Frame and data.Frame.Parent then
            local ap = data.Frame.AbsolutePosition
            local as = data.Frame.AbsoluteSize
            if pos.X >= ap.X and pos.X <= ap.X + as.X
            and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
                return true
            end
        end
    end
    return false
end

UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        -- Slight delay so the click inside an overlay registers first
        task.defer(function()
            if not InsideOverlay(input.Position) then
                CloseAllOverlays()
            end
        end)
    end
end)

--[[
    RegisterOverlay(frame, anchorElement, anchorOffsetY, cleanup)
    Attaches a RenderStepped connection that repositions `frame`
    relative to `anchorElement` every frame so it follows dragging.
]]
local function RegisterOverlay(frame, anchor, offsetY, cleanup)
    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not frame or not frame.Parent then
            conn:Disconnect()
            return
        end
        if not anchor or not anchor.Parent then
            conn:Disconnect()
            frame:Destroy()
            return
        end
        local screenPos = GetScreenPos(anchor)
        local newY = screenPos.Y + anchor.AbsoluteSize.Y + (offsetY or 4)
        frame.Position = UDim2.fromOffset(screenPos.X, newY)
    end)

    local data = {
        Frame   = frame,
        Cleanup = function()
            conn:Disconnect()
            if cleanup then cleanup() end
        end,
    }
    table.insert(Library._Overlays, data)
    return data
end

-- ─────────────────────────────────────────────────────────
-- COLOR MATH
-- ─────────────────────────────────────────────────────────

local function RGBtoHSV(r, g, b)
    r, g, b = r / 255, g / 255, b / 255
    local mx, mn = math.max(r,g,b), math.min(r,g,b)
    local h, s, v = 0, 0, mx
    local d = mx - mn
    if mx ~= 0 then s = d / mx end
    if mx ~= mn then
        if     mx == r then h = (g - b) / d + (g < b and 6 or 0)
        elseif mx == g then h = (b - r) / d + 2
        else              h = (r - g) / d + 4 end
        h = h / 6
    end
    return h, s, v
end

local function HSVtoRGB(h, s, v)
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p, q, t = v*(1-s), v*(1-f*s), v*(1-(1-f)*s)
    i = i % 6
    local r, g, b
    if     i == 0 then r,g,b = v,t,p
    elseif i == 1 then r,g,b = q,v,p
    elseif i == 2 then r,g,b = p,v,t
    elseif i == 3 then r,g,b = p,q,v
    elseif i == 4 then r,g,b = t,p,v
    else              r,g,b = v,p,q end
    return Color3.new(r, g, b)
end

local function ColorToHex(c)
    return string.format("%02X%02X%02X",
        math.clamp(math.floor(c.R*255+0.5),0,255),
        math.clamp(math.floor(c.G*255+0.5),0,255),
        math.clamp(math.floor(c.B*255+0.5),0,255))
end

local function HexToColor(hex)
    hex = hex:gsub("#","")
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1,2),16)
    local g = tonumber(hex:sub(3,4),16)
    local b = tonumber(hex:sub(5,6),16)
    if not (r and g and b) then return nil end
    return Color3.fromRGB(r,g,b)
end

