            PaddingBottom = UDim.new(0, 12),
            PaddingLeft = UDim.new(0, 14),
            PaddingRight = UDim.new(0, 14),
        })

        local Tab = {
            Button = TabBtn,
            Page = Page,
            Sections = {},
            Name = TabName,
        }

        local function SelectTab()
            for _, t in pairs(Window.Tabs) do
                t.Page.Visible = false
                Tween(t.Button, { BackgroundColor3 = Theme.Tertiary, TextColor3 = Theme.TextDim }, 0.15)
            end
            Page.Visible = true
            Tween(TabBtn, { BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Text }, 0.15)
            Window.CurrentTab = Tab
        end

        TabBtn.MouseButton1Click:Connect(SelectTab)

        -- Hover
        TabBtn.MouseEnter:Connect(function()
            if Window.CurrentTab ~= Tab then
                Tween(TabBtn, { BackgroundColor3 = Theme.Border, TextColor3 = Theme.Text }, 0.15)
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if Window.CurrentTab ~= Tab then
                Tween(TabBtn, { BackgroundColor3 = Theme.Tertiary, TextColor3 = Theme.TextDim }, 0.15)
            end
        end)

        -- First tab auto select
        if #Window.Tabs == 0 then
            task.defer(SelectTab)
        end

        table.insert(Window.Tabs, Tab)

