function Section:AddToggle(config)
	config = config or {}
	local window = self.Window
	local theme = window.Theme

	local row = self:_NewRow(30, true, config.Tooltip)

	local label = Create("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -50, 1, 0),
		Font = Enum.Font.Gotham,
		Text = config.Name or "Toggle",
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	local track = Create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(36, 20),
		BackgroundColor3 = theme.ToggleOff,
		BorderSizePixel = 0,
		Parent = row,
	})
	Corner(track, 10)

	local knob = Create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = track,
	})
	Corner(knob, 7)

	local element = {
		Type = "Toggle",
		Row = row,
		Label = label,
		Value = config.Default == true,
		Callback = config.Callback,
		Flag = config.Flag,
		Enabled = config.Enabled ~= false,
		Window = window,
	}

	local function applyVisuals(animate)
		local on = element.Value
		local trackColor = on and theme.Accent or theme.ToggleOff
		local knobPosition = on and UDim2.new(0, 19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)

		if animate then
			Tween(track, 0.16, { BackgroundColor3 = trackColor })
			Tween(knob, 0.16, { Position = knobPosition })
		else
			track.BackgroundColor3 = trackColor
			knob.Position = knobPosition
		end
	end

	applyVisuals(false)

	function element:SetValue(value, fire)
		value = value == true
		if self.Value == value then
			return
		end
		self.Value = value
		applyVisuals(true)
		if window.Library.Flags and self.Flag then
			window.Library.Flags[self.Flag] = value
		end
		if fire ~= false then
			RunCallback(self.Callback, value)
		end
	end

	function element:GetValue()
		return self.Value
	end

	function element:SetName(name)
		self.Label.Text = name
		row.Name = name
	end

	function element:SetEnabled(enabled)
		self.Enabled = enabled == true
		row.Active = self.Enabled
		label.TextColor3 = self.Enabled and theme.Text or theme.SubText
		label.TextTransparency = self.Enabled and 0 or 0.4
		track.BackgroundTransparency = self.Enabled and 0 or 0.4
		knob.BackgroundTransparency = self.Enabled and 0 or 0.4
	end

	function element:SetVisible(visible)
		row.Visible = visible == true
	end

	function element:Destroy()
		row:Destroy()
	end

	table.insert(window._connections, row.MouseButton1Click:Connect(function()
		if not element.Enabled then
			return
		end
		element:SetValue(not element.Value)
	end))

	window:_RegisterThemeFunction(function(theme)
		label.TextColor3 = element.Enabled and theme.Text or theme.SubText
		track.BackgroundColor3 = element.Value and theme.Accent or theme.ToggleOff
	end)

	if element.Flag and window.Library.Flags then
		window.Library.Flags[element.Flag] = element.Value
	end

	return element
end

