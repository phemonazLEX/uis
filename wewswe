                ug.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, t.GradientTop),
                    ColorSequenceKeypoint.new(1, t.GradientBot),
                })
            end
            hg.BackgroundColor3 = t.GradientTop
        end

        for _, el in ipairs(Window._Elements) do
            if el and el.ApplyTheme then
                pcall(el.ApplyTheme, el, t)
            end
        end
    end

