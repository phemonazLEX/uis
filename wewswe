			-- ─── AddToggle ────────────────────────────────────────────────────
			function SectionObj:AddToggle(opts)
				opts = opts or {}
				local name     = opts.Name     or "Toggle"
				local default  = opts.Default  ~= nil and opts.Default or false
				local callback = opts.Callback or function() end

				local row = MakeRow(name)
				Padding(row, 0, 10, 0, 10)

				local label = Instance.new("TextLabel")
				MakeClear(label)
				label.Text          = name
				label.TextColor3    = th.Text
				label.Font          = Enum.Font.GothamSemibold
				label.TextSize      = 12
				label.TextXAlignment = Enum.TextXAlignment.Left
				label.Size          = UDim2.new(1, -56, 1, 0)
				label.ZIndex        = 6
				label.Parent        = row

				-- Toggle track
				local track = Instance.new("Frame")
				track.BackgroundColor3 = default and th.ToggleOn or th.ToggleOff
				track.Size             = UDim2.new(0, 38, 0, 20)
				track.Position         = UDim2.new(1, -38, 0.5, -10)
				track.ZIndex           = 6
				track.Parent           = row
				Round(track, 10)

				-- Toggle knob
				local knob = Instance.new("Frame")
				knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				knob.Size             = UDim2.new(0, 14, 0, 14)
				knob.Position         = default
					and UDim2.new(0, 21, 0.5, -7)
					or  UDim2.new(0, 3,  0.5, -7)
				knob.ZIndex           = 7
				knob.Parent           = track
				Round(knob, 7)

				local value    = default
				local toggling = false

				local ToggleObj = {
					_row   = row,
					_track = track,
					_knob  = knob,
					_label = label,
					_value = value,
				}

				local function SetToggle(v, fireCallback)
					if toggling then return end
					toggling = true
					value = v
					ToggleObj._value = v
					Tween(track, { BackgroundColor3 = v and th.ToggleOn or th.ToggleOff }, 0.18)
					Tween(knob,  { Position = v and UDim2.new(0, 21, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) }, 0.18)
					if fireCallback then
						task.spawn(callback, v)
					end
					task.wait(0.18)
					toggling = false
				end

				row.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						SetToggle(not value, true)
					end
				end)
				row.MouseEnter:Connect(function()
					Tween(row, { BackgroundColor3 = th.ElementBgHover }, 0.1)
				end)
				row.MouseLeave:Connect(function()
					Tween(row, { BackgroundColor3 = th.ElementBg }, 0.1)
				end)

				function ToggleObj:SetValue(v)
					SetToggle(v, false)
				end
				function ToggleObj:GetValue()
					return self._value
				end
				function ToggleObj:SetName(n)
					label.Text = n
				end
				function ToggleObj:SetVisible(v)
					row.Visible = v
				end
				function ToggleObj:Destroy()
					row:Destroy()
				end

				return ToggleObj
			end

