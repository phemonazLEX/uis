--=====================================================================
-- 4. Popup (used by dropdown + colour picker)
--=====================================================================

local Popup = {}
Popup.__index = Popup

function Popup.new(window, anchor, config)
	config = config or {}
	local self = setmetatable({}, Popup)

	self.Window = window
	self.Anchor = anchor
	self.Open = false
	self.Width = config.Width
	self.Height = config.Height or 120
	self.OffsetY = config.OffsetY or 4
	self._tween = nil

	local theme = window.Theme
	window._popupZIndex = (window._popupZIndex or 40) + 1

	local frame = Create("CanvasGroup", {
		Name = config.Name or "Popup",
		BackgroundColor3 = theme.Popup,
		BackgroundTransparency = 0.03,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(self.Width or 160, self.Height),
		Position = UDim2.fromOffset(0, 0),
		Visible = false,
		GroupTransparency = 1,
		ZIndex = window._popupZIndex,
		Parent = window.Frame,
	})
	Corner(frame, 8)
	self.Stroke = Stroke(frame, theme.Outline, 1, 0.25)
	self.Frame = frame

	return self
end

function Popup:Update()
	if not self.Open then
		return
	end
	local anchor = self.Anchor
	if not (anchor and anchor.Parent) then
		return
	end

	local parent = self.Window.Frame
	local parentPos = parent.AbsolutePosition
	local anchorPos = anchor.AbsolutePosition
	local anchorSize = anchor.AbsoluteSize

	local width = self.Width or math.max(anchorSize.X, 140)
	local height = self.Height

	if self.Frame.Size.X.Offset ~= width or self.Frame.Size.Y.Offset ~= height then
		self.Frame.Size = UDim2.fromOffset(width, height)
	end

	local screenX = anchorPos.X
	local viewport = ViewportSize()
	if screenX + width > viewport.X - 8 then
		screenX = viewport.X - 8 - width
	end
	if screenX < 8 then
		screenX = 8
	end

	self.Frame.Position = UDim2.fromOffset(
		screenX - parentPos.X,
		anchorPos.Y - parentPos.Y + anchorSize.Y + self.OffsetY
	)
end

function Popup:Show()
	if self.Open then
		return
	end
	self.Open = true
	self.Window:_RegisterPopup(self)
	self:Update()
	self.Frame.Visible = true

	if self._tween then
		self._tween:Cancel()
	end
	self._tween = Tween(self.Frame, 0.16, { GroupTransparency = 0 })
end

function Popup:Hide()
	if not self.Open then
		return
	end
	self.Open = false
	self.Window:_UnregisterPopup(self)

	if self._tween then
		self._tween:Cancel()
	end
	local tween = Tween(self.Frame, 0.12, { GroupTransparency = 1 })
	self._tween = tween
	tween.Completed:Once(function()
		if not self.Open then
			self.Frame.Visible = false
		end
	end)
end

function Popup:ContainsPoint(position)
	if not self.Open then
		return false
	end
	local frame = self.Frame
	local pos, size = frame.AbsolutePosition, frame.AbsoluteSize
	if position.X >= pos.X and position.X <= pos.X + size.X
		and position.Y >= pos.Y and position.Y <= pos.Y + size.Y then
		return true
	end
	local anchor = self.Anchor
	if anchor and anchor.Parent then
		local apos, asize = anchor.AbsolutePosition, anchor.AbsoluteSize
		if position.X >= apos.X and position.X <= apos.X + asize.X
			and position.Y >= apos.Y and position.Y <= apos.Y + asize.Y then
			return true
		end
	end
	return false
end

function Popup:Destroy()
	self:_HideInternal()
	if self._tween then
		self._tween:Cancel()
		self._tween = nil
	end
	if self.Frame then
		self.Frame:Destroy()
	end
end

function Popup:_HideInternal()
	self.Open = false
	self.Window:_UnregisterPopup(self)
end

--=====================================================================
-- 5. Window
--=====================================================================

local Window = {}
Window.__index = Window

local Tab = {}
Tab.__index = Tab

local Section = {}
Section.__index = Section

local HEADER_HEIGHT = 88

local function DefaultPosition(size)
	return UDim2.fromScale(0.5, 0.5)
end

function Window.new(library, config)
	config = config or {}
	local self = setmetatable({}, Window)

	self.Library      = library
	self.Title        = config.Title or "Window"
	self.Subtitle     = config.Subtitle or ""
	self.Size         = config.Size or UDim2.fromOffset(660, 460)
	self.ToggleKey    = config.ToggleKey or Enum.KeyCode.RightShift
	self.ThemeName    = config.Theme or "Dark"
	self.Theme        = Themes[self.ThemeName] or Themes.Dark
	self.Tabs         = {}
	self.ActiveTab    = nil
	self.Visible      = true
	self.Destroyed    = false

	self._popups      = {}
	self._themeObjects = {}
	self._dragExclude = {}
	self._connections = {}
	self._popupZIndex = 40
	self._tooltip     = nil

	local gui = library:_GetScreenGui()
	local theme = self.Theme

	--=================================================================
	-- Root container
	--=================================================================
	local root = Create("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Active = false,
		Parent = gui,
	})
	self.Root = root

	--=================================================================
	-- Window frame (holds shadows, body and popups)
	--=================================================================
	local frame = Create("Frame", {
		Name = "Window",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = DefaultPosition(self.Size),
		Size = self.Size,
		ClipsDescendants = false,
		ZIndex = 2,
		Parent = root,
	})
	self.Frame = frame

	-- Soft shadow: several stacked, offset, rounded frames -----------
	local shadowLayers = {
		{ pad = 20, transparency = 0.98 },
		{ pad = 13, transparency = 0.97 },
		{ pad = 7,  transparency = 0.95 },
	}
	for index, layer in ipairs(shadowLayers) do
		local shadow = Create("Frame", {
			Name = "Shadow",
			BackgroundColor3 = theme.Shadow,
			BackgroundTransparency = layer.transparency,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, layer.pad * 2, 1, layer.pad * 2),
			ZIndex = index,
			Parent = frame,
		})
		Corner(shadow, 12 + layer.pad)
	end

	-- Body -----------------------------------------------------------
	-- CanvasGroup is used so GroupTransparency can fade the whole window.
	-- IMPORTANT: never parent a UIGradient (or a dark GroupColor3) directly
	-- to a CanvasGroup. Roblox applies those effects to the flattened
	-- texture of EVERY descendant, which crushes contrast and makes the
	-- whole UI look like it is under a black overlay.
	local body = Create("CanvasGroup", {
		Name = "Body",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		GroupColor3 = Color3.new(1, 1, 1),
		GroupTransparency = 0,
		ZIndex = 10,
		Parent = frame,
	})
	Corner(body, 12)
	self.Body = body

	local bodyFill = Create("Frame", {
		Name = "Background",
		BackgroundColor3 = theme.Background,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Active = false,
		ZIndex = 0,
		Parent = body,
	})
	Corner(bodyFill, 12)
	self.BodyFill = bodyFill

	local bodyGradient = Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(theme.BackgroundTop, theme.BackgroundBottom),
		Parent = bodyFill,
	})
	self.BodyGradient = bodyGradient

	local bodyStroke = Stroke(body, theme.Outline, 1, 0.35)
	self.BodyStroke = bodyStroke

	--=================================================================
	-- Header
	--=================================================================
	local title = Create("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -32, 0, 18),
		Font = Enum.Font.GothamBold,
		Text = self.Title,
		TextColor3 = theme.Text,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 12,
		Parent = body,
	})
	self.TitleLabel = title

	local subtitle = Create("TextLabel", {
		Name = "Subtitle",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(16, 30),
		Size = UDim2.new(1, -32, 0, 14),
		Font = Enum.Font.Gotham,
		Text = self.Subtitle,
		TextColor3 = theme.SubText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 12,
		Parent = body,
	})
	self.SubtitleLabel = subtitle

	local tabBar = Create("ScrollingFrame", {
		Name = "TabBar",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(10, 52),
		Size = UDim2.new(1, -20, 0, 28),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 0,
		ZIndex = 12,
		Parent = body,
	})
	List(tabBar, {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
	self.TabBar = tabBar

	local divider = Create("Frame", {
		Name = "Divider",
		BackgroundColor3 = theme.Divider,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, HEADER_HEIGHT - 1),
		Size = UDim2.new(1, 0, 0, 1),
		ZIndex = 12,
		Parent = body,
	})
	self.Divider = divider

	--=================================================================
	-- Content
	--=================================================================
	local content = Create("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, HEADER_HEIGHT),
		Size = UDim2.new(1, 0, 1, -HEADER_HEIGHT),
		ZIndex = 12,
		Parent = body,
	})
	self.Content = content

	--=================================================================
	-- Theme registration
	--=================================================================
	self:_RegisterTheme(bodyFill, "BackgroundColor3", "Background")
	self:_RegisterTheme(bodyStroke, "Color", "Outline")
	self:_RegisterTheme(title, "TextColor3", "Text")
	self:_RegisterTheme(subtitle, "TextColor3", "SubText")
	self:_RegisterTheme(divider, "BackgroundColor3", "Divider")
	self:_RegisterTheme(tabBar, "ScrollBarImageColor3", "ScrollBar")
	self:_RegisterThemeFunction(function(theme)
		if bodyGradient then
			bodyGradient.Color = ColorSequence.new(theme.BackgroundTop, theme.BackgroundBottom)
		end
	end)

	--=================================================================
	-- Dragging
	--=================================================================
	self:_SetupDragging()

	--=================================================================
	-- Global input handling for popups
	--=================================================================
	table.insert(self._connections, UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if #self._popups == 0 then
			return
		end
		local position = Vector2.new(input.Position.X, input.Position.Y)
		for _, popup in ipairs(self._popups) do
			if popup:ContainsPoint(position) then
				return
			end
		end
		self:ClosePopups()
	end))

	--=================================================================
	-- Toggle key
	--=================================================================
	self:_BindToggleKey()

	return self
end

-----------------------------------------------------------------------
-- Theme plumbing
-----------------------------------------------------------------------

function Window:_RegisterTheme(target, property, themeKey)
	table.insert(self._themeObjects, { target, property, themeKey })
end

function Window:_RegisterThemeFunction(fn)
	table.insert(self._themeObjects, fn)
end

function Window:SetTheme(theme)
	if typeof(theme) == "string" then
		theme = Themes[theme] or self.Theme
	elseif typeof(theme) ~= "table" then
		return
	end

	self.ThemeName = theme.Name or self.ThemeName
	self.Theme = theme

	for _, entry in ipairs(self._themeObjects) do
		if type(entry) == "function" then
			entry(theme)
		else
			local object = entry[1]
			if object and object.Parent then
				object[entry[2]] = theme[entry[3]]
			end
		end
	end

	self:_UpdatePopups()
end

-----------------------------------------------------------------------
-- Dragging
-----------------------------------------------------------------------

function Window:_SetupDragging()
	local frame = self.Frame
	local dragging = false
	local dragStart = nil
	local startPosition = nil

	local function isExcluded(position)
		for _, object in ipairs(self._dragExclude) do
			if object and object.Parent then
				local pos, size = object.AbsolutePosition, object.AbsoluteSize
				if position.X >= pos.X and position.X <= pos.X + size.X
					and position.Y >= pos.Y and position.Y <= pos.Y + size.Y then
					return true
				end
			end
		end
		return false
	end

	local function beginDrag(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if isExcluded(Vector2.new(input.Position.X, input.Position.Y)) then
			return
		end

		dragging = true
		dragStart = input.Position
		startPosition = frame.Position

		BeginDrag({
			Move = function(position)
				if not dragging then
					return
				end
				local delta = position - dragStart
				frame.Position = UDim2.new(
					startPosition.X.Scale,
					startPosition.X.Offset + delta.X,
					startPosition.Y.Scale,
					startPosition.Y.Offset + delta.Y
				)
				self:_UpdatePopups()
			end,
			Finish = function()
				dragging = false
			end,
		})
	end

	-- Title area acts as the drag handle
	local handle = Create("TextButton", {
		Name = "DragHandle",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 0, HEADER_HEIGHT - 34),
		ZIndex = 11,
		Parent = self.Body,
	})
	self.DragHandle = handle

	table.insert(self._connections, handle.InputBegan:Connect(beginDrag))
end

-----------------------------------------------------------------------
-- Popups
-----------------------------------------------------------------------

function Window:_RegisterPopup(popup)
	table.insert(self._popups, popup)
end

function Window:_UnregisterPopup(popup)
	local index = table.find(self._popups, popup)
	if index then
		table.remove(self._popups, index)
	end
end

function Window:_UpdatePopups()
	for _, popup in ipairs(self._popups) do
		popup:Update()
	end
end

function Window:ClosePopups(except)
	for index = #self._popups, 1, -1 do
		local popup = self._popups[index]
		if popup ~= except then
			popup:Hide()
		end
	end
end

-----------------------------------------------------------------------
-- Tooltip
-----------------------------------------------------------------------

function Window:HideTooltip()
	if self._tooltip then
		self._tooltip:Destroy()
		self._tooltip = nil
	end
end

function Window:ShowTooltip(text, anchor)
	self:HideTooltip()
	if not text or text == "" then
		return
	end

	local theme = self.Theme
	local textSize = TextService:GetTextSize(text, 12, Enum.Font.Gotham, Vector2.new(280, 1000))

	local frame = Create("Frame", {
		Name = "Tooltip",
		BackgroundColor3 = theme.Popup,
		BackgroundTransparency = 0.03,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(textSize.X + 16, textSize.Y + 12),
		ZIndex = 95,
		Parent = self.Frame,
	})
	Corner(frame, 6)
	Stroke(frame, theme.Outline, 1, 0.3)

	Create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.Gotham,
		Text = text,
		TextColor3 = theme.Text,
		TextSize = 12,
		TextWrapped = true,
		Parent = frame,
	})

	local anchorPos = anchor.AbsolutePosition
	local anchorSize = anchor.AbsoluteSize
	local parentPos = self.Frame.AbsolutePosition

	local x = anchorPos.X - parentPos.X
	local y = anchorPos.Y - parentPos.Y + anchorSize.Y + 6

	local viewport = ViewportSize()
	if anchorPos.X + frame.Size.X.Offset > viewport.X - 8 then
		x = viewport.X - 8 - frame.Size.X.Offset - parentPos.X
	end
	if x < 8 - parentPos.X then
		x = 8 - parentPos.X
	end

	frame.Position = UDim2.fromOffset(x, y)
	self._tooltip = frame
end

function Window:_AttachTooltip(object, text)
	if not text or text == "" then
		return
	end
	table.insert(self._connections, object.MouseEnter:Connect(function()
		self:ShowTooltip(text, object)
	end))
	table.insert(self._connections, object.MouseLeave:Connect(function()
		self:HideTooltip()
	end))
end

-----------------------------------------------------------------------
-- Visibility / toggle key
-----------------------------------------------------------------------

function Window:_BindToggleKey()
	if self._toggleConnection then
		self._toggleConnection:Disconnect()
		self._toggleConnection = nil
	end
	if not self.ToggleKey then
		return
	end
	self._toggleConnection = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == self.ToggleKey then
			self:Toggle()
		end
	end)
end

function Window:SetToggleKey(keyCode)
	self.ToggleKey = keyCode
	self:_BindToggleKey()
end

function Window:Toggle()
	self:SetVisible(not self.Visible)
end

function Window:SetVisible(visible)
	visible = visible == true
	if self.Visible == visible then
		return
	end
	self.Visible = visible

	if not visible then
		self:ClosePopups()
		self:HideTooltip()
	end

	self.Root.Visible = visible

	if visible then
		self.Body.GroupTransparency = 1
		Tween(self.Body, 0.18, { GroupTransparency = 0 })
	else
		self.Body.GroupTransparency = 1
	end
end

function Window:SetSize(size)
	if typeof(size) ~= "UDim2" then
		return
	end
	self.Size = size
	self.Frame.Size = size
	self:_UpdatePopups()
end

function Window:SetTitle(title)
	self.Title = title
	self.TitleLabel.Text = title
end

function Window:SetSubtitle(subtitle)
	self.Subtitle = subtitle
	self.SubtitleLabel.Text = subtitle
end

