			-- ─── AddColorPicker ───────────────────────────────────────────────
			function SectionObj:AddColorPicker(opts)
				opts = opts or {}
				local name     = opts.Name     or "Color"
				local default  = opts.Default  or Color3.fromRGB(255, 120, 40)
				local callback = opts.Callback or function() end

				local h, s, v_val = Color3.toHSV(default)
				local currentColor = default
				local pickerOpen   = false
				local pickerPopup  = nil
				local pickerConn   = nil

				local row = MakeRow(name)
				Padding(row, 0, 10, 0, 10)

				local cpLabel = Instance.new("TextLabel")
				MakeClear(cpLabel)
				cpLabel.Text          = name
				cpLabel.TextColor3    = th.Text
				cpLabel.Font          = Enum.Font.GothamSemibold
				cpLabel.TextSize      = 12
				cpLabel.TextXAlignment = Enum.TextXAlignment.Left
				cpLabel.Size          = UDim2.new(0.7, 0, 1, 0)
				cpLabel.ZIndex        = 6
				cpLabel.Parent        = row

				local preview = Instance.new("TextButton")
				preview.Text             = ""
				preview.BackgroundColor3 = currentColor
				preview.Size             = UDim2.new(0, 60, 0, 22)
				preview.Position         = UDim2.new(1, -60, 0.5, -11)
				preview.ZIndex           = 6
				preview.Parent           = row
				Round(preview, 4)
				Stroke(preview, th.Border, 1)

				local function CloseColorPicker()
					if not pickerOpen then return end
					pickerOpen = false
					if pickerPopup then
						pickerPopup:Destroy()
						pickerPopup = nil
					end
					if pickerConn then
						pickerConn:Disconnect()
						pickerConn = nil
					end
				end

				local function UpdateColor()
					currentColor = Color3.fromHSV(h, s, v_val)
					preview.BackgroundColor3 = currentColor
					task.spawn(callback, currentColor)
				end

				local function OpenColorPicker()
					if pickerOpen then CloseColorPicker(); return end
					pickerOpen = true

					local pWidth  = 220
					local pHeight = 200

					local absPos  = preview.AbsolutePosition
					local absSize = preview.AbsoluteSize

					pickerPopup = Instance.new("Frame")
					pickerPopup.Name             = "ColorPickerPopup"
					pickerPopup.BackgroundColor3 = th.PopupBg
					pickerPopup.Size             = UDim2.new(0, pWidth, 0, pHeight)
					pickerPopup.Position         = UDim2.new(0, absPos.X - pWidth + absSize.X, 0, absPos.Y + absSize.Y + 6)
					pickerPopup.ZIndex           = 50
					pickerPopup.ClipsDescendants = false
					pickerPopup.Parent           = SectionObj._screenGui
					Round(pickerPopup, 8)
					Stroke(pickerPopup, th.PopupBorder, 1)
					Padding(pickerPopup, 10, 10, 10, 10)

					-- SV palette (saturation/value square)
					local palette = Instance.new("ImageButton")
					palette.Image            = "rbxassetid://698052001"  -- hue gradient
					palette.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
					palette.Size             = UDim2.new(1, 0, 0, 120)
					palette.Position         = UDim2.new(0, 0, 0, 0)
					palette.ZIndex           = 51
					palette.Parent           = pickerPopup
					Round(palette, 4)

					-- White -> transparent gradient (left to right)
					local whiteGrad = Instance.new("Frame")
					whiteGrad.BackgroundColor3 = Color3.fromRGB(255,255,255)
					whiteGrad.Size             = UDim2.new(1, 0, 1, 0)
					whiteGrad.ZIndex           = 52
					whiteGrad.Parent           = palette
					Round(whiteGrad, 4)
					Gradient(whiteGrad, ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(255,255,255)),
					}), 0)
					local wg = whiteGrad:FindFirstChildOfClass("UIGradient")
					wg.Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 0),
						NumberSequenceKeypoint.new(1, 1),
					})

					-- Black -> transparent gradient (top to bottom)
					local blackGrad = Instance.new("Frame")
					blackGrad.BackgroundColor3 = Color3.fromRGB(0,0,0)
					blackGrad.Size             = UDim2.new(1, 0, 1, 0)
					blackGrad.ZIndex           = 53
					blackGrad.Parent           = palette
					Round(blackGrad, 4)
					Gradient(blackGrad, ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(0,0,0)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(0,0,0)),
					}), 90)
					local bg = blackGrad:FindFirstChildOfClass("UIGradient")
					bg.Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 1),
						NumberSequenceKeypoint.new(1, 0),
					})

					-- SV cursor
					local svCursor = Instance.new("Frame")
					svCursor.BackgroundColor3 = Color3.fromRGB(255,255,255)
					svCursor.Size             = UDim2.new(0, 10, 0, 10)
					svCursor.Position         = UDim2.new(s, -5, 1 - v_val, -5)
					svCursor.ZIndex           = 55
					svCursor.Parent           = palette
					Round(svCursor, 5)
					Stroke(svCursor, Color3.fromRGB(40,40,40), 2)

					-- Hue slider
					local hueTrack = Instance.new("Frame")
					hueTrack.Size     = UDim2.new(1, 0, 0, 14)
					hueTrack.Position = UDim2.new(0, 0, 0, 130)
					hueTrack.ZIndex   = 51
					hueTrack.Parent   = pickerPopup
					Round(hueTrack, 3)

					-- Hue gradient
					local hueSeq = {}
					for i = 0, 6 do
						table.insert(hueSeq, ColorSequenceKeypoint.new(i/6, Color3.fromHSV(i/6, 1, 1)))
					end
					local hueGradient = Instance.new("UIGradient")
					hueGradient.Color  = ColorSequence.new(hueSeq)
					hueGradient.Rotation = 0
					hueGradient.Parent = hueTrack

					local hueCursor = Instance.new("Frame")
					hueCursor.BackgroundColor3 = Color3.fromRGB(255,255,255)
					hueCursor.Size             = UDim2.new(0, 8, 1, 4)
					hueCursor.Position         = UDim2.new(h, -4, 0, -2)
					hueCursor.ZIndex           = 52
					hueCursor.Parent           = hueTrack
					Round(hueCursor, 3)
					Stroke(hueCursor, Color3.fromRGB(40,40,40), 2)

					-- Color preview row
					local previewRow = Instance.new("Frame")
					MakeClear(previewRow)
					previewRow.Size     = UDim2.new(1, 0, 0, 24)
					previewRow.Position = UDim2.new(0, 0, 0, 154)
					previewRow.ZIndex   = 51
					previewRow.Parent   = pickerPopup

					local previewSwatch = Instance.new("Frame")
					previewSwatch.BackgroundColor3 = currentColor
					previewSwatch.Size             = UDim2.new(0, 40, 1, 0)
					previewSwatch.ZIndex           = 52
					previewSwatch.Parent           = previewRow
					Round(previewSwatch, 4)
					Stroke(previewSwatch, th.Border, 1)

					local hexLabel = Instance.new("TextBox")
					hexLabel.BackgroundColor3 = th.ElementBg
					hexLabel.Text             = string.format("#%02X%02X%02X",
						math.floor(currentColor.R * 255),
						math.floor(currentColor.G * 255),
						math.floor(currentColor.B * 255))
					hexLabel.TextColor3       = th.Text
					hexLabel.Font             = Enum.Font.Code
					hexLabel.TextSize         = 11
					hexLabel.Size             = UDim2.new(1, -48, 1, 0)
					hexLabel.Position         = UDim2.new(0, 46, 0, 0)
					hexLabel.ZIndex           = 52
					hexLabel.ClearTextOnFocus = false
					hexLabel.Parent           = previewRow
					Round(hexLabel, 4)
					Stroke(hexLabel, th.Border, 1)

					local function UpdatePickerUI()
						palette.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
						svCursor.Position        = UDim2.new(s, -5, 1 - v_val, -5)
						hueCursor.Position       = UDim2.new(h, -4, 0, -2)
						previewSwatch.BackgroundColor3 = currentColor
						hexLabel.Text = string.format("#%02X%02X%02X",
							math.floor(currentColor.R * 255),
							math.floor(currentColor.G * 255),
							math.floor(currentColor.B * 255))
					end

					-- SV palette interaction
					local svDragging = false
					palette.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then
							svDragging = true
							local rel = input.Position - palette.AbsolutePosition
							s     = math.clamp(rel.X / palette.AbsoluteSize.X, 0, 1)
							v_val = math.clamp(1 - rel.Y / palette.AbsoluteSize.Y, 0, 1)
							UpdateColor()
							UpdatePickerUI()
						end
					end)

					UserInputService.InputChanged:Connect(function(input)
						if svDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
							local rel = input.Position - palette.AbsolutePosition
							s     = math.clamp(rel.X / palette.AbsoluteSize.X, 0, 1)
							v_val = math.clamp(1 - rel.Y / palette.AbsoluteSize.Y, 0, 1)
							UpdateColor()
							UpdatePickerUI()
						end
					end)

					UserInputService.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then
							svDragging = false
						end
					end)

					-- Hue track interaction
					local hueDragging = false
					hueTrack.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then
							hueDragging = true
							h = math.clamp((input.Position.X - hueTrack.AbsolutePosition.X) / hueTrack.AbsoluteSize.X, 0, 1)
							UpdateColor()
							UpdatePickerUI()
						end
					end)

					UserInputService.InputChanged:Connect(function(input)
						if hueDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
							h = math.clamp((input.Position.X - hueTrack.AbsolutePosition.X) / hueTrack.AbsoluteSize.X, 0, 1)
							UpdateColor()
							UpdatePickerUI()
						end
					end)

					UserInputService.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then
							hueDragging = false
						end
					end)

					-- Hex input
					hexLabel.FocusLost:Connect(function()
						local hex = hexLabel.Text:gsub("#", "")
						if #hex == 6 then
							local r = tonumber(hex:sub(1,2), 16)
							local g = tonumber(hex:sub(3,4), 16)
							local b = tonumber(hex:sub(5,6), 16)
							if r and g and b then
								currentColor = Color3.fromRGB(r, g, b)
								h, s, v_val  = Color3.toHSV(currentColor)
								preview.BackgroundColor3 = currentColor
								UpdatePickerUI()
								task.spawn(callback, currentColor)
							end
						end
					end)

					-- Follow window drag
					pickerConn = RunService.RenderStepped:Connect(function()
						if not pickerPopup or not pickerPopup.Parent then return end
						local currentAbsPos  = preview.AbsolutePosition
						local currentAbsSize = preview.AbsoluteSize
						pickerPopup.Position = UDim2.new(
							0, currentAbsPos.X - pWidth + currentAbsSize.X,
							0, currentAbsPos.Y + currentAbsSize.Y + 6
						)
					end)
				end

				preview.MouseButton1Click:Connect(OpenColorPicker)

				-- Close on outside click
				UserInputService.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						if not pickerOpen or not pickerPopup then return end
						local mp = UserInputService:GetMouseLocation()

						local function inBounds(frame)
							if not frame or not frame.Parent then return false end
							local ap = frame.AbsolutePosition
							local as = frame.AbsoluteSize
							return mp.X >= ap.X and mp.X <= ap.X + as.X
								and mp.Y >= ap.Y and mp.Y <= ap.Y + as.Y
						end

						if not inBounds(pickerPopup) and not inBounds(preview) then
							CloseColorPicker()
						end
					end
				end)

				row.MouseEnter:Connect(function()
					Tween(row, { BackgroundColor3 = th.ElementBgHover }, 0.1)
				end)
				row.MouseLeave:Connect(function()
					Tween(row, { BackgroundColor3 = th.ElementBg }, 0.1)
				end)

				local CPObj = { _row = row, _preview = preview }

				function CPObj:SetValue(color)
					currentColor = color
					h, s, v_val = Color3.toHSV(color)
					preview.BackgroundColor3 = color
				end
				function CPObj:GetValue()
					return currentColor
				end
				function CPObj:SetName(n)
					cpLabel.Text = n
				end
				function CPObj:SetVisible(v)
					row.Visible = v
					if not v then CloseColorPicker() end
				end
				function CPObj:Destroy()
					CloseColorPicker()
					row:Destroy()
				end

				return CPObj
			end

			-- ─── AddParagraph ─────────────────────────────────────────────────
			function SectionObj:AddParagraph(opts)
				opts = opts or {}
				local title = opts.Title or ""
				local text  = opts.Text  or ""

				local container = Instance.new("Frame")
				MakeClear(container)
				container.AutomaticSize = Enum.AutomaticSize.Y
				container.Size          = UDim2.new(1, 0, 0, 0)
				container.ZIndex        = 5
				container.LayoutOrder   = tick()
				container.Parent        = ElementContainer
				ListLayout(container, Enum.FillDirection.Vertical,
					Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top, 4)
				Padding(container, 4, 6, 4, 6)

				if title ~= "" then
					local titleLbl = Instance.new("TextLabel")
					MakeClear(titleLbl)
					titleLbl.Text          = title
					titleLbl.TextColor3    = th.Text
					titleLbl.Font          = Enum.Font.GothamBold
					titleLbl.TextSize      = 12
					titleLbl.TextXAlignment = Enum.TextXAlignment.Left
					titleLbl.Size          = UDim2.new(1, 0, 0, 18)
					titleLbl.ZIndex        = 6
					titleLbl.Parent        = container
				end

				local textLbl = Instance.new("TextLabel")
				MakeClear(textLbl)
				textLbl.Text          = text
				textLbl.TextColor3    = th.TextDim
				textLbl.Font          = Enum.Font.Gotham
				textLbl.TextSize      = 11
				textLbl.TextXAlignment = Enum.TextXAlignment.Left
				textLbl.TextWrapped   = true
				textLbl.AutomaticSize = Enum.AutomaticSize.Y
				textLbl.Size          = UDim2.new(1, 0, 0, 0)
				textLbl.ZIndex        = 6
				textLbl.Parent        = container

				local ParaObj = {
					_container = container,
					_text      = textLbl,
				}

				function ParaObj:SetText(t)
					textLbl.Text = t
				end
				function ParaObj:SetTitle(t)
					-- find and update title if exists
				end
				function ParaObj:SetVisible(v)
					container.Visible = v
				end
				function ParaObj:Destroy()
					container:Destroy()
				end

				return ParaObj
			end

			-- ─── AddProgressBar ───────────────────────────────────────────────
			function SectionObj:AddProgressBar(opts)
				opts = opts or {}
				local name    = opts.Name    or "Progress"
				local default = opts.Default or 0  -- 0-100

				local row = Instance.new("Frame")
				row.Name             = "Row_" .. name
				row.BackgroundColor3 = th.ElementBg
				row.Size             = UDim2.new(1, 0, 0, 42)
				row.ZIndex           = 5
				row.LayoutOrder      = tick()
				row.Parent           = ElementContainer
				Round(row, 6)
				Padding(row, 6, 10, 6, 10)

				local pLabel = Instance.new("TextLabel")
				MakeClear(pLabel)
				pLabel.Text          = name
				pLabel.TextColor3    = th.Text
				pLabel.Font          = Enum.Font.GothamSemibold
				pLabel.TextSize      = 12
				pLabel.TextXAlignment = Enum.TextXAlignment.Left
				pLabel.Size          = UDim2.new(0.7, 0, 0, 16)
				pLabel.ZIndex        = 6
				pLabel.Parent        = row

				local pValLabel = Instance.new("TextLabel")
				MakeClear(pValLabel)
				pValLabel.Text          = math.floor(default) .. "%"
				pValLabel.TextColor3    = th.Accent
				pValLabel.Font          = Enum.Font.GothamBold
				pValLabel.TextSize      = 12
				pValLabel.TextXAlignment = Enum.TextXAlignment.Right
				pValLabel.Size          = UDim2.new(0.3, 0, 0, 16)
				pValLabel.Position      = UDim2.new(0.7, 0, 0, 0)
				pValLabel.ZIndex        = 6
				pValLabel.Parent        = row

				local trackBg = Instance.new("Frame")
				trackBg.BackgroundColor3 = th.Border
				trackBg.Size             = UDim2.new(1, 0, 0, 6)
				trackBg.Position         = UDim2.new(0, 0, 1, -6)
				trackBg.ZIndex           = 6
				trackBg.Parent           = row
				Round(trackBg, 3)

				local fill = Instance.new("Frame")
				fill.BackgroundColor3 = th.Accent
				fill.Size             = UDim2.new(math.clamp(default/100, 0, 1), 0, 1, 0)
				fill.ZIndex           = 7
				fill.Parent           = trackBg
				Round(fill, 3)

				local PBObj = { _row = row, _fill = fill, _valLabel = pValLabel }

				function PBObj:SetValue(v)
					v = math.clamp(v, 0, 100)
					Tween(fill, { Size = UDim2.new(v/100, 0, 1, 0) }, 0.3)
					pValLabel.Text = math.floor(v) .. "%"
				end
				function PBObj:GetValue()
					return fill.Size.X.Scale * 100
				end
				function PBObj:SetName(n)
					pLabel.Text = n
				end
				function PBObj:SetVisible(v)
					row.Visible = v
				end
				function PBObj:Destroy()
					row:Destroy()
				end

				return PBObj
			end

			-- ─── AddStatusIndicator ───────────────────────────────────────────
			function SectionObj:AddStatusIndicator(opts)
				opts = opts or {}
				local name   = opts.Name   or "Status"
				local status = opts.Status or "Idle"  -- Idle | Active | Warning | Error

				local colors = {
					Idle    = th.TextDim,
					Active  = th.Success,
					Warning = th.Warning,
					Error   = th.Error,
				}

				local row = MakeRow(name)
				Padding(row, 0, 10, 0, 10)

				local sLabel = Instance.new("TextLabel")
				MakeClear(sLabel)
				sLabel.Text          = name
				sLabel.TextColor3    = th.Text
				sLabel.Font          = Enum.Font.GothamSemibold
				sLabel.TextSize      = 12
				sLabel.TextXAlignment = Enum.TextXAlignment.Left
				sLabel.Size          = UDim2.new(0.6, 0, 1, 0)
				sLabel.ZIndex        = 6
				sLabel.Parent        = row

				local dot = Instance.new("Frame")
				dot.BackgroundColor3 = colors[status] or th.TextDim
				dot.Size             = UDim2.new(0, 8, 0, 8)
				dot.Position         = UDim2.new(1, -76, 0.5, -4)
				dot.ZIndex           = 6
				dot.Parent           = row
				Round(dot, 4)

				local sValueLabel = Instance.new("TextLabel")
				MakeClear(sValueLabel)
				sValueLabel.Text          = status
				sValueLabel.TextColor3    = colors[status] or th.TextDim
				sValueLabel.Font          = Enum.Font.GothamSemibold
				sValueLabel.TextSize      = 11
				sValueLabel.TextXAlignment = Enum.TextXAlignment.Right
				sValueLabel.Size          = UDim2.new(0, 64, 1, 0)
				sValueLabel.Position      = UDim2.new(1, -64, 0, 0)
				sValueLabel.ZIndex        = 6
				sValueLabel.Parent        = row

				row.MouseEnter:Connect(function()
					Tween(row, { BackgroundColor3 = th.ElementBgHover }, 0.1)
				end)
				row.MouseLeave:Connect(function()
					Tween(row, { BackgroundColor3 = th.ElementBg }, 0.1)
				end)

				local SIObj = { _row = row, _dot = dot, _label = sValueLabel }

				function SIObj:SetStatus(s)
					local c = colors[s] or th.TextDim
					Tween(dot,           { BackgroundColor3 = c }, 0.2)
					Tween(sValueLabel,   { TextColor3       = c }, 0.2)
					sValueLabel.Text = s
				end
				function SIObj:SetName(n)
					sLabel.Text = n
				end
				function SIObj:SetVisible(v)
					row.Visible = v
				end
				function SIObj:Destroy()
					row:Destroy()
				end

				return SIObj
			end

			-- ─── SetName / Destroy on Section ────────────────────────────────
			function SectionObj:SetName(n)
				SectionTitle.Text = n
			end
			function SectionObj:SetVisible(v)
				Section.Visible = v
			end
			function SectionObj:Destroy()
				Section:Destroy()
			end

			table.insert(self._sections, SectionObj)
			return SectionObj
		end

		return TabObj
	end

	-- ─── _selectTab ──────────────────────────────────────────────────────────
	function WindowObj:_selectTab(tabObj)
		for _, tab in ipairs(self._tabs) do
			local isActive = (tab == tabObj)
			tab._page.Visible = isActive
			Tween(tab._btn, {
				BackgroundColor3 = isActive and self._theme.TabActive or self._theme.TabBg,
				TextColor3       = isActive and self._theme.Text      or self._theme.TextDim,
			}, 0.15)
			Tween(tab._indicator, {
				BackgroundTransparency = isActive and 0 or 1,
			}, 0.15)
		end
		self._activeTab = tabObj
	end

	-- ─── Notify ──────────────────────────────────────────────────────────────
	function WindowObj:Notify(opts)
		return self._notifMgr:Notify(opts)
	end

	-- ─── SetTheme ────────────────────────────────────────────────────────────
	function WindowObj:SetTheme(name)
		-- Swap the theme reference; existing elements keep their colors
		-- Full re-skin would require re-parenting — left as extension point
		self._theme = Themes[name] or Themes.Dark
	end

	-- ─── Destroy ─────────────────────────────────────────────────────────────
	function WindowObj:Destroy()
		for _, conn in ipairs(self._connections) do
			conn:Disconnect()
		end
		ScreenGui:Destroy()
	end

	return WindowObj
end

-- ─── GetTheme ─────────────────────────────────────────────────────────────
function NexusUI:GetTheme(name)
	return Themes[name]
end

function NexusUI:AddTheme(name, themeTable)
	Themes[name] = themeTable
end

return NexusUI
