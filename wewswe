		end
		closed = true
		local tween = Tween(notification, 0.18, { GroupTransparency = 1 })
		tween.Completed:Once(function()
			notification:Destroy()
		end)
	end

	task.delay(duration, close)

	local clickArea = Create("TextButton", {
		Name = "Dismiss",
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		Parent = notification,
	})
	clickArea.MouseButton1Click:Connect(close)

	return {
		Frame = notification,
		Close = close,
	}
end

--=====================================================================
return Library
