		ClipsDescendants = true,
		Parent = container,
	})
	Corner(svArea, 6)

	local saturationOverlay = Create("Frame", {
		Name = "Saturation",
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = svArea,
	})
	Corner(saturationOverlay, 6)
	Create("UIGradient", {
		Rotation = 0,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 1, 1)),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = saturationOverlay,
	})

	local valueOverlay = Create("Frame", {
		Name = "Value",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = svArea,
	})
	Corner(valueOverlay, 6)
	Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.new(0, 0, 0)),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = valueOverlay,
	})

	local svCursor = Create("Frame", {
		Name = "Cursor",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(14, 14),
		ZIndex = 3,
		Parent = svArea,
	})
	Create("UIStroke", {
		Color = Color3.new(1, 1, 1),
		Thickness = 2,
		Parent = svCursor,
	})
	Corner(svCursor, 7)
	Create("UIStroke", {
		Color = Color3.new(0, 0, 0),
		Thickness = 1,
		Transparency = 0.6,
		Parent = svCursor,
	})

	local hueBar = Create("Frame", {
		Name = "Hue",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(10, SV_HEIGHT + 20),
		Size = UDim2.new(1, -20, 0, HUE_HEIGHT),
		Parent = container,
	})
	Corner(hueBar, HUE_HEIGHT / 2)
	Create("UIGradient", {
		Rotation = 0,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hueBar,
	})

	local hueCursor = Create("Frame", {
		Name = "Cursor",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(0, 4, 1, 8),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = hueBar,
	})
	Corner(hueCursor, 2)

	local previewRow = Create("Frame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, SV_HEIGHT + HUE_HEIGHT + 30),
		Size = UDim2.new(1, -20, 0, 24),
		Parent = container,
	})

	local preview = Create("Frame", {
		Name = "Swatch",
		BackgroundColor3 = defaultColor,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(40, 24),
		Parent = previewRow,
	})
	Corner(preview, 5)
	Stroke(preview, theme.Outline, 1, 0.5)

	local hexLabel = Create("TextBox", {
		Name = "Hex",
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(48, 0),
		Size = UDim2.new(1, -48, 1, 0),
		Font = Enum.Font.Code,
		Text = "",
		TextColor3 = theme.Text,
		TextSize = 12,
		ClearTextOnFocus = false,
		Parent = previewRow,
	})
	Corner(hexLabel, 5)

	-- State -----------------------------------------------------------
	local element = {
		Type = "ColorPicker",
		Row = row,
		Label = nameLabel,
		Button = swatchButton,
		Popup = popup,
		Callback = config.Callback,
		Flag = config.Flag,
		Window = window,
		Enabled = true,
		H = h,
		S = s,
		V = v,
	}

	local suppressHex = false

	local function currentColor()
		return Color3.fromHSV(element.H, element.S, element.V)
	end

	local function refreshVisuals(fire)
		local color = currentColor()

		saturationOverlay.BackgroundColor3 = Color3.fromHSV(element.H, 1, 1)
		svCursor.Position = UDim2.fromScale(element.S, 1 - element.V)
		hueCursor.Position = UDim2.fromScale(element.H, 0.5)

		swatchButton.BackgroundColor3 = color
		preview.BackgroundColor3 = color

		suppressHex = true
		hexLabel.Text = string.format(
			"#%02X%02X%02X",
			math.floor(color.R * 255 + 0.5),
			math.floor(color.G * 255 + 0.5),
			math.floor(color.B * 255 + 0.5)
		)
		suppressHex = false

		if fire then
			if window.Library.Flags and element.Flag then
				window.Library.Flags[element.Flag] = color
			end
			RunCallback(element.Callback, color)
		end
	end

	refreshVisuals(false)

	-- Dragging --------------------------------------------------------
	local function updateFromSV(position)
		local pos, size = svArea.AbsolutePosition, svArea.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then
			return
		end
		element.S = math.clamp((position.X - pos.X) / size.X, 0, 1)
		element.V = 1 - math.clamp((position.Y - pos.Y) / size.Y, 0, 1)
		refreshVisuals(true)
	end

	local function updateFromHue(position)
		local pos, size = hueBar.AbsolutePosition, hueBar.AbsoluteSize
		if size.X <= 0 then
			return
		end
		element.H = math.clamp((position.X - pos.X) / size.X, 0, 1)
		refreshVisuals(true)
	end

	table.insert(window._connections, svArea.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			updateFromSV(input.Position)
			BeginDrag({
				Move = function(position)
					updateFromSV(position)
				end,
			})
		end
	end))

	table.insert(window._connections, hueBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			updateFromHue(input.Position)
			BeginDrag({
				Move = function(position)
					updateFromHue(position)
				end,
			})
		end
	end))

	-- Hex input -------------------------------------------------------
	table.insert(window._connections, hexLabel.FocusLost:Connect(function()
		if suppressHex then
			return
		end
		local text = hexLabel.Text:gsub("#", "")
		local r = tonumber(text:sub(1, 2), 16)
		local g = tonumber(text:sub(3, 4), 16)
		local b = tonumber(text:sub(5, 6), 16)
		if r and g and b then
			local color = Color3.fromRGB(r, g, b)
			element.H, element.S, element.V = Color3.toHSV(color)
			refreshVisuals(true)
		else
			refreshVisuals(false)
		end
	end))

	-- Public API ------------------------------------------------------
	function element:GetValue()
		return currentColor()
	end

	function element:SetValue(color, fire)
		if typeof(color) ~= "Color3" then
			return
		end
		self.H, self.S, self.V = Color3.toHSV(color)
		refreshVisuals(fire ~= false)
	end

	function element:SetName(name)
		nameLabel.Text = name
		row.Name = name
	end

	function element:SetEnabled(enabled)
		self.Enabled = enabled == true
		swatchButton.Active = self.Enabled
		nameLabel.TextTransparency = self.Enabled and 0 or 0.4
		swatchButton.BackgroundTransparency = self.Enabled and 0 or 0.5
		if not self.Enabled then
			popup:Hide()
		end
	end

	function element:SetVisible(visible)
		row.Visible = visible == true
		if not row.Visible then
			popup:Hide()
		end
	end

	function element:Destroy()
		popup:Destroy()
		row:Destroy()
	end

	-- Interaction -----------------------------------------------------
	table.insert(window._connections, swatchButton.MouseButton1Click:Connect(function()
		if not element.Enabled then
			return
		end
		if popup.Open then
			popup:Hide()
		else
			window:ClosePopups(popup)
			popup:Show()
		end
	end))

	window:_RegisterThemeFunction(function(theme)
		nameLabel.TextColor3 = theme.Text
		hexLabel.BackgroundColor3 = theme.Element
		hexLabel.TextColor3 = theme.Text
		previewRow.Parent.Parent = previewRow.Parent.Parent
	end)

	if element.Flag and window.Library.Flags then
		window.Library.Flags[element.Flag] = currentColor()
	end

	return element
end

