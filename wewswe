            -- ─── SLIDER ───
            function Section:CreateSlider(opt)
                opt = opt or {}
                local name     = opt.Name      or "Slider"
                local min      = opt.Min       or 0
                local max      = opt.Max       or 100
                local default  = opt.Default   or min
                local inc      = opt.Increment or 1
                local suffix   = opt.Suffix    or ""
                local flag     = opt.Flag
                local callback = opt.Callback  or function() end

                local row = Create("Frame", {
                    Parent           = SecContent,
                    BackgroundTransparency = 1,
                    Size             = UDim2.new(1,0,0,46),
                    ZIndex           = 15,
                })
                local lbl = Create("TextLabel", {
                    Parent              = row,
                    BackgroundTransparency = 1,
                    Position            = UDim2.new(0,4,0,0),
                    Size                = UDim2.new(0.6,0,0,18),
                    Font                = Enum.Font.Gotham,
                    Text                = name,
                    TextColor3          = Theme.Text,
                    TextSize            = 13,
                    TextXAlignment      = Enum.TextXAlignment.Left,
                    ZIndex              = 16,
                })
                local valLbl = Create("TextLabel", {
                    Parent              = row,
                    BackgroundTransparency = 1,
                    Position            = UDim2.new(0.6,0,0,0),
                    Size                = UDim2.new(0.4,-4,0,18),
                    Font                = Enum.Font.GothamMedium,
                    Text                = tostring(default) .. suffix,
                    TextColor3          = Theme.Accent,
                    TextSize            = 12,
                    TextXAlignment      = Enum.TextXAlignment.Right,
                    ZIndex              = 16,
                })
                local track = Create("Frame", {
                    Parent           = row,
                    BackgroundColor3 = Theme.Surface2,
                    BorderSizePixel  = 0,
                    Position         = UDim2.new(0,4,0,28),
                    Size             = UDim2.new(1,-8,0,6),
                    ZIndex           = 16,
                })
                Create("UICorner", { Parent = track, CornerRadius = UDim.new(1,0) })
                local fill = Create("Frame", {
                    Parent           = track,
                    BackgroundColor3 = Theme.Accent,
                    BorderSizePixel  = 0,
                    Size             = UDim2.new(0,0,1,0),
                    ZIndex           = 17,
                })
                Create("UICorner", { Parent = fill, CornerRadius = UDim.new(1,0) })
                -- Gradient on fill
                local fillGrad = MakeGradientFrame(fill, Theme.AccentHover, Theme.AccentDark, 16)
                Create("UICorner", { Parent = fillGrad, CornerRadius = UDim.new(1,0) })

                local knob = Create("Frame", {
                    Parent           = track,
                    BackgroundColor3 = Color3.new(1,1,1),
                    BorderSizePixel  = 0,
                    Size             = UDim2.new(0,14,0,14),
                    Position         = UDim2.new(0,-7,0.5,-7),
                    ZIndex           = 18,
                })
                Create("UICorner", { Parent = knob, CornerRadius = UDim.new(1,0) })
                Create("UIStroke", { Parent = knob, Color = Theme.Accent, Thickness = 2 })

                local value = default
                local function SetVal(val, fire)
                    val   = math.clamp(Round(val, inc), min, max)
                    value = val
                    local pct = (max == min) and 0 or (val - min) / (max - min)
                    fill.Size     = UDim2.new(pct,0,1,0)
                    knob.Position = UDim2.new(pct,-7,0.5,-7)
                    valLbl.Text   = tostring(val) .. suffix
                    if flag then Library.Flags[flag] = val end
                    if fire ~= false then task.spawn(callback, val) end
                end
                SetVal(default, false)

                local dragging = false
                local function fromX(x)
                    local rel = (x - track.AbsolutePosition.X) / track.AbsoluteSize.X
                    SetVal(min + (max - min) * math.clamp(rel, 0, 1))
                end
                track.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true; fromX(i.Position.X)
                    end
                end)
                knob.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then fromX(i.Position.X) end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)

                RegEl({
                    ApplyTheme = function(_, th)
                        lbl.TextColor3   = th.Text
                        valLbl.TextColor3 = th.Accent
                        track.BackgroundColor3 = th.Surface2
                        fill.BackgroundColor3  = th.Accent
                        local st = knob:FindFirstChildOfClass("UIStroke")
                        if st then st.Color = th.Accent end
                    end,
                })
                return { Set = function(_, v) SetVal(v) end, Get = function() return value end }
            end

