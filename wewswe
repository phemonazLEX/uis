			-- ─── AddSlider ────────────────────────────────────────────────────
			function SectionObj:AddSlider(opts)
				opts = opts or {}
				local name     = opts.Name     or "Slider"
				local min      = opts.Min      or 0
				local max      = opts.Max      or 100
				local default  = opts.Default  or min
				local suffix   = opts.Suffix   or ""
				local callback = opts.Callback or function() end

				default = math.clamp(default, min, max)

				local row = Instance.new("Frame")
				row.Name             = "Row_" .. name
				row.BackgroundColor3 = th.ElementBg
				row.Size             = UDim2.new(1, 0, 0, 52)
				row.ZIndex           = 5
				row.LayoutOrder      = tick()
				row.Parent           = ElementContainer
				Round(row, 6)
				Padding(row, 6, 10, 6, 10)

				local topRow = Instance.new("Frame")
				MakeClear(topRow)
				topRow.Size     = UDim2.new(1, 0, 0, 18)
				topRow.Position = UDim2.new(0, 0, 0, 0)
				topRow.ZIndex   = 6
				topRow.Parent   = row

				local sliderLabel = Instance.new("TextLabel")
				MakeClear(sliderLabel)
				sliderLabel.Text          = name
				sliderLabel.TextColor3    = th.Text
				sliderLabel.Font          = Enum.Font.GothamSemibold
				sliderLabel.TextSize      = 12
				sliderLabel.TextXAlignment = Enum.TextXAlignment.Left
				sliderLabel.Size          = UDim2.new(0.7, 0, 1, 0)
				sliderLabel.ZIndex        = 6
				sliderLabel.Parent        = topRow

				local valueLabel = Instance.new("TextLabel")
				MakeClear(valueLabel)
				valueLabel.Text          = tostring(default) .. suffix
				valueLabel.TextColor3    = th.Accent
				valueLabel.Font          = Enum.Font.GothamBold
				valueLabel.TextSize      = 12
				valueLabel.TextXAlignment = Enum.TextXAlignment.Right
				valueLabel.Size          = UDim2.new(0.3, 0, 1, 0)
				valueLabel.Position      = UDim2.new(0.7, 0, 0, 0)
				valueLabel.ZIndex        = 6
				valueLabel.Parent        = topRow

				local trackBg = Instance.new("Frame")
				trackBg.BackgroundColor3 = th.Border
				trackBg.Size             = UDim2.new(1, 0, 0, 6)
				trackBg.Position         = UDim2.new(0, 0, 1, -6)
				trackBg.ZIndex           = 6
				trackBg.Parent           = row
				Round(trackBg, 3)

				local fill = Instance.new("Frame")
				fill.BackgroundColor3 = th.Accent
				fill.Size             = UDim2.new((default - min) / (max - min), 0, 1, 0)
				fill.ZIndex           = 7
				fill.Parent           = trackBg
				Round(fill, 3)

				local knob = Instance.new("Frame")
				knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				knob.Size             = UDim2.new(0, 14, 0, 14)
				knob.Position         = UDim2.new((default - min) / (max - min), -7, 0.5, -7)
				knob.ZIndex           = 8
				knob.Parent           = trackBg
				Round(knob, 7)
				Stroke(knob, th.Accent, 2)

				local value     = default
				local sliding   = false

				local function SetSlider(inputPos)
					local absPos  = trackBg.AbsolutePosition.X
					local absSize = trackBg.AbsoluteSize.X
					local t = math.clamp((inputPos - absPos) / absSize, 0, 1)
					local rounded = math.floor(min + t * (max - min) + 0.5)
					if rounded ~= value then
						value = rounded
						fill.Size     = UDim2.new(t, 0, 1, 0)
						knob.Position = UDim2.new(t, -7, 0.5, -7)
						valueLabel.Text = tostring(value) .. suffix
						task.spawn(callback, value)
					end
				end

				trackBg.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						sliding = true
						SetSlider(input.Position.X)
					end
				end)

				local mouseMoveConn
				trackBg.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						sliding = true
						if mouseMoveConn then mouseMoveConn:Disconnect() end
						mouseMoveConn = UserInputService.InputChanged:Connect(function(inp)
							if sliding and inp.UserInputType == Enum.UserInputType.MouseMovement then
								SetSlider(inp.Position.X)
							end
						end)
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						sliding = false
						if mouseMoveConn then
							mouseMoveConn:Disconnect()
							mouseMoveConn = nil
						end
					end
				end)

				row.MouseEnter:Connect(function()
					Tween(row, { BackgroundColor3 = th.ElementBgHover }, 0.1)
				end)
				row.MouseLeave:Connect(function()
					Tween(row, { BackgroundColor3 = th.ElementBg }, 0.1)
				end)

				local SliderObj = {
					_row   = row,
					_label = sliderLabel,
					_value = value,
					_fill  = fill,
					_knob  = knob,
				}

				function SliderObj:SetValue(v)
					v = math.clamp(v, min, max)
					value = v
					self._value = v
					local t = (v - min) / (max - min)
					fill.Size     = UDim2.new(t, 0, 1, 0)
					knob.Position = UDim2.new(t, -7, 0.5, -7)
					valueLabel.Text = tostring(v) .. suffix
				end
				function SliderObj:GetValue()
					return self._value
				end
				function SliderObj:SetName(n)
					sliderLabel.Text = n
				end
				function SliderObj:SetVisible(v)
					row.Visible = v
				end
				function SliderObj:Destroy()
					row:Destroy()
				end

				return SliderObj
			end

