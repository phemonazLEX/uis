function Section:AddSlider(config)
	config = config or {}
	local window = self.Window
	local theme = window.Theme

	local min = tonumber(config.Min) or 0
	local max = tonumber(config.Max) or 100
	local step = tonumber(config.Step) or 1
	if step <= 0 then
		step = 1
	end
	if max <= min then
		max = min + 1
	end

	local row = self:_NewRow(40, false, config.Tooltip)

	local nameLabel = Create("TextLabel", {
		Name = "Name",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -60, 0, 16),
		Font = Enum.Font.Gotham,
		Text = config.Name or "Slider",
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	local valueLabel = Create("TextLabel", {
		Name = "Value",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(56, 16),
		Font = Enum.Font.GothamMedium,
		Text = "0",
		TextColor3 = theme.SubText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	local track = Create("Frame", {
		Name = "Track",
		BackgroundColor3 = theme.SliderTrack,
			BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 8),
		Parent = row,
	})
	Corner(track, 4)

	local fill = Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	})
	Corner(fill, 4)

	local knob = Create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = track,
	})
	Corner(knob, 7)
	Stroke(knob, theme.Outline, 1, 0.4)

	local hitbox = Create("TextButton", {
		Name = "Hitbox",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Position = UDim2.fromOffset(0, 16),
		Size = UDim2.new(1, 0, 0, 24),
		Parent = row,
	})

	local element = {
		Type = "Slider",
		Row = row,
		Label = nameLabel,
		Window = window,
		Callback = config.Callback,
		Flag = config.Flag,
		Min = min,
		Max = max,
		Step = step,
		Value = math.clamp(tonumber(config.Default) or min, min, max),
		Enabled = true,
		Suffix = config.Suffix or "",
	}

	local function formatValue(value)
		if step >= 1 then
			return string.format("%d%s", value, element.Suffix)
		end
		return string.format("%.2f%s", value, element.Suffix)
	end

	local function refresh()
		local alpha = (element.Value - min) / (max - min)
		alpha = math.clamp(alpha, 0, 1)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		valueLabel.Text = formatValue(element.Value)
	end

	local function setFromPosition(x)
		local pos, size = hitbox.AbsolutePosition, hitbox.AbsoluteSize
		if size.X <= 0 then
			return
		end
		local alpha = math.clamp((x - pos.X) / size.X, 0, 1)
		local value = min + (max - min) * alpha
		value = math.clamp(RoundToStep(value, step), min, max)
		element:SetValue(value)
	end

	refresh()

	function element:SetValue(value, fire)
		value = math.clamp(RoundToStep(tonumber(value) or min, self.Step), min, max)
		if self.Value == value then
			return
		end
		self.Value = value
		refresh()
		if window.Library.Flags and self.Flag then
			window.Library.Flags[self.Flag] = value
		end
		if fire ~= false then
			RunCallback(self.Callback, value)
		end
	end

	function element:GetValue()
		return self.Value
	end

	function element:SetName(name)
		nameLabel.Text = name
		row.Name = name
	end

	function element:SetEnabled(enabled)
		self.Enabled = enabled == true
		hitbox.Active = self.Enabled
		nameLabel.TextTransparency = self.Enabled and 0 or 0.4
		track.BackgroundTransparency = self.Enabled and 0 or 0.5
	end

	function element:SetVisible(visible)
		row.Visible = visible == true
	end

	function element:Destroy()
		row:Destroy()
	end

	table.insert(window._connections, hitbox.InputBegan:Connect(function(input)
		if not element.Enabled then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			setFromPosition(input.Position.X)
			BeginDrag({
				Move = function(position)
					setFromPosition(position.X)
				end,
			})
		end
	end))

	window:_RegisterThemeFunction(function(theme)
		nameLabel.TextColor3 = theme.Text
		track.BackgroundColor3 = theme.SliderTrack
		fill.BackgroundColor3 = theme.Accent
		valueLabel.TextColor3 = theme.SubText
	end)

	if element.Flag and window.Library.Flags then
		window.Library.Flags[element.Flag] = element.Value
	end

	return element
end

