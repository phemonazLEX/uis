        MainFrame.BackgroundColor3 = newTheme.Background
        Header.BackgroundColor3 = newTheme.Header
        HeaderCover.BackgroundColor3 = newTheme.Header
        TitleLabel.TextColor3 = newTheme.Text
        SubtitleLabel.TextColor3 = newTheme.TextSecondary
    end

