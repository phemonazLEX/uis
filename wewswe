        })
        Create("UIPadding", {
            Parent      = Page,
            PaddingTop  = UDim.new(0,14),
            PaddingBottom = UDim.new(0,14),
            PaddingLeft = UDim.new(0,14),
            PaddingRight = UDim.new(0,14),
        })

        local Tab = { Button = TabBtn, Page = Page, Name = tName }

        local function Select()
            CloseAllOverlays()
            for _, t in pairs(Window.Tabs) do
                t.Page.Visible = false
                Tween(t.Button, { BackgroundColor3 = Theme.Surface2, TextColor3 = Theme.TextDim }, 0.12)
            end
            Page.Visible = true
            Tween(TabBtn, { BackgroundColor3 = Theme.Accent, TextColor3 = Color3.new(1,1,1) }, 0.12)
            Window.CurrentTab = Tab
        end

        TabBtn.MouseButton1Click:Connect(Select)
        TabBtn.MouseEnter:Connect(function()
            if Window.CurrentTab ~= Tab then
                Tween(TabBtn, { BackgroundColor3 = Theme.Surface3, TextColor3 = Theme.Text }, 0.1)
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if Window.CurrentTab ~= Tab then
                Tween(TabBtn, { BackgroundColor3 = Theme.Surface2, TextColor3 = Theme.TextDim }, 0.1)
            end
        end)

        if #Window.Tabs == 0 then task.defer(Select) end
        table.insert(Window.Tabs, Tab)

        RegEl({
            ApplyTheme = function(_, th)
                Page.ScrollBarImageColor3 = th.Accent
                if Window.CurrentTab == Tab then
                    TabBtn.BackgroundColor3 = th.Accent
                    TabBtn.TextColor3 = Color3.new(1,1,1)
                else
                    TabBtn.BackgroundColor3 = th.Surface2
                    TabBtn.TextColor3 = th.TextDim
                end
            end,
        })

