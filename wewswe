            -- ─── KEYBIND ───
            function Section:CreateKeybind(opt)
                opt = opt or {}
                local name      = opt.Name     or "Keybind"
                local default   = opt.Default  or Enum.KeyCode.E
                local flag      = opt.Flag
                local callback  = opt.Callback or function() end
                local uiToggle  = opt.UIToggle == true

                local row   = Row(32)
                local lbl   = Create("TextLabel", {
                    Parent = row, BackgroundTransparency = 1,
                    Position = UDim2.new(0,4,0,0), Size = UDim2.new(1,-100,1,0),
                    Font = Enum.Font.Gotham, Text = name, TextColor3 = Theme.Text,
                    TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 16,
                })
                local keyBtn = Create("TextButton", {
                    Parent = row, BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0,
                    Position = UDim2.new(1,-90,0.5,-12), Size = UDim2.new(0,86,0,24),
                    Font = Enum.Font.GothamMedium, Text = default.Name,
                    TextColor3 = Theme.Text, TextSize = 12,
                    AutoButtonColor = false, ZIndex = 16,
                })
                Create("UICorner", { Parent = keyBtn, CornerRadius = UDim.new(0,6) })

                local cur = default
                local listening = false
                local function SetKey(k)
                    cur = k; keyBtn.Text = k.Name
                    if flag then Library.Flags[flag] = k end
                    if uiToggle then Window:SetKeybind(k) end
                end
                SetKey(default)

                keyBtn.MouseButton1Click:Connect(function()
                    if listening then return end
                    listening = true
                    keyBtn.Text = "..."
                    Tween(keyBtn, { BackgroundColor3 = Theme.Accent }, 0.1)
                    local conn
                    conn = UserInputService.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            SetKey(input.KeyCode)
                            listening = false
                            Tween(keyBtn, { BackgroundColor3 = Theme.Surface2 }, 0.1)
                            conn:Disconnect()
                        end
                    end)
                end)

                if not uiToggle then
                    UserInputService.InputBegan:Connect(function(input, gpe)
                        if gpe or listening then return end
                        if input.KeyCode == cur then task.spawn(callback) end
                    end)
                end

                RegEl({
                    ApplyTheme = function(_, th)
                        lbl.TextColor3 = th.Text
                        if not listening then keyBtn.BackgroundColor3 = th.Surface2 end
                        keyBtn.TextColor3 = th.Text
                    end,
                })
                return { Set = function(_, k) SetKey(k) end, Get = function() return cur end }
            end

            -- ─────────────────────────────────────────────────────────────────────
            -- DROPDOWN  ── anchored to button, follows drag via RenderStepped
            -- Root bug fix: events used InputBegan (fires before MouseButton1Click)
            -- causing the global close handler to fire before selection registered.
            -- Now: close guard checks InsideOverlay before destroying.
            -- ─────────────────────────────────────────────────────────────────────
            function Section:CreateDropdown(opt)
                opt = opt or {}
                local name     = opt.Name    or "Dropdown"
                local options  = opt.Options or { "Option 1", "Option 2" }
                local default  = opt.Default or options[1]
                local flag     = opt.Flag
                local callback = opt.Callback or function() end

                local row   = Row(32)
                local lbl   = Create("TextLabel", {
                    Parent = row, BackgroundTransparency = 1,
                    Position = UDim2.new(0,4,0,0), Size = UDim2.new(0.38,0,1,0),
                    Font = Enum.Font.Gotham, Text = name, TextColor3 = Theme.Text,
                    TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 16,
                })
                local dropBtn = Create("TextButton", {
                    Parent = row, BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0,
                    Position = UDim2.new(0.40,0,0.5,-13), Size = UDim2.new(0.60,0,0,26),
                    Font = Enum.Font.Gotham, Text = "  " .. tostring(default),
                    TextColor3 = Theme.Text, TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false, ZIndex = 16,
                })
                Create("UICorner", { Parent = dropBtn, CornerRadius = UDim.new(0,6) })
                Create("UIStroke", { Parent = dropBtn, Color = Theme.Border, Thickness = 1, Transparency = 0.4 })
                local arrow = Create("TextLabel", {
                    Parent = dropBtn, BackgroundTransparency = 1,
                    Position = UDim2.new(1,-20,0,0), Size = UDim2.new(0,18,1,0),
                    Font = Enum.Font.GothamBold, Text = "▾",
                    TextColor3 = Theme.TextDim, TextSize = 11, ZIndex = 17,
                })

                local selected = default
                if flag then Library.Flags[flag] = selected end

                local function Open()
                    CloseAllOverlays()
                    arrow.Text = "▴"

                    local dropW = dropBtn.AbsoluteSize.X
                    local listH = math.min(#options * 28 + 8, 180)

                    local dropFrame = Create("Frame", {
                        Parent           = ScreenGui,
                        BackgroundColor3 = Theme.Surface,
                        BorderSizePixel  = 0,
                        Position         = UDim2.fromOffset(0, 0),  -- positioned by RenderStepped
                        Size             = UDim2.fromOffset(dropW, listH),
                        ZIndex           = 200,
                    })
                    Create("UICorner", { Parent = dropFrame, CornerRadius = UDim.new(0,8) })
                    Create("UIStroke", { Parent = dropFrame, Color = Theme.Border, Thickness = 1, Transparency = 0.2 })
                    -- Subtle gradient
                    local dfGrad = MakeGradientFrame(dropFrame, Theme.Surface, Theme.Surface2, 199)
                    Create("UICorner", { Parent = dfGrad, CornerRadius = UDim.new(0,8) })

                    local scroll = Create("ScrollingFrame", {
                        Parent = dropFrame, BackgroundTransparency = 1, BorderSizePixel = 0,
                        Size = UDim2.new(1,0,1,0), ScrollBarThickness = 3,
                        ScrollBarImageColor3 = Theme.Accent,
                        CanvasSize = UDim2.new(0,0,0,#options * 28),
                        ZIndex = 201,
                    })
                    Create("UIListLayout", { Parent = scroll, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,2) })
                    Create("UIPadding", {
                        Parent = scroll, PaddingTop = UDim.new(0,4), PaddingBottom = UDim.new(0,4),
                        PaddingLeft = UDim.new(0,4), PaddingRight = UDim.new(0,4),
                    })

                    for _, optName in ipairs(options) do
                        local ob = Create("TextButton", {
                            Parent = scroll,
                            BackgroundColor3 = (optName == selected) and Theme.Accent or Theme.Surface2,
                            BorderSizePixel = 0,
                            Size = UDim2.new(1,0,0,26),
                            Font = Enum.Font.Gotham, Text = "  " .. optName,
                            TextColor3 = Theme.Text, TextSize = 12,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            AutoButtonColor = false, ZIndex = 202,
                        })
                        Create("UICorner", { Parent = ob, CornerRadius = UDim.new(0,5) })
                        ob.MouseEnter:Connect(function()
                            if optName ~= selected then Tween(ob, { BackgroundColor3 = Theme.Surface3 }, 0.08) end
                        end)
                        ob.MouseLeave:Connect(function()
                            if optName ~= selected then Tween(ob, { BackgroundColor3 = Theme.Surface2 }, 0.08) end
                        end)
                        ob.MouseButton1Click:Connect(function()
                            selected = optName
                            dropBtn.Text = "  " .. selected
                            if flag then Library.Flags[flag] = selected end
                            task.spawn(callback, selected)
                            CloseAllOverlays()
                        end)
                    end

                    RegisterOverlay(dropFrame, dropBtn, 4, function() arrow.Text = "▾" end)
                end

                dropBtn.MouseButton1Click:Connect(function()
                    task.defer(Open)
                end)

                RegEl({
                    ApplyTheme = function(_, th)
                        lbl.TextColor3 = th.Text
                        dropBtn.BackgroundColor3 = th.Surface2
                        dropBtn.TextColor3 = th.Text
                        arrow.TextColor3 = th.TextDim
                    end,
                })
                return {
                    Set = function(_, v)
                        selected = v
                        dropBtn.Text = "  " .. tostring(v)
                        if flag then Library.Flags[flag] = v end
                    end,
                    Get = function() return selected end,
                    Refresh = function(_, newOpts) options = newOpts end,
                }
            end

            -- ─── MULTI DROPDOWN ───
            function Section:CreateMultiDropdown(opt)
                opt = opt or {}
                local name     = opt.Name    or "Multi Dropdown"
                local options  = opt.Options or { "A", "B", "C" }
                local default  = opt.Default or {}
                local flag     = opt.Flag
                local callback = opt.Callback or function() end

                local selected = {}
                for _, v in ipairs(default) do selected[v] = true end

                local row  = Row(32)
                local lbl  = Create("TextLabel", {
                    Parent = row, BackgroundTransparency = 1,
                    Position = UDim2.new(0,4,0,0), Size = UDim2.new(0.38,0,1,0),
                    Font = Enum.Font.Gotham, Text = name, TextColor3 = Theme.Text,
                    TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 16,
                })

                local function GetDisplay()
                    local list = {}
                    for k,v in pairs(selected) do if v then table.insert(list,k) end end
                    if #list == 0 then return "None" end
                    if #list <= 2 then return table.concat(list,", ") end
                    return list[1] .. " +" .. (#list-1)
                end

                local dropBtn = Create("TextButton", {
                    Parent = row, BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0,
                    Position = UDim2.new(0.40,0,0.5,-13), Size = UDim2.new(0.60,0,0,26),
                    Font = Enum.Font.Gotham, Text = "  " .. GetDisplay(),
                    TextColor3 = Theme.Text, TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false, ZIndex = 16,
                })
                Create("UICorner", { Parent = dropBtn, CornerRadius = UDim.new(0,6) })
                Create("UIStroke", { Parent = dropBtn, Color = Theme.Border, Thickness = 1, Transparency = 0.4 })
                local arrow = Create("TextLabel", {
                    Parent = dropBtn, BackgroundTransparency = 1,
                    Position = UDim2.new(1,-20,0,0), Size = UDim2.new(0,18,1,0),
                    Font = Enum.Font.GothamBold, Text = "▾",
                    TextColor3 = Theme.TextDim, TextSize = 11, ZIndex = 17,
                })

                local function Open()
                    CloseAllOverlays()
                    arrow.Text = "▴"
                    local dropW = dropBtn.AbsoluteSize.X
                    local listH = math.min(#options * 28 + 8, 180)

                    local dropFrame = Create("Frame", {
                        Parent = ScreenGui, BackgroundColor3 = Theme.Surface,
                        BorderSizePixel = 0, Position = UDim2.fromOffset(0,0),
                        Size = UDim2.fromOffset(dropW, listH), ZIndex = 200,
                    })
                    Create("UICorner", { Parent = dropFrame, CornerRadius = UDim.new(0,8) })
                    Create("UIStroke", { Parent = dropFrame, Color = Theme.Border, Thickness = 1, Transparency = 0.2 })

                    local scroll = Create("ScrollingFrame", {
                        Parent = dropFrame, BackgroundTransparency = 1, BorderSizePixel = 0,
                        Size = UDim2.new(1,0,1,0), ScrollBarThickness = 3,
                        ScrollBarImageColor3 = Theme.Accent,
                        CanvasSize = UDim2.new(0,0,0,#options*28), ZIndex = 201,
                    })
                    Create("UIListLayout", { Parent = scroll, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,2) })
                    Create("UIPadding", {
                        Parent = scroll, PaddingTop = UDim.new(0,4), PaddingBottom = UDim.new(0,4),
                        PaddingLeft = UDim.new(0,4), PaddingRight = UDim.new(0,4),
                    })

                    for _, optName in ipairs(options) do
                        local ob = Create("TextButton", {
                            Parent = scroll,
                            BackgroundColor3 = selected[optName] and Theme.Accent or Theme.Surface2,
                            BorderSizePixel = 0, Size = UDim2.new(1,0,0,26),
                            Font = Enum.Font.Gotham, Text = "  " .. optName,
                            TextColor3 = Theme.Text, TextSize = 12,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            AutoButtonColor = false, ZIndex = 202,
                        })
                        Create("UICorner", { Parent = ob, CornerRadius = UDim.new(0,5) })
                        ob.MouseButton1Click:Connect(function()
                            selected[optName] = not selected[optName]
                            ob.BackgroundColor3 = selected[optName] and Theme.Accent or Theme.Surface2
                            dropBtn.Text = "  " .. GetDisplay()
                            local arr = {}
                            for k,v in pairs(selected) do if v then table.insert(arr,k) end end
                            if flag then Library.Flags[flag] = arr end
                            task.spawn(callback, arr)
                            -- Don't close — multi stays open
                        end)
                    end

                    RegisterOverlay(dropFrame, dropBtn, 4, function() arrow.Text = "▾" end)
                end

                dropBtn.MouseButton1Click:Connect(function() task.defer(Open) end)

                RegEl({
                    ApplyTheme = function(_, th)
                        lbl.TextColor3 = th.Text
                        dropBtn.BackgroundColor3 = th.Surface2
                        dropBtn.TextColor3 = th.Text
                        arrow.TextColor3 = th.TextDim
                    end,
                })
                return {
                    Set = function(_, vals)
                        selected = {}
                        for _, v in ipairs(vals or {}) do selected[v] = true end
                        dropBtn.Text = "  " .. GetDisplay()
                    end,
                    Get = function()
                        local arr = {}
                        for k,v in pairs(selected) do if v then table.insert(arr,k) end end
                        return arr
                    end,
                }
            end

            -- ─────────────────────────────────────────────────────────────────────
            -- COLOR PICKER
            -- Root bug fix: svFrame and hueFrame used InputBegan which fired BEFORE
            -- the global close guard ran — so the picker destroyed itself instantly.
            -- Fix: dragging state is set BEFORE defer, and InsideOverlay() guards close.
            -- ─────────────────────────────────────────────────────────────────────
            function Section:CreateColorPicker(opt)
                opt = opt or {}
                local name     = opt.Name    or "Color"
                local default  = opt.Default or Color3.fromRGB(102,103,255)
                local flag     = opt.Flag
                local callback = opt.Callback or function() end

                local row = Row(32)
                local lbl = Create("TextLabel", {
                    Parent = row, BackgroundTransparency = 1,
                    Position = UDim2.new(0,4,0,0), Size = UDim2.new(1,-48,1,0),
                    Font = Enum.Font.Gotham, Text = name, TextColor3 = Theme.Text,
                    TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 16,
                })
                local preview = Create("TextButton", {
                    Parent = row, BackgroundColor3 = default, BorderSizePixel = 0,
                    Position = UDim2.new(1,-36,0.5,-12), Size = UDim2.new(0,32,0,24),
                    Text = "", AutoButtonColor = false, ZIndex = 16,
                })
                Create("UICorner", { Parent = preview, CornerRadius = UDim.new(0,6) })
                Create("UIStroke", { Parent = preview, Color = Theme.Border, Thickness = 1 })

                local curColor = default
                local h, s, v  = RGBtoHSV(default.R*255, default.G*255, default.B*255)
                if flag then Library.Flags[flag] = curColor end

                local function OpenPicker()
                    CloseAllOverlays()

                    local PICKER_W, PICKER_H = 230, 260

                    local picker = Create("Frame", {
                        Parent = ScreenGui, BackgroundColor3 = Theme.Surface,
                        BorderSizePixel = 0, Position = UDim2.fromOffset(0,0),
                        Size = UDim2.fromOffset(PICKER_W, PICKER_H), ZIndex = 200,
                    })
                    Create("UICorner", { Parent = picker, CornerRadius = UDim.new(0,10) })
                    Create("UIStroke", { Parent = picker, Color = Theme.Border, Thickness = 1, Transparency = 0.2 })
                    local pkGrad = MakeGradientFrame(picker, Theme.Surface, Theme.Surface2, 199)
                    Create("UICorner", { Parent = pkGrad, CornerRadius = UDim.new(0,10) })

                    -- SV square  (160 × 145)
                    local SV_W, SV_H = 160, 145
                    local svFrame = Create("Frame", {
                        Parent = picker, BackgroundColor3 = Color3.fromHSV(h,1,1),
                        BorderSizePixel = 0,
                        Position = UDim2.new(0,12,0,12), Size = UDim2.fromOffset(SV_W, SV_H),
                        ZIndex = 201,
                    })
                    Create("UICorner", { Parent = svFrame, CornerRadius = UDim.new(0,6) })

                    -- White→transparent horizontal (saturation axis)
                    local satImg = Create("ImageLabel", {
                        Parent = svFrame, BackgroundTransparency = 1,
                        Size = UDim2.new(1,0,1,0),
                        Image = "rbxassetid://4155801252",
                        ImageColor3 = Color3.new(1,1,1), ZIndex = 202,
                    })
                    Create("UICorner", { Parent = satImg, CornerRadius = UDim.new(0,6) })

                    -- Transparent→black vertical (value axis)
                    local valOverlay = Create("Frame", {
                        Parent = svFrame, BackgroundColor3 = Color3.new(0,0,0),
                        BorderSizePixel = 0, Size = UDim2.new(1,0,1,0), ZIndex = 203,
                    })
                    Create("UIGradient", {
                        Parent = valOverlay, Rotation = 90,
                        Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0,1),
                            NumberSequenceKeypoint.new(1,0),
                        }),
                    })
                    Create("UICorner", { Parent = valOverlay, CornerRadius = UDim.new(0,6) })

                    local svCursor = Create("Frame", {
                        Parent = svFrame, BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0,
                        Position = UDim2.new(s,-6, 1-v,-6), Size = UDim2.fromOffset(12,12),
                        ZIndex = 205,
                    })
                    Create("UICorner", { Parent = svCursor, CornerRadius = UDim.new(1,0) })
                    Create("UIStroke", { Parent = svCursor, Color = Color3.new(0,0,0), Thickness = 2 })

                    -- Hue bar  (28 × 145)
                    local HUE_X = 12 + SV_W + 8
                    local hueFrame = Create("Frame", {
                        Parent = picker, BorderSizePixel = 0,
                        Position = UDim2.new(0, HUE_X, 0, 12), Size = UDim2.fromOffset(28, SV_H),
                        ZIndex = 201,
                    })
                    Create("UICorner", { Parent = hueFrame, CornerRadius = UDim.new(0,6) })
                    Create("UIGradient", {
                        Parent = hueFrame, Rotation = 90,
                        Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255,0,0)),
                            ColorSequenceKeypoint.new(0.166, Color3.fromRGB(255,255,0)),
                            ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0,255,0)),
                            ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0,255,255)),
                            ColorSequenceKeypoint.new(0.666, Color3.fromRGB(0,0,255)),
                            ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255,0,255)),
                            ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255,0,0)),
                        }),
                    })
                    local hueCursor = Create("Frame", {
                        Parent = hueFrame, BackgroundColor3 = Color3.new(1,1,1),
                        BorderSizePixel = 0,
                        Position = UDim2.new(0,-3, h,-4), Size = UDim2.new(1,6,0,8),
                        ZIndex = 202,
                    })
                    Create("UICorner", { Parent = hueCursor, CornerRadius = UDim.new(0,3) })
                    Create("UIStroke", { Parent = hueCursor, Color = Color3.new(0,0,0), Thickness = 1 })

                    -- Preview swatch
                    local Y_BOTTOM = 12 + SV_H + 10
                    local previewSwatch = Create("Frame", {
                        Parent = picker, BackgroundColor3 = curColor,
                        BorderSizePixel = 0,
                        Position = UDim2.new(0,12,0, Y_BOTTOM), Size = UDim2.fromOffset(38, 28),
                        ZIndex = 201,
                    })
                    Create("UICorner", { Parent = previewSwatch, CornerRadius = UDim.new(0,6) })
                    Create("UIStroke", { Parent = previewSwatch, Color = Theme.Border, Thickness = 1 })

                    -- Hex input
                    local hexBox = Create("TextBox", {
                        Parent = picker, BackgroundColor3 = Theme.Surface2, BorderSizePixel = 0,
                        Position = UDim2.new(0,58,0, Y_BOTTOM), Size = UDim2.fromOffset(PICKER_W-70, 28),
                        Font = Enum.Font.GothamMedium, Text = ColorToHex(curColor),
                        TextColor3 = Theme.Text, TextSize = 12,
                        TextXAlignment = Enum.TextXAlignment.Center,
                        ClearTextOnFocus = false, ZIndex = 201,
                    })
                    Create("UICorner", { Parent = hexBox, CornerRadius = UDim.new(0,6) })

                    -- Done button
                    local doneBtn = Create("TextButton", {
                        Parent = picker, BackgroundColor3 = Theme.Accent,
                        BorderSizePixel = 0,
                        Position = UDim2.new(0,12,0, Y_BOTTOM + 38), Size = UDim2.fromOffset(PICKER_W-24, 28),
                        Font = Enum.Font.GothamMedium, Text = "Done",
                        TextColor3 = Color3.new(1,1,1), TextSize = 13,
                        AutoButtonColor = false, ZIndex = 201,
                    })
                    Create("UICorner", { Parent = doneBtn, CornerRadius = UDim.new(0,6) })
                    doneBtn.MouseEnter:Connect(function() Tween(doneBtn, { BackgroundColor3 = Theme.AccentHover }, 0.1) end)
                    doneBtn.MouseLeave:Connect(function() Tween(doneBtn, { BackgroundColor3 = Theme.Accent }, 0.1) end)
                    doneBtn.MouseButton1Click:Connect(function() CloseAllOverlays() end)

                    local function ApplyColor()
                        curColor = HSVtoRGB(h, s, v)
                        preview.BackgroundColor3       = curColor
                        previewSwatch.BackgroundColor3 = curColor
                        svFrame.BackgroundColor3       = Color3.fromHSV(h, 1, 1)
                        svCursor.Position              = UDim2.new(s,-6, 1-v,-6)
                        hueCursor.Position             = UDim2.new(0,-3, h,-4)
                        hexBox.Text                    = ColorToHex(curColor)
                        if flag then Library.Flags[flag] = curColor end
                        task.spawn(callback, curColor)
                    end
                    ApplyColor()

                    -- SV drag — tracked globally; InsideOverlay guard keeps picker alive
                    local svDrag, hueDrag = false, false

                    svFrame.InputBegan:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 then
                            svDrag = true
                            local rx = math.clamp((i.Position.X - svFrame.AbsolutePosition.X) / svFrame.AbsoluteSize.X, 0, 1)
                            local ry = math.clamp((i.Position.Y - svFrame.AbsolutePosition.Y) / svFrame.AbsoluteSize.Y, 0, 1)
                            s = rx; v = 1 - ry
                            ApplyColor()
                        end
                    end)
                    hueFrame.InputBegan:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 then
                            hueDrag = true
                            h = math.clamp((i.Position.Y - hueFrame.AbsolutePosition.Y) / hueFrame.AbsoluteSize.Y, 0, 1)
                            ApplyColor()
                        end
                    end)
                    UserInputService.InputChanged:Connect(function(i)
                        if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                        if svDrag then
                            local rx = math.clamp((i.Position.X - svFrame.AbsolutePosition.X) / svFrame.AbsoluteSize.X, 0, 1)
                            local ry = math.clamp((i.Position.Y - svFrame.AbsolutePosition.Y) / svFrame.AbsoluteSize.Y, 0, 1)
                            s = rx; v = 1 - ry; ApplyColor()
                        elseif hueDrag then
                            h = math.clamp((i.Position.Y - hueFrame.AbsolutePosition.Y) / hueFrame.AbsoluteSize.Y, 0, 1)
                            ApplyColor()
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 then
                            svDrag = false; hueDrag = false
                        end
                    end)

                    hexBox.FocusLost:Connect(function()
                        local c = HexToColor(hexBox.Text)
                        if c then
                            h, s, v = RGBtoHSV(c.R*255, c.G*255, c.B*255)
                            ApplyColor()
                        else
                            hexBox.Text = ColorToHex(curColor)
                        end
                    end)

                    -- Position picker below the preview button, follows drag
                    RegisterOverlay(picker, preview, 6, nil)
                end

                preview.MouseButton1Click:Connect(function() task.defer(OpenPicker) end)

                RegEl({
                    ApplyTheme = function(_, th)
                        lbl.TextColor3 = th.Text
                        local st = preview:FindFirstChildOfClass("UIStroke")
                        if st then st.Color = th.Border end
                    end,
                })
                return {
                    Set = function(_, c)
                        curColor = c
                        h, s, v = RGBtoHSV(c.R*255, c.G*255, c.B*255)
                        preview.BackgroundColor3 = c
                        if flag then Library.Flags[flag] = c end
                    end,
                    Get = function() return curColor end,
                }
            end

            return Section
        end -- CreateSection

        return Tab
    end -- CreateTab

    -- ─────────────────────────────────────────────────────────────────────────
    -- NOTIFICATIONS  (stack from bottom-right, offset per active notif)
    -- ─────────────────────────────────────────────────────────────────────────
    function Window:Notify(opt)
        opt = opt or {}
        local title    = opt.Title    or "Notification"
        local content  = opt.Content  or ""
        local duration = opt.Duration or 3.5
        local nType    = opt.Type     or "Info"

        local accent = Theme.Accent
        if nType == "Success" then accent = Theme.Success
        elseif nType == "Warning" then accent = Theme.Warning
        elseif nType == "Error"   then accent = Theme.Danger end

        -- Clean dead refs
        for i = #Library._Notifs, 1, -1 do
            if not Library._Notifs[i].Parent then
                table.remove(Library._Notifs, i)
            end
        end

        local NOTIF_W, NOTIF_H, GAP = 290, 74, 10
        local stackOffset = (#Library._Notifs) * (NOTIF_H + GAP)

        local notif = Create("Frame", {
            Parent           = ScreenGui,
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel  = 0,
            Position         = UDim2.new(1, 20, 1, -(NOTIF_H + 20 + stackOffset)),
            Size             = UDim2.fromOffset(NOTIF_W, NOTIF_H),
            ZIndex           = 300,
        })
        Create("UICorner", { Parent = notif, CornerRadius = UDim.new(0,10) })
        Create("UIStroke", { Parent = notif, Color = Theme.Border, Thickness = 1, Transparency = 0.3 })

        local ng = MakeGradientFrame(notif, Theme.Surface, Theme.Surface2, 299)
        Create("UICorner", { Parent = ng, CornerRadius = UDim.new(0,10) })

        -- Accent left bar
        local bar = Create("Frame", {
            Parent = notif, BackgroundColor3 = accent, BorderSizePixel = 0,
            Size = UDim2.new(0,4,1,0), ZIndex = 301,
        })
        Create("UICorner", { Parent = bar, CornerRadius = UDim.new(0,10) })

        Create("TextLabel", {
            Parent = notif, BackgroundTransparency = 1,
            Position = UDim2.new(0,16,0,10), Size = UDim2.new(1,-28,0,18),
            Font = Enum.Font.GothamBold, Text = title,
            TextColor3 = Theme.Text, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 302,
        })
        Create("TextLabel", {
            Parent = notif, BackgroundTransparency = 1,
            Position = UDim2.new(0,16,0,30), Size = UDim2.new(1,-28,0,34),
            Font = Enum.Font.Gotham, Text = content,
            TextColor3 = Theme.TextDim, TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, ZIndex = 302,
        })

        -- Progress bar
        local prog = Create("Frame", {
            Parent = notif, BackgroundColor3 = accent, BorderSizePixel = 0,
            Position = UDim2.new(0,4,1,-4), Size = UDim2.new(1,-8,0,2),
            BackgroundTransparency = 0.4, ZIndex = 302,
        })
        Create("UICorner", { Parent = prog, CornerRadius = UDim.new(1,0) })

        table.insert(Library._Notifs, notif)

        -- Slide in
        Tween(notif, { Position = UDim2.new(1, -(NOTIF_W+16), 1, -(NOTIF_H+20+stackOffset)) }, 0.3, Enum.EasingStyle.Back)
        Tween(prog, { Size = UDim2.new(0,0,0,2) }, duration, Enum.EasingStyle.Linear)

        task.delay(duration, function()
            Tween(notif, { Position = UDim2.new(1, 20, 1, -(NOTIF_H+20+stackOffset)) }, 0.22)
            task.wait(0.25)
            notif:Destroy()
            for i = #Library._Notifs, 1, -1 do
                if Library._Notifs[i] == notif then table.remove(Library._Notifs, i) end
            end
        end)
    end

    table.insert(Library.Windows, Window)
    return Window
end

function Library:Destroy()
    CloseAllOverlays()
    for _, w in ipairs(Library.Windows) do
        if w.ScreenGui then w.ScreenGui:Destroy() end
    end
    Library.Windows = {}
end

return Library
