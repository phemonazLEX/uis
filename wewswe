local function safeCallback(callback, ...)
	if typeof(callback) ~= "function" then
		return
	end

	task.spawn(function(...)
		pcall(callback, ...)
	end, ...)
end

local function getAbsolutePosition(object)
	return object.AbsolutePosition
end

local function getAbsoluteSize(object)
	return object.AbsoluteSize
end

local function isInside(point, object)
	local position = getAbsolutePosition(object)
	local size = getAbsoluteSize(object)

	return point.X >= position.X
		and point.X <= position.X + size.X
		and point.Y >= position.Y
		and point.Y <= position.Y + size.Y
end

local function makeDraggable(handle, target)
	local dragging = false
	local dragStart
	local startPosition

	local began
	local changed

	began = handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		dragging = true
		dragStart = input.Position
		startPosition = target.Position

		local connection
		connection = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				connection:Disconnect()
			end
		end)
	end)

	changed = UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local delta = input.Position - dragStart

		target.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)

	return function()
		if began then
			began:Disconnect()
		end

		if changed then
			changed:Disconnect()
		end
	end
end

local function createJanitor()
	local janitor = {
		items = {}
	}

	function janitor:Add(item)
		table.insert(self.items, item)
		return item
	end

	function janitor:Cleanup()
		for _, item in self.items do
			local itemType = typeof(item)

			if itemType == "RBXScriptConnection" then
				if item.Connected then
					item:Disconnect()
				end
			elseif itemType == "Instance" then
				if item.Parent then
					item:Destroy()
				end
			elseif type(item) == "function" then
				pcall(item)
			elseif type(item) == "table" and item.Destroy then
				pcall(function()
					item:Destroy()
				end)
			end
		end

		table.clear(self.items)
	end

	return janitor
end

local function createElementObject(instance)
	local object = {
		Instance = instance,
		Destroyed = false,
		Janitor = createJanitor()
	}

	object.Janitor:Add(instance)

	function object:Destroy()
		if self.Destroyed then
			return
		end

		self.Destroyed = true
		self.Janitor:Cleanup()
	end

	function object:SetVisible(value)
		if self.Destroyed then
			return
		end

		self.Instance.Visible = value
	end

	function object:IsVisible()
		if self.Destroyed then
			return false
		end

		return self.Instance.Visible
	end

	return object
end

