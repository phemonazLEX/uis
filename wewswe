					Tween(row, { BackgroundColor3 = th.ElementBgHover }, 0.1)
				end)
				row.MouseLeave:Connect(function()
					Tween(row, { BackgroundColor3 = th.ElementBg }, 0.1)
				end)

				-- Popup (parented to ScreenGui — never detaches on drag)
				local popup    = nil
				local popupOpen = false
				local popupConn = nil

				local function ClosePopup()
					if not popupOpen then return end
					popupOpen = false
					Tween(ddArrow, { Rotation = 0 }, 0.15)
					if popup then
						Tween(popup, { Size = UDim2.new(popup.Size.X.Scale, popup.Size.X.Offset, 0, 0) }, 0.15)
						task.wait(0.16)
						if popup then popup:Destroy(); popup = nil end
					end
					if popupConn then popupConn:Disconnect(); popupConn = nil end
				end

				local function OpenPopup()
					if popupOpen then ClosePopup(); return end
					popupOpen = true
					Tween(ddArrow, { Rotation = 180 }, 0.15)

					local maxVisible  = 6
					local itemHeight  = 30
					local searchH     = searchable and 32 or 0
					local popupWidth  = ddBtn.AbsoluteSize.X
					local popupHeight = math.min(#options, maxVisible) * itemHeight + 8 + searchH

					local absPos = ddBtn.AbsolutePosition
					local absSize = ddBtn.AbsoluteSize

					popup = Instance.new("Frame")
					popup.Name             = "DDPopup"
					popup.BackgroundColor3 = th.PopupBg
					popup.Size             = UDim2.new(0, popupWidth, 0, 0)
					popup.Position         = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 4)
					popup.ClipsDescendants = true
					popup.ZIndex           = 50
					popup.Parent           = SectionObj._screenGui
					Round(popup, 6)
					Stroke(popup, th.PopupBorder, 1)

					local innerFrame = Instance.new("Frame")
					MakeClear(innerFrame)
					innerFrame.Size   = UDim2.new(1, 0, 1, 0)
					innerFrame.ZIndex = 51
					innerFrame.Parent = popup
					ListLayout(innerFrame, Enum.FillDirection.Vertical,
						Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top, 0)
					Padding(innerFrame, 4, 4, 4, 4)

					-- Search box
					local filteredOptions = {table.unpack(options)}
					local searchBox
					if searchable then
						local searchBg = Instance.new("Frame")
						searchBg.BackgroundColor3 = th.ElementBg
						searchBg.Size             = UDim2.new(1, 0, 0, searchH - 6)
						searchBg.ZIndex           = 52
						searchBg.LayoutOrder      = -1
						searchBg.Parent           = innerFrame
						Round(searchBg, 4)
						Padding(searchBg, 0, 4, 0, 4)

						searchBox = Instance.new("TextBox")
						MakeClear(searchBox)
						searchBox.PlaceholderText    = "Search..."
						searchBox.PlaceholderColor3  = th.TextDisabled
						searchBox.Text               = ""
						searchBox.TextColor3         = th.Text
						searchBox.Font               = Enum.Font.Gotham
						searchBox.TextSize           = 11
						searchBox.TextXAlignment     = Enum.TextXAlignment.Left
						searchBox.Size               = UDim2.new(1, 0, 1, 0)
						searchBox.ZIndex             = 53
						searchBox.ClearTextOnFocus   = false
						searchBox.Parent             = searchBg
					end

					local scroll = Instance.new("ScrollingFrame")
					scroll.BackgroundTransparency = 1
					scroll.Size                  = UDim2.new(1, 0, 0, math.min(#options, maxVisible) * itemHeight)
					scroll.CanvasSize            = UDim2.new(0, 0, 0, #options * itemHeight)
					scroll.ScrollBarThickness    = 3
					scroll.ScrollBarImageColor3  = th.ScrollBar
					scroll.ScrollingDirection    = Enum.ScrollingDirection.Y
					scroll.ZIndex                = 52
					scroll.Parent                = innerFrame
					ListLayout(scroll, Enum.FillDirection.Vertical,
						Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top, 0)

					local itemBtns = {}

					local function RebuildItems(filter)
						for _, b in ipairs(itemBtns) do b:Destroy() end
						itemBtns = {}

						local filtered = {}
						for _, opt in ipairs(options) do
							if filter == nil or filter == "" or string.lower(tostring(opt)):find(string.lower(filter), 1, true) then
								table.insert(filtered, opt)
							end
						end

						scroll.CanvasSize = UDim2.new(0, 0, 0, #filtered * itemHeight)
						scroll.Size = UDim2.new(1, 0, 0, math.min(#filtered, maxVisible) * itemHeight)

						for _, opt in ipairs(filtered) do
							local isSelected = multi and selected[opt] or (selected == opt)

							local item = Instance.new("TextButton")
							item.Text             = ""
							item.BackgroundColor3 = isSelected and th.ElementBgActive or Color3.fromRGB(0,0,0)
							item.BackgroundTransparency = isSelected and 0 or 1
							item.Size             = UDim2.new(1, 0, 0, itemHeight)
							item.ZIndex           = 53
							item.Parent           = scroll
							Round(item, 4)
							Padding(item, 0, 8, 0, 8)

							local optLabel = Instance.new("TextLabel")
							MakeClear(optLabel)
							optLabel.Text          = tostring(opt)
							optLabel.TextColor3    = isSelected and th.Text or th.TextDim
							optLabel.Font          = isSelected and Enum.Font.GothamSemibold or Enum.Font.Gotham
							optLabel.TextSize      = 12
							optLabel.TextXAlignment = Enum.TextXAlignment.Left
							optLabel.Size          = UDim2.new(1, multi and -24 or 0, 1, 0)
							optLabel.ZIndex        = 54
							optLabel.Parent        = item

							if multi then
								local checkmark = Instance.new("TextLabel")
								MakeClear(checkmark)
								checkmark.Text          = isSelected and "✓" or ""
								checkmark.TextColor3    = th.Accent
								checkmark.Font          = Enum.Font.GothamBold
								checkmark.TextSize      = 12
								checkmark.TextXAlignment = Enum.TextXAlignment.Right
								checkmark.Size          = UDim2.new(0, 20, 1, 0)
								checkmark.Position      = UDim2.new(1, -20, 0, 0)
								checkmark.ZIndex        = 54
								checkmark.Parent        = item

								item.MouseButton1Click:Connect(function()
									selected[opt] = not selected[opt] or nil
									ddValue.Text = GetDisplayText()
									-- rebuild to update check state
									RebuildItems(searchBox and searchBox.Text or nil)
									local vals = {}
									for k in pairs(selected) do table.insert(vals, k) end
									task.spawn(callback, vals)
								end)
							else
								item.MouseButton1Click:Connect(function()
									selected = opt
									ddValue.Text = opt
									ClosePopup()
									task.spawn(callback, opt)
								end)
							end

							item.MouseEnter:Connect(function()
								if not (not multi and selected == opt) then
									Tween(item, { BackgroundColor3 = th.ElementBgHover, BackgroundTransparency = 0 }, 0.08)
								end
							end)
							item.MouseLeave:Connect(function()
								local isSel = multi and selected[opt] or (selected == opt)
								Tween(item, {
									BackgroundColor3 = isSel and th.ElementBgActive or Color3.fromRGB(0,0,0),
									BackgroundTransparency = isSel and 0 or 1
								}, 0.08)
							end)

							table.insert(itemBtns, item)
						end
					end

					RebuildItems(nil)

					if searchable and searchBox then
						searchBox:GetPropertyChangedSignal("Text"):Connect(function()
							RebuildItems(searchBox.Text)
						end)
					end

					-- Update popup position every frame while open (follows window drag)
					popupConn = RunService.RenderStepped:Connect(function()
						if not popup or not popup.Parent then return end
						local currentAbsPos  = ddBtn.AbsolutePosition
						local currentAbsSize = ddBtn.AbsoluteSize
						popup.Position = UDim2.new(0, currentAbsPos.X, 0, currentAbsPos.Y + currentAbsSize.Y + 4)
					end)

					Tween(popup, { Size = UDim2.new(0, popupWidth, 0, popupHeight) }, 0.18)
				end

				ddBtn.MouseButton1Click:Connect(function()
					OpenPopup()
				end)

				-- Close on outside click
				UserInputService.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						if popupOpen and popup then
							local mousePos = UserInputService:GetMouseLocation()
							local popAbsPos  = popup.AbsolutePosition
							local popAbsSize = popup.AbsoluteSize
							local btnAbsPos  = ddBtn.AbsolutePosition
							local btnAbsSize = ddBtn.AbsoluteSize

							local inPopup = mousePos.X >= popAbsPos.X and mousePos.X <= popAbsPos.X + popAbsSize.X
								and mousePos.Y >= popAbsPos.Y and mousePos.Y <= popAbsPos.Y + popAbsSize.Y
							local inBtn   = mousePos.X >= btnAbsPos.X and mousePos.X <= btnAbsPos.X + btnAbsSize.X
								and mousePos.Y >= btnAbsPos.Y and mousePos.Y <= btnAbsPos.Y + btnAbsSize.Y

							if not inPopup and not inBtn then
								ClosePopup()
							end
						end
					end
				end)

				local DDObj = {
					_row      = row,
					_selected = selected,
					_multi    = multi,
				}

				function DDObj:SetOptions(newOptions)
					options = newOptions
					if not multi then
						if not table.find(options, selected) then
							selected = options[1] or ""
							ddValue.Text = GetDisplayText()
						end
					end
				end
				function DDObj:SetValue(v)
					if multi then
						selected = {}
						if type(v) == "table" then
							for _, val in ipairs(v) do selected[val] = true end
						end
					else
						selected = v
					end
					ddValue.Text = GetDisplayText()
				end
				function DDObj:GetValue()
					if multi then
						local vals = {}
						for k in pairs(selected) do table.insert(vals, k) end
						return vals
					end
					return selected
				end
				function DDObj:SetName(n)
					ddLabel.Text = n
				end
				function DDObj:SetVisible(v)
					row.Visible = v
					if not v then ClosePopup() end
				end
				function DDObj:Destroy()
					ClosePopup()
					row:Destroy()
				end

				return DDObj
			end

